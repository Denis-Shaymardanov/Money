
&НаСервере
Процедура money_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	ТипФайла = "PDF";
	Элементы.ПравилоЧтенияДокумента.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура money_ТипФайлаПриИзмененииПосле(Элемент)
	
	Если ТипФайла = "PDF" Тогда
		Элементы.ПравилоЧтенияДокумента.Доступность = Ложь;
	Иначе
		Элементы.ПравилоЧтенияДокумента.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ПолучитьДиалогВыбораФайла")
Функция money_ПолучитьДиалогВыбораФайла(РежимДиалога, ПутьКФайлу, ИмяФайла)

	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалога);

	ДиалогВыбораФайла.Фильтр       = СтрокаФильтраПоРасширениюФайла(ТекущееРасширение, ДиалогВыбораФайла.ИндексФильтра);

	Если Не ПустаяСтрока(ТекущееРасширение) Тогда
		ДиалогВыбораФайла.Расширение = ТекущееРасширение;
	КонецЕсли;
    #Вставка     
	Если ТипФайла = "PDF" Тогда
		ДиалогВыбораФайла.Расширение = "PDF";
		ДиалогВыбораФайла.Фильтр     = "PDF-файлы (*.pdf)|*.pdf";
	КонецЕсли;
	#КонецВставки
	ДиалогВыбораФайла.Заголовок                   = Заголовок;
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.ПолноеИмяФайла              = ИмяФайла;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = РежимДиалога = РежимДиалогаВыбораФайла.Открытие;

	Возврат ДиалогВыбораФайла;

КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("ПриОкончаниеПомещенияФайла")
Процедура money_ПриОкончаниеПомещенияФайла(Результат, АдресВременногоХранилища, ИмяФайла, Параметр)
    #Вставка
	Если ТипФайла = "PDF" Тогда
		Если Результат = Истина Тогда 
			Если ТекущееРасширение = "pdf" Тогда
				ФоновоеЗадание = Ложь;
				ЗагрузитьФайлСДаннымиВТабличныйДокументНаСервере(АдресВременногоХранилища, ТекущееРасширение, ФоновоеЗадание);
				Если ФоновоеЗадание Тогда

					ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
					ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
					ПараметрыОбработчика.МаксимальныйИнтервал = 5;
					ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ФоновоеЗаданиеИдентификатор);

				Иначе

					ТабличныйДокументВыпискиПриИзмененииКлиент();

				КонецЕсли;

			Иначе

				ПоказатьПредупреждение(,НСтр("ru ='Не получилось загрузить данные из выбранного файла. Убедитесь в корректности его содержимого.'"));

			КонецЕсли;

			ОбновитьКонечныеОбластиНастройкиЧтения(НастройкиЧтения, ТабличныйДокументВыписки);
			ВыделитьОбластиТабличногоДокумента(ЭтотОбъект);
		КонецЕсли;
		Возврат;	
	КонецЕсли;
	#КонецВставки
	Если Результат = Истина Тогда

		Если Найти(СтрокаФильтраПоРасширениюФайла("",0), "*." + ТекущееРасширение) > 0 Тогда

			ФоновоеЗадание = Ложь;
			ЗагрузитьФайлСДаннымиВТабличныйДокументНаСервере(АдресВременногоХранилища, ТекущееРасширение, ФоновоеЗадание);
			Если ФоновоеЗадание Тогда

				ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
				ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
				ПараметрыОбработчика.МаксимальныйИнтервал = 5;
				ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ФоновоеЗаданиеИдентификатор);

			Иначе

				ТабличныйДокументВыпискиПриИзмененииКлиент();

			КонецЕсли;

		Иначе

			ПоказатьПредупреждение(,НСтр("ru ='Не получилось загрузить данные из выбранного файла. Убедитесь в корректности его содержимого.'"));

		КонецЕсли;

		ОбновитьКонечныеОбластиНастройкиЧтения(НастройкиЧтения, ТабличныйДокументВыписки);
		ВыделитьОбластиТабличногоДокумента(ЭтотОбъект);

	КонецЕсли;

КонецПроцедуры

&НаСервере
&После("ЧтениеТабличногоДокументаОбработатьРезультат")
Процедура money_ЧтениеТабличногоДокументаОбработатьРезультат()

	Для каждого СтрокаОперации Из Объект.ТаблицаОпераций Цикл
		Если ЗначениеЗаполнено(СтрокаОперации.СсылкаНаОперацию)
			И Не money_СсылкаНаОперациюОднозначна(Объект.ТаблицаОпераций, СтрокаОперации) Тогда
			СтрокаОперации.СсылкаНаОперацию = Неопределено;
			СтрокаОперации.НоваяОперация = 1;
			СтрокаОперации.Загружать = Истина;
			СтрокаОперации.СсылкаНаОперациюИконка = БиблиотекаКартинок.БыстроСоздатьЭлементСписка;
			СтрокаОперации.СсылкаНаОперациюПредставление = СтрокаОперации.ВидОперацииПредставление;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаОперации.СтатьяДолг) Тогда
			СтрокаОперации.money_СтатьяЗаполнена = 1;
		Иначе
			СтрокаОперации.money_СтатьяЗаполнена = 0;
		КонецЕсли;
	КонецЦикла;

	ПриИзмененииФильтраТаблицыОпераций(Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция money_СсылкаНаОперациюОднозначна(ТаблицаОпераций, СтрокаОперации)

	Если Не ЗначениеЗаполнено(СтрокаОперации.Дата)
		Или Не ЗначениеЗаполнено(СтрокаОперации.Кошелек) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", СтрокаОперации.Дата);
	Запрос.УстановитьПараметр("Кошелек", СтрокаОперации.Кошелек);
	Запрос.УстановитьПараметр("СуммаПоступления", СтрокаОперации.СуммаПоступления);
	Запрос.УстановитьПараметр("СуммаСписания", СтрокаОперации.СуммаСписания);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|   ОбъектыОпераций.Операция
	|ИЗ
	|   РегистрСведений.ОбъектыОпераций КАК ОбъектыОпераций
	|ГДЕ
	|   ОбъектыОпераций.Дата МЕЖДУ НачалоПериода(&Дата, День) И КонецПериода(&Дата, День)
	|   И ОбъектыОпераций.ПредметУчета = &Кошелек
	|   И (&СуммаПоступления <> 0 И ОбъектыОпераций.СуммаПоступления = &СуммаПоступления
	|       ИЛИ &СуммаСписания <> 0 И ОбъектыОпераций.СуммаСписания = &СуммаСписания)";

	Выборка = Запрос.Выполнить().Выбрать();
	Кандидаты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Кандидаты.Добавить(Выборка.Операция);
	КонецЦикла;

	Если Кандидаты.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Кандидаты[0] <> СтрокаОперации.СсылкаНаОперацию Тогда
		Возврат Ложь;
	КонецЕсли;

	Для каждого ДругаяСтрока Из ТаблицаОпераций Цикл
		Если ДругаяСтрока.ПолучитьИдентификатор() <> СтрокаОперации.ПолучитьИдентификатор()
			И ЗначениеЗаполнено(ДругаяСтрока.СсылкаНаОперацию)
			И ДругаяСтрока.СсылкаНаОперацию = СтрокаОперации.СсылкаНаОперацию Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура money_ТаблицаОперацийСтатьяДолгПриИзмененииПосле(Элемент)
	
	ДанныеСтроки = Элементы.ТаблицаОпераций.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.СтатьяДолг) Тогда
		ДанныеСтроки.money_СтатьяЗаполнена = 1;	
	Иначе
		ДанныеСтроки.money_СтатьяЗаполнена = 0;	
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ПриИзмененииФильтраТаблицыОпераций")
Процедура money_ПриИзмененииФильтраТаблицыОпераций(ИзменятьОтбор)

	КоличествоВсего        = Объект.ТаблицаОпераций.Количество();
	КоличествоНовых        = Объект.ТаблицаОпераций.Итог("НоваяОперация");

	ЗаголовокВсеОперации = НСтр("ru='Все операции (%1)'");
	ЗаголовокВсеОперации = СтрШаблон(ЗаголовокВсеОперации, КоличествоВсего);
	ЗаголовокНовые = НСтр("ru='Новые (%1)'");
	ЗаголовокНовые = СтрШаблон(ЗаголовокНовые, КоличествоНовых);
	ЗаголовокЗагруженные = НСтр("ru='Загруженные (%1)'");
	ЗаголовокЗагруженные = СтрШаблон(ЗаголовокЗагруженные, КоличествоВсего - КоличествоНовых);

	Элементы.ФильтрТаблицыОпераций.СписокВыбора[0].Представление = ЗаголовокВсеОперации;
	Элементы.ФильтрТаблицыОпераций.СписокВыбора[1].Представление = ЗаголовокНовые;
	Элементы.ФильтрТаблицыОпераций.СписокВыбора[2].Представление = ЗаголовокЗагруженные;
	#Вставка                        
	КоличествоСоСтатьей    = Объект.ТаблицаОпераций.Итог("money_СтатьяЗаполнена");
	ЗаголовокБезСтатьи = НСтр("ru='Без статьи (%1)'");
	ЗаголовокБезСтатьи = СтрШаблон(ЗаголовокБезСтатьи, КоличествоВсего - КоличествоСоСтатьей);	
	Элементы.ФильтрТаблицыОпераций.СписокВыбора[3].Представление = ЗаголовокБезСтатьи;
	#КонецВставки

	Если ИзменятьОтбор Тогда

		Если ФильтрТаблицыОпераций = "Новые" Тогда
			Элементы.ТаблицаОпераций.ОтборСтрок = Новый ФиксированнаяСтруктура("НоваяОперация", 1);
		ИначеЕсли ФильтрТаблицыОпераций = "Загруженные" Тогда
			Элементы.ТаблицаОпераций.ОтборСтрок = Новый ФиксированнаяСтруктура("НоваяОперация", 0);
		#Вставка     
		ИначеЕсли ФильтрТаблицыОпераций = "НеЗаполненаСтатья" Тогда
			Элементы.ТаблицаОпераций.ОтборСтрок = Новый ФиксированнаяСтруктура("money_СтатьяЗаполнена", 0);
		#КонецВставки
		Иначе
			Элементы.ТаблицаОпераций.ОтборСтрок = Неопределено;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры
