Функция ПолучитьПараметрыПодключенияКСерверу() Экспорт
	
	ПараметрыПодключения = Новый Структура("Сервер, Порт"); 
	
	СерверФункцийPython = Константы.СерверФункцийPython.Получить();
	
	ПараметрыПодключения.Сервер = ?(ЗначениеЗаполнено(СерверФункцийPython), СерверФункцийPython, "127.0.0.1");
	ПараметрыПодключения.Порт = 8000;  
	
	Возврат ПараметрыПодключения;
	
КонецФункции

Функция ЗапросКСерверу(ПараметрыЗапроса) Экспорт
		
    Попытка
        Соединение = Новый HTTPСоединение(ПараметрыЗапроса.Сервер, ПараметрыЗапроса.Порт);
        Запрос = Новый HTTPЗапрос("/");
        Ответ = Соединение.Получить(Запрос);
        
		Если НЕ Ответ.КодСостояния = 200 Тогда
			ОбщегоНазначения.СообщитьПользователю("Сервис недоступен");
            Возврат Неопределено;
        КонецЕсли;
    Исключение
        // Сервер не отвечает или порт недоступен
		ОбщегоНазначения.СообщитьПользователю("Сервис недоступен");
		ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке().Причина.Описание);
        Возврат Неопределено;
	КонецПопытки;  
			
	ЗапросСервера = Новый HTTPЗапрос(СтрШаблон("/%1/", ПараметрыЗапроса.Метод));
	
	ЗапросСервера.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(ПараметрыЗапроса.Параметры));   
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	ЗапросСервера.Заголовки = Заголовки;
	
	Попытка
		ОтветСервера = Соединение.ОтправитьДляОбработки(ЗапросСервера);     
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке().Причина.Описание);
		Возврат Неопределено;
	КонецПопытки;  
		
	Возврат ОтветСервера.ПолучитьТелоКакСтроку();
	
КонецФункции
