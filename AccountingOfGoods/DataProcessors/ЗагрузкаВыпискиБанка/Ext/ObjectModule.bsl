
&ИзменениеИКонтроль("ЗагрузитьФайлВТаблицу")
Процедура money_ЗагрузитьФайлВТаблицу(ПараметрыВызоваСервера, АдресХранилища)

	Расширение           = ПараметрыВызоваСервера.Расширение;
	ТабличныйДокумент    = ПараметрыВызоваСервера.ТабличныйДокумент;
	ИмяВременногоФайла   = ПараметрыВызоваСервера.ИмяВременногоФайла;
	Таблица              = Неопределено;

	Если Расширение = "csv" Тогда 

		ЗагрузитьCSVФайлВТаблицу(ИмяВременногоФайла, Таблица);

	ИначеЕсли Расширение = "txt" Тогда 

		ЗагрузитьTXTФайлВТаблицу(ИмяВременногоФайла, Таблица, "Сбербанк");
   #Вставка
	ИначеЕсли Расширение = "pdf" Тогда 

		ИмяФайлаCSV = ПреобразоватьPDFВCSV(ИмяВременногоФайла); 
		
		ФайлCSV = Новый Файл(ИмяФайлаCSV);
		Если Не ФайлCSV.Существует() Тогда
			ОбщегоНазначения.СообщитьПользователю("Файл " + ИмяФайлаCSV + " не найден."); 
			Возврат;
		КонецЕсли;
		
		ЗагрузитьCSVФайлВТаблицу(ИмяФайлаCSV, Таблица);
		Попытка
			УдалитьФайлы(ИмяФайлаCSV);
		Исключение
			// ничего страшного, файл останется во временной папке
		КонецПопытки;	
   #КонецВставки 
	Иначе

		ТабличныйДокумент.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);

	КонецЕсли;

	Если Таблица <> Неопределено Тогда

		// Выгружаем таблицу в табличный документ
		ВыгрузитьТаблицуЗначенийВТабличныйДокумент(Таблица, ТабличныйДокумент, Истина);

	КонецЕсли;

	АдресХранилища = ПоместитьВоВременноеХранилище(ТабличныйДокумент, АдресХранилища);

КонецПроцедуры

Функция ПреобразоватьPDFВCSV(ИмяФайла) Экспорт
	
	// 1. Проверяем существование PDF-файла
	ФайлPDF = Новый Файл(ИмяФайла);
	Если Не ФайлPDF.Существует() Тогда
		ОбщегоНазначения.СообщитьПользователю("Файл " + ИмяФайла + " не найден.");
	КонецЕсли;
	
	// 2. Читаем двоичные данные и кодируем в base64
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
	Base64Строка = Base64Строка(ДвоичныеДанные);
	
	// 3. Формируем параметры запроса
	ПараметрыЗапроса = money_РаботаССерверомPython.ПолучитьПараметрыПодключенияКСерверу();
	ПараметрыЗапроса.Вставить("Метод", "pdftocsv_json");
	
	Параметры = Новый Структура;
	Параметры.Вставить("pdf_base64", Base64Строка);
	ПараметрыЗапроса.Вставить("Параметры", Параметры);
	
	// 4. Вызываем сервис
	ОтветСтрока = money_РаботаССерверомPython.ЗапросКСерверу(ПараметрыЗапроса);
	Если ОтветСтрока = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось получить данные от сервиса конвертации.");
		Возврат Неопределено;
	КонецЕсли;
	
	// 5. Разбираем JSON-ответ (ожидаем {"csv": "..."})
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ОтветСтрока);
	ОтветJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	CSVСтрока = ОтветJSON.csv;
	Если ПустаяСтрока(CSVСтрока) Тогда
		ОбщегоНазначения.СообщитьПользователю("Сервис не вернул CSV-данные.");
	КонецЕсли;
	
	// 6. Сохраняем CSV во временный файл
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".csv");
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, "UTF-8");
	ЗаписьТекста.Записать(CSVСтрока);
	ЗаписьТекста.Закрыть();	
	Возврат ИмяВременногоФайла;
	
КонецФункции

&ИзменениеИКонтроль("ЗагрузитьCSVФайлВТаблицу")
Процедура money_ЗагрузитьCSVФайлВТаблицу(ИмяФайла, Таблица)

	Файл = Новый Файл(ИмяФайла);
	Если НЕ Файл.Существует() Тогда 
		Возврат;
	КонецЕсли;

	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла);

	// Проверка файла
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Если Строка = Неопределено Тогда 
		ТекстСообщения = НСтр("ru = 'Не получилось загрузить данные из этого файла. Убедитесь в корректности данных в файле.'");
		Возврат;
	КонецЕсли;

	Пока ПустаяСтрока(Строка) Цикл
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;
	Если ПустаяСтрока(Строка) Тогда
		ТекстСообщения = НСтр("ru = 'Указанный файл не содержит текст. Убедитесь в корректности данных в файле.'");
		Возврат;
	КонецЕсли;

	//Опрелеляем ограничитель полей
	КавычкаОткрытая = "";
	КавычкаЗакрытая = "";
	ПервыйСимвол     = Лев(СокрЛ(Строка), 1);
	МинимумПовторов  = 4; // ограничители повторяются в начале и конце каждого поля; полей должно быть не менее 5
	ВхожденийСимвола = СтрЧислоВхождений(Строка, ПервыйСимвол);

	Если (ПервыйСимвол = """" ИЛИ ПервыйСимвол = "'" ИЛИ ПервыйСимвол = "*")
		И ВхожденийСимвола >= МинимумПовторов * 2 Тогда

		КавычкаОткрытая = ПервыйСимвол;
		КавычкаЗакрытая = ПервыйСимвол;

	ИначеЕсли ПервыйСимвол = "[" И ВхожденийСимвола >= МинимумПовторов
		И СтрЧислоВхождений(Строка, "]") >= МинимумПовторов Тогда

		КавычкаОткрытая = "[";
		КавычкаЗакрытая = "]";

	ИначеЕсли ПервыйСимвол = "{" И ВхожденийСимвола >= МинимумПовторов
		И СтрЧислоВхождений(Строка, "}") >= МинимумПовторов Тогда

		КавычкаОткрытая = "{";
		КавычкаЗакрытая = "}";

	КонецЕсли;

	// Определяем символ разделителя
	СимволРазделителя = РазделительЗначенийФайлаCSV(Строка, КавычкаОткрытая, КавычкаЗакрытая, МинимумПовторов);
	Если СимволРазделителя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'В указанном файле не удалось определить разделитель показателей. Убедитесь в корректности данных в файле. Убедитесь в корректности данных в файле.'");
		Возврат;
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;

	// Создаем колонки таблицы
	КолонкиШапки = СтрРазделить(Строка, СимволРазделителя, Истина);
	Счетчик = 0;
	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из КолонкиШапки Цикл
		ИменаКолонок.Добавить("Колонка" + Формат(Счетчик, "ЧДЦ=; ЧН=0; ЧГ="));
		Таблица.Колонки.Добавить(ИменаКолонок[Счетчик]);
		Счетчик = Счетчик + 1;
	КонецЦикла;   
	#Вставка     
	Если НЕ money_Кошелек.Пустая() Тогда 
		Таблица.Колонки.Добавить("Кошелек");
		КошелекНаименование = money_Кошелек.Наименование;
	КонецЕсли;
	#КонецВставки
	ВсегоКолонок = Таблица.Колонки.Количество();

	// Заполняем таблицу
	Пока Строка <> Неопределено Цикл

		НоваяСтрока = Таблица.Добавить();

		ЗначенияПолей = СтрРазделить(Строка, СимволРазделителя, Истина);
		Счетчик = 0;
		Для каждого Поле Из ЗначенияПолей Цикл

			ЗначениеПоля = СокрЛП(Поле);
			Если Не ПустаяСтрока(КавычкаОткрытая) Тогда
				ЗначениеПоля = Сред(ЗначениеПоля, 2, СтрДлина(ЗначениеПоля) - 2);
			КонецЕсли;

			Если Счетчик >= ВсегоКолонок Тогда
				ИменаКолонок.Добавить("Колонка" + Формат(Счетчик, "ЧДЦ=; ЧН=0; ЧГ="));
				Таблица.Колонки.Добавить(ИменаКолонок[Счетчик]);
				ВсегоКолонок = Таблица.Колонки.Количество();
			КонецЕсли;

			НоваяСтрока[ИменаКолонок[Счетчик]] = ЗначениеПоля;
			Счетчик = Счетчик + 1;

		КонецЦикла;
        #Вставка     
		Если НЕ money_Кошелек.Пустая() Тогда
			Если Таблица.Индекс(НоваяСтрока) = 0 Тогда    
				НоваяСтрока.Кошелек = "Кошелек";	
			Иначе
				НоваяСтрока.Кошелек = КошелекНаименование; 
			КонецЕсли;
		КонецЕсли;
		#КонецВставки
		Строка = ЧтениеТекста.ПрочитатьСтроку();

	КонецЦикла;

	//ЗаполнитьТаблицуПоЗагруженнымДаннымИзФайла(Источник, ТабличныйДокумент, ИнформацияПоКолонкам);

КонецПроцедуры
