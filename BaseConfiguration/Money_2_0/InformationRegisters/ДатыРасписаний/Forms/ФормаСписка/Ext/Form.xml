				<Field>Список.ШаблонПомеченНаУдаление</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	РегистрСведенийДатыРасписаний.ВладелецРасписания КАК ШаблонОперации,
	РегистрСведенийДатыРасписаний.ПлановаяДата,
	РегистрСведенийДатыРасписаний.АктуальнаяДата КАК АктуальнаяДата,
	РегистрСведенийДатыРасписаний.Пропустить КАК Пропустить,
	РегистрСведенийДатыРасписаний.Выполнено КАК Выполнена,
	ВЫБОР
		КОГДА ЕСТЬNULL(РегистрСведенийДатыРасписаний.ВладелецРасписания.ПометкаУдаления, ЛОЖЬ) = ИСТИНА
			ТОГДА ЛОЖЬ
		КОГДА ЕСТЬNULL(РегистрСведенийДатыРасписаний.ПлановаяОперация.Проведен, ЛОЖЬ) = ЛОЖЬ
				И ЕСТЬNULL(РегистрСведенийДатыРасписаний.ПлановаяОперация.ПометкаУдаления, РегистрСведенийДатыРасписаний.Пропустить) = ЛОЖЬ
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Активность,
	ЕСТЬNULL(РегистрСведенийДатыРасписаний.ПлановаяОперация.ПометкаУдаления, ЛОЖЬ) КАК ОперацияПомеченаНаУдаление,
	ЕСТЬNULL(РегистрСведенийДатыРасписаний.ВладелецРасписания.ПометкаУдаления, ЛОЖЬ) КАК ШаблонПомеченНаУдаление,
	РегистрСведенийДатыРасписаний.СуммаДолга,
	РегистрСведенийДатыРасписаний.СуммаПроцентов,
	РегистрСведенийДатыРасписаний.СуммаКомиссии,
	РегистрСведенийДатыРасписаний.ПлановаяОперация,
	РегистрСведенийДатыРасписаний.СуммаДохода,
	РегистрСведенийДатыРасписаний.ВалютаДохода,
	РегистрСведенийДатыРасписаний.СуммаРасхода,
	РегистрСведенийДатыРасписаний.ВалютаРасхода
ИЗ
	РегистрСведений.ДатыРасписаний КАК РегистрСведенийДатыРасписаний</QueryText>
				<MainTable>InformationRegister.ДатыРасписаний</MainTable>
				<ListSettings>
