
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


// Выполняет проверку корректности записей, исправляет ошибки
Процедура ПерезаписатьШаблоны() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Различные
	|	Расписания.ВладелецРасписания КАК ВладелецРасписания
	|ИЗ
	|	РегистрСведений.Расписания КАК Расписания";
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокОбъект = ?(Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВладелецРасписания), 
				Неопределено, 
				ВыборкаДетальныеЗаписи.ВладелецРасписания.ПолучитьОбъект());
				
		Если ДокОбъект = Неопределено Тогда
			// Шаблон был удален без очистки связанных регистров или из обмена были получены некорректные данные
			Попытка
				Запись = РегистрыСведений.Расписания.СоздатьМенеджерЗаписи();
				Запись.ВладелецРасписания = ВыборкаДетальныеЗаписи.ВладелецРасписания;
				Запись.Удалить();
				
				Набор = РегистрыСведений.ДатыРасписаний.СоздатьНаборЗаписей();
				Набор.Отбор.ВладелецРасписания.Установить(ВыборкаДетальныеЗаписи.ВладелецРасписания);
				Набор.Записать(Истина);
				
				Набор = РегистрыСведений.ОперацииШаблонов.СоздатьНаборЗаписей();
				Набор.Отбор.Шаблон.Установить(ВыборкаДетальныеЗаписи.ВладелецРасписания);
				Набор.Записать(Истина);
				
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВладелецРасписания) Тогда
					Набор = РегистрыНакопления.ОборотыПлановыхОпераций.СоздатьНаборЗаписей();
					Набор.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.ВладелецРасписания);
					Набор.Записать(Истина);
				КонецЕсли;
				
			Исключение
				
				ЗаписьЖурналаРегистрации("Плановые операции", УровеньЖурналаРегистрации.Ошибка,,
					ВыборкаДетальныеЗаписи.ВладелецРасписания,
					СтрШаблон("Не удалось очистить запись расписания для владельца ""%1"" (2)
					|%2", 
						ВыборкаДетальныеЗаписи.ВладелецРасписания, 
						ТипЗнч(ВыборкаДетальныеЗаписи.ВладелецРасписания), 
						ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()))
					);
				
			КонецПопытки;
			
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаписиРегистра(БылиОшибки = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Расписания.ВладелецРасписания
	|ИЗ
	|	РегистрСведений.Расписания КАК Расписания
	|ГДЕ
	|	Расписания.ВладелецРасписания.Ссылка ЕСТЬ NULL";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если Не ЗначениеЗаполнено(Выборка.ВладелецРасписания) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Набор = РегистрыСведений.Расписания.СоздатьНаборЗаписей();
			Набор.Отбор.ВладелецРасписания.Установить(Выборка.ВладелецРасписания);
			Набор.Записать(Истина);
		Исключение
			БылиОшибки = Истина;
			ЗаписьЖурналаРегистрации("Плановые операции", УровеньЖурналаРегистрации.Ошибка,,,
				СтрШаблон("Не удалось очистить записи расписания для владельца ""%1""
				|%2", Выборка.ВладелецРасписания, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()))
				);
		КонецПопытки;
		
		Попытка
			Набор = РегистрыНакопления.ОборотыПлановыхОпераций.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(Выборка.ВладелецРасписания);
			Набор.Записать(Истина);
		Исключение
			БылиОшибки = Истина;
			ЗаписьЖурналаРегистрации("Плановые операции", УровеньЖурналаРегистрации.Ошибка,,,
				СтрШаблон("Не удалось очистить обороты плановых операций для владельца ""%1""
				|%2", Выборка.ВладелецРасписания, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()))
				);
		КонецПопытки;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли