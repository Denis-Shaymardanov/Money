Процедура ОбновитьРеквизитыПлательщиковНДФЛ()
	
	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект = Выборка.ПолучитьОбъект();
		
		РазложитьФИОПлательщика(СпрОбъект);
		СпрОбъект.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		
		Если Не ЗначениеЗаполнено(СпрОбъект.СтранаПостоянногоМестонахождения) Тогда
			СпрОбъект.СтранаПостоянногоМестонахождения = Справочники.СтраныМира.Россия;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СпрОбъект.КатегорияПлательщикаНДФЛ) Тогда
			СпрОбъект.КатегорияПлательщикаНДФЛ = Перечисления.КатегорииНалогоплательщикаНДФЛ.НеПредприниматель;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СпрОбъект.ПолФизическогоЛица) Тогда
			СпрОбъект.ПолФизическогоЛица = Перечисления.ПолФизическогоЛица.Мужской;
		КонецЕсли;
		
		ОбщегоНазначенияДеньги.ЗаписатьСсылочныйОбъект(СпрОбъект, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РазложитьФИОПлательщика(Плательщик)
	
	ФИО = СтрРазделить(Плательщик.Наименование, " ");
	Плательщик.ФамилияИП = ?(ФИО.Количество() > 0, ФИО[0], "");
	Плательщик.ИмяИП = ?(ФИО.Количество() > 1, ФИО[1], "");
	Плательщик.ОтчествоИП = ?(ФИО.Количество() > 2, ФИО[2], "");
	Плательщик.НаименованиеПолное = СокрЛП(Плательщик.ФамилияИП + " " + Плательщик.ИмяИП + " " + Плательщик.ОтчествоИП);
	Плательщик.НаименованиеСокращенное = СокрЛП(Плательщик.ФамилияИП) + " " 
				+ ?(ЗначениеЗаполнено(Плательщик.ИмяИП), Врег(Лев(СокрЛ(Плательщик.ИмяИП), 1)) + ".","")
				+ ?(ЗначениеЗаполнено(Плательщик.ОтчествоИП), Врег(Лев(СокрЛ(Плательщик.ОтчествоИП), 1)) + ".","");
	
КонецПроцедуры


