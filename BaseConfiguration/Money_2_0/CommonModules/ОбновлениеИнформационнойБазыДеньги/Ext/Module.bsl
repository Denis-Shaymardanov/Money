	КонецЕсли;
	
	РегистрыСведений.ЗначенияНастроекИнтеграции.ЗаполнитьЗначениямиПоУмолчанию();
	ИсправитьТипыКонтактнойИнформации();
	ПроверитьОперацииШаблонов();
	
КонецПроцедуры

Процедура ПроверитьОперацииШаблонов()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОперацииШаблонов.Шаблон,
	|	ОперацииШаблонов.Операция,
	|	ОперацииШаблонов.ПлановаяДата,
	|	ОперацииШаблонов.Операция.Дата КАК ОперацияДата
	|ИЗ
	|	РегистрСведений.ОперацииШаблонов КАК ОперацииШаблонов
	|ГДЕ
	|	ОперацииШаблонов.ПлановаяДата = &ПустаяДата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Запись = РегистрыСведений.ОперацииШаблонов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Если ЗначениеЗаполнено(Выборка.ОперацияДата) Тогда
				Запись.ПлановаяДата = Выборка.ОперацияДата;
				Запись.Записать();
			Иначе
				Запись.Удалить();
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("Обновление информационной базы.Деньги", УровеньЖурналаРегистрации.Ошибка, 
					Метаданные.РегистрыСведений.ОперацииШаблонов, ,
					"Не удалось обновить запись РС ОперацииШаблонов для """ + Выборка.Шаблон + """, """ + Выборка.Операция + """:
					|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	СписокУзлов = Неопределено;
	СоставПлана = Неопределено;
	Режим = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	Если Режим = "КлиентОблака" Или Режим = "Разделенный" Тогда
		СписокУзлов = СинхронизацияАвтономныхКопий.ВсеУзлыПланаОбмена("СинхронизацияАвтономныхКопий");
		СоставПлана = Метаданные.ПланыОбмена.СинхронизацияАвтономныхКопий.Состав;
	ИначеЕсли Режим = "ЦентрМобильных" Тогда
		СписокУзлов = СинхронизацияАвтономныхКопий.ВсеУзлыПланаОбмена("МобильноеПриложение");
		СоставПлана = Метаданные.ПланыОбмена.МобильноеПриложение.Состав;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СписокУзлов) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		СинхронизацияАвтономныхКопий.ЗарегистрироватьОбъектМетаданныхКОптправкеНаУзлы(
				Метаданные.РегистрыСведений.ОперацииШаблонов, СписокУзлов, СоставПлана);
	Исключение
		ЗаписьЖурналаРегистрации("Обновление ИБ", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.РегистрыСведений.ОперацииШаблонов, ,
				"Не удалось зарегистрировать регистр сведений для обмена с автономными копиями: 
				|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ИсправитьТипыКонтактнойИнформации()
	
	Запрос = Новый запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	НЕ ВидыКонтактнойИнформации.ЭтоГруппа
	|	И ВидыКонтактнойИнформации.Тип.Ссылка ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаменитьТипКИ(Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаменитьТипКИ(Выборка)
	
	ОбъектВидаКИ = Выборка.Ссылка.ПолучитьОбъект();
	Если СтрНайти(Нрег(ОбъектВидаКИ.Наименование), "адрес") > 0  Тогда
		ОбъектВидаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	ИначеЕсли СтрНайти(Нрег(ОбъектВидаКИ.Наименование), "телефон") > 0 Тогда
		ОбъектВидаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
	ИначеЕсли СтрНайти(Нрег(ОбъектВидаКИ.Наименование), "факс") > 0 Тогда
		ОбъектВидаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Факс;
	ИначеЕсли СтрНайти(Нрег(ОбъектВидаКИ.Наименование), "электронная почта") > 0 Тогда
		ОбъектВидаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	Иначе
		ОбъектВидаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Другое;
	КонецЕсли;
	
	ОбъектВидаКИ.ОбменДанными.Загрузка = истина;
	
	Попытка
		ОбъектВидаКИ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("Обновление ИБ", УровеньЖурналаРегистрации.Ошибка, 
				Неопределено, ,
				"Не удалось обновить тип контактной информации для """ + Выборка.Ссылка + """:
				|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьПланыОбменаСМобильнымиУстройствами()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	План.Ссылка
	|ИЗ
	|	ПланОбмена.МобильноеПриложение КАК План
	|ГДЕ
	|	НЕ План.ЭтотУзел
	|	И НЕ План.МобильноеУстройство";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УзелОбъект = Выборка.Ссылка.ПолучитьОбъект();
		УзелОбъект.МобильноеУстройство = Истина;
		УзелОбъект.ОбменДанными.Загрузка = Истина;
		УзелОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

