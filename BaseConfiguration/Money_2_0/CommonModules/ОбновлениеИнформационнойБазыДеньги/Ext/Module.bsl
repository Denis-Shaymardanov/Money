Процедура ПроверитьНаличиеПредопределенных(БылиОшибки = Ложь) Экспорт
	
	ТекстОшибки = "";
	Если ОбслуживаниеСправочников.ПредопределенныеЭлементыТребуютПроверки() Тогда
		ОбслуживаниеСправочников.ПроверитьПредопределенныеЭлементы(ТекстОшибки);
		БылиОшибки = Не ПустаяСтрока(ТекстОшибки);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ЗаписьЖурналаРегистрации("Обновление информационной базы.Деньги",
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
	КонецЕсли;
	
