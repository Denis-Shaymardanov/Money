Функция ТекстДляHTML(знач Текст)
	
	Результат = СтрЗаменить(
					СтрЗаменить(
						СтрЗаменить(Текст, Символы.ПС, "<br>"), 
					"  ", "&nbsp;&nbsp;"), 
				Символы.Таб, "&nbsp;&nbsp;");
	
	Возврат Результат;
	
КонецФункции



Функция ИмяТранспорта(СостояниеОбмена)
	
	ТекстЗаголовка = "";
	Если СостояниеОбмена.ТекущийВидТранспорта = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.FILE") Тогда
		ТекстЗаголовка = НСтр("ru='ручной обмен файлами'");
	ИначеЕсли СостояниеОбмена.Режим = "КлиентОблака" Тогда
		ТекстЗаголовка = НСтр("ru='сервис 1С:Деньги'");
	ИначеЕсли СостояниеОбмена.ТекущийВидТранспорта = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.WS") Тогда
		ТекстЗаголовка = НСтр("ru='домашняя сеть'");
	Иначе
		ТекстЗаголовка = СтрШаблон(НСтр("ru='облачное хранилище файлов %1'"), 
				СостояниеОбмена.СтатусТранспорта.Провайдер);
	КонецЕсли;
	
	Возврат ТекстЗаголовка;
	
КонецФункции

Функция СтатусТранспорта(СостояниеОбмена, Подробности, ПредставлениеОшибки)
	
	СтатусСервера = СостояниеОбмена.СтатусТранспорта;
	Подробности   = ?(ЗначениеЗаполнено(СтатусСервера.ТекстОшибки), СтатусСервера.ТекстОшибки, "---");
	
	Если Не СостояниеОбмена.ИспользоватьСинхронизацию Тогда
		Возврат НСтр("ru='На устройстве выключена синхронизация'");
		
	ИначеЕсли Не СостояниеОбмена.СтатусТранспорта.СоединениеНастроено Тогда
		Возврат НСтр("ru='Не настроено соединение'");
	
	ИначеЕсли Не ЗначениеЗаполнено(СтатусСервера.Кодсостояния) Тогда
		Возврат НСтр("ru='не определен'");
	
	ИначеЕсли СтатусСервера.Кодсостояния < 10000 Тогда
		ПредставлениеОшибки = ПредставлениеОшибки 
				+ ?(ПредставлениеОшибки = "", Символы.Таб, Символы.ПС + Символы.Таб)
				+ "Транспорт: " + Формат(СтатусСервера.Кодсостояния, "ЧДЦ=0; ЧГ=;");
		Возврат СтрШаблон("ru='сервер вернул ответ с кодом %1'", СтатусСервера.Кодсостояния);
	
	Иначе
		ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеСостоянияПоКоду(СтатусСервера.Кодсостояния);
		Если ОписаниеРезультата.ЯвляетсяОшибкой Тогда
			ПредставлениеОшибки = ПредставлениеОшибки 
					+ ?(ПредставлениеОшибки = "", Символы.Таб, Символы.ПС + Символы.Таб)
					+ "Транспорт: " + Формат(СтатусСервера.Кодсостояния, "ЧДЦ=0; ЧГ=;") 
					+ " - " + ОписаниеРезультата.ТекстОписания;
		КонецЕсли;
		Возврат СтрШаблон("%1%2 - %3", 
				Формат(СтатусСервера.Кодсостояния, "ЧДЦ=0; ЧГ=;"),
				?(ОписаниеРезультата.ЯвляетсяОшибкой, " (ошибка)", ""),
				ОписаниеРезультата.ТекстОписания);
		
	КонецЕсли;
	
КонецФункции

Функция СтатусПроцесса(СтруктураПроцесса, ИмяПроцесса, Подробности, ПредставлениеОшибки)
	
	Подробности   = ?(ЗначениеЗаполнено(СтруктураПроцесса.ТекстОшибки), СтруктураПроцесса.ТекстОшибки, "---");
	
	Если Не ЗначениеЗаполнено(СтруктураПроцесса.КодРезультатаДействия) Тогда
		Возврат НСтр("ru='нет данных'");
	
	Иначе
		
		ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеРезультатаПоКоду(СтруктураПроцесса.КодРезультатаДействия);
		Если ОписаниеРезультата.ЯвляетсяОшибкой Тогда
			ПредставлениеОшибки = ПредставлениеОшибки 
					+ ?(ПредставлениеОшибки = "", Символы.Таб, Символы.ПС + Символы.Таб)
					+ "" + ИмяПроцесса + ": "
					+ Формат(СтруктураПроцесса.КодРезультатаДействия, "ЧДЦ=0; ЧГ=;") 
					+ " - " + ОписаниеРезультата.ТекстОписания;
		КонецЕсли;
		
		Возврат СтрШаблон("%1%2 - %3", 
				Формат(СтруктураПроцесса.КодРезультатаДействия, "ЧДЦ=0; ЧГ=;"),
				?(ОписаниеРезультата.ЯвляетсяОшибкой, " (ошибка)", ""),
				ОписаниеРезультата.ТекстОписания);
		
	КонецЕсли;
	
КонецФункции

Функция ДатаПолностью(Дата)
	
	Если ЗначениеЗаполнено(Дата) Тогда
		Возврат Формат(Дата, "Л=ru_RU; ДФ='dd.MM.yyyy HH:mm:ss';")
	Иначе
		Возврат "<н/д>";
	КонецЕсли;
	
КонецФункции

Функция Длительность(Начало, Конец)
	
	Если Не ЗначениеЗаполнено(Начало) 
		Или Не ЗначениеЗаполнено(Конец) Тогда
		Возврат "";
	КонецЕсли;
	
	Секунд = Конец - Начало;
	Если Секунд >= 60 Тогда
		
		Минут = Цел(Секунд / 60);
		Секунд = Секунд - Минут*60;
		Если Минут >= 60 Тогда
			
			Часов = Цел(Минут / 60);
			Минут = Минут - Часов*60;
			Возврат " (" + Формат(Часов, "ЧДЦ=0; ЧГ=;") + "ч. " + Минут + "м. " + Секунд + "с.)";
			
		Иначе
			Возврат " (" + Минут + "м. " + Секунд + "с.)";
		КонецЕсли;
		
	Иначе
		Возврат " (" + Секунд + "с.)";
		
	КонецЕсли;
	
КонецФункции

