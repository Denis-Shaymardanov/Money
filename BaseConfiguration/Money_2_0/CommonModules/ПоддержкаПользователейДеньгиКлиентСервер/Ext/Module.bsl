#Область ПрограммныйИнтерфейс

// Проверяет правильность записи регистрационного номера программы
//
//Параметры:
//	Номер	- Строка - проверяемый регистрационный номер
//
//Возвращаемое значение:
//	Булево - Истина, если номер записан правлильно, и ЛОЖЬ в ином случае
//
Функция РегистрационныйНомерСоответствуетМаске(Знач Номер) Экспорт

	Если ТипЗнч(Номер) <> Тип("Строка") Или  ПустаяСтрока(Номер)
		Или СтрДлина(Номер) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Номер) 

КонецФункции


Функция ТекстОписанияСостоянияОбмена(СостояниеОбмена, ИмяПроцесса = "") Экспорт
	
	ШаблонHTMLДокумента = ШаблонHTMLДокумента(Истина, Истина);
	ШаблонHTMLДокумента = СтрЗаменить(ШаблонHTMLДокумента, 
			"<!-- ДополнительнаяТаблицаСтилей -->", 
			ДополнительнаяТаблицаСтилей() + Символы.ПС + "<!-- ДополнительнаяТаблицаСтилей -->");
	
	Если Не ЗначениеЗаполнено(СостояниеОбмена) Тогда
		ТелоДокумента = ТекстПустогоСостояния();
	Иначе
		
		ТелоДокумента = ТекстЗаголовкаСостояния(СостояниеОбмена);
		Если Нрег(ИмяПроцесса) = "транспорт" Или Не ЗначениеЗаполнено(ИмяПроцесса) Тогда
			ТелоДокумента = ТелоДокумента + ?(ТелоДокумента = "", "", "<br>" + Символы.ПС)
				+ ТекстСостоянияТранспорта(СостояниеОбмена);
		КонецЕсли;
		Если Нрег(ИмяПроцесса) = "передача" Или Не ЗначениеЗаполнено(ИмяПроцесса) Тогда
			ТелоДокумента = ТелоДокумента + ?(ТелоДокумента = "", "", "<br>" + Символы.ПС)
				+ ТекстСостоянияПроцесса(СостояниеОбмена, "Передача");
		КонецЕсли;
		Если Нрег(ИмяПроцесса) = "прием" Или Не ЗначениеЗаполнено(ИмяПроцесса) Тогда
			ТелоДокумента = ТелоДокумента + ?(ТелоДокумента = "", "", "<br>" + Символы.ПС)
				+ ТекстСостоянияПроцесса(СостояниеОбмена, "Прием");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрЗаменить(ШаблонHTMLДокумента, 
			"<!-- ТелоДокумента -->", 
			ТелоДокумента);
			
КонецФункции

Функция СостояниеСодержитОшибки(СостояниеОбмена, ИмяПроцесса) Экспорт
	
	ЕстьОшибки = Ложь;
	Если НРег(ИмяПроцесса) = "транспорт" Или Не ЗначениеЗаполнено(ИмяПроцесса) Тогда
		Если ЗначениеЗаполнено(СостояниеОбмена.СтатусТранспорта.КодСостояния) Тогда
			
			Если СостояниеОбмена.СтатусТранспорта.Кодсостояния < 10000 Тогда
				ЕстьОшибки = Истина;
			Иначе
				ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеСостоянияПоКоду(СостояниеОбмена.СтатусТранспорта.Кодсостояния);
				Если ОписаниеРезультата.ЯвляетсяОшибкой Тогда
						ЕстьОшибки = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЕстьОшибки И (НРег(ИмяПроцесса) = "прием" Или Не ЗначениеЗаполнено(ИмяПроцесса)) Тогда
		Если ЗначениеЗаполнено(СостояниеОбмена.Прием.КодРезультатаДействия) Тогда
			ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеРезультатаПоКоду(СостояниеОбмена.Прием.КодРезультатаДействия);
			Если ОписаниеРезультата.ЯвляетсяОшибкой Тогда
					ЕстьОшибки = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЕстьОшибки И (НРег(ИмяПроцесса) = "передача" Или Не ЗначениеЗаполнено(ИмяПроцесса)) Тогда
		Если ЗначениеЗаполнено(СостояниеОбмена.Передача.КодРезультатаДействия) Тогда
			ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеРезультатаПоКоду(СостояниеОбмена.Передача.КодРезультатаДействия);
			Если ОписаниеРезультата.ЯвляетсяОшибкой Тогда
					ЕстьОшибки = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции

Функция ТекстСостоянияДляТехподдержки(СостояниеОбмена, ПредставлениеОшибки) Экспорт
	
	ПредставлениеОшибки = "";
	Если Не ЗначениеЗаполнено(СостояниеОбмена) Тогда
		Возврат "состояние обмена неизвестно";
	КонецЕсли;
	
	Результат =
	"==Состояние обмена данными==
	|
	|Транспорт: %1
	|	* последнее обращение: %2
	|	* статус: %3
	|	%4
	|
	|Передача данных:
	|	* время: %5
	|	* статус: %6
	|	%7
	|
	|Прием данных:
	|	* время: %8
	|	* статус: %9
	|	%10
	|";
	
	п1_Транспорт = ИмяТранспорта(СостояниеОбмена);
	п2_Дата = ?(ЗначениеЗаполнено(СостояниеОбмена.СтатусТранспорта.ПоследняяПроверка), 
						ДатаПолностью(СостояниеОбмена.СтатусТранспорта.ПоследняяПроверка), 
						НСтр("ru='нет данных'"));
	п4_Подробности = "";
	п3_Статус = СтатусТранспорта(СостояниеОбмена, п4_Подробности, ПредставлениеОшибки);
	
	СтруктураПроцесса = СостояниеОбмена.Передача;
	п5_Время = СтрШаблон("%1 - %2%3",
			ДатаПолностью(СтруктураПроцесса.НачалоДействия),
			ДатаПолностью(СтруктураПроцесса.ЗавершениеДействия),
			Длительность(СтруктураПроцесса.НачалоДействия, СтруктураПроцесса.ЗавершениеДействия));
	п7_Подробности = "";
	п6_статус = СтатусПроцесса(СтруктураПроцесса, "Передача", п7_Подробности, ПредставлениеОшибки);
	
	СтруктураПроцесса = СостояниеОбмена.Прием;
	п8_Время = СтрШаблон("%1 - %2%3",
			ДатаПолностью(СтруктураПроцесса.НачалоДействия),
			ДатаПолностью(СтруктураПроцесса.ЗавершениеДействия),
			Длительность(СтруктураПроцесса.НачалоДействия, СтруктураПроцесса.ЗавершениеДействия));
	п10_Подробности = "";
	п9_статус = СтатусПроцесса(СтруктураПроцесса, "Прием", п10_Подробности, ПредставлениеОшибки);
	
	
	Возврат СтрШаблон(Результат,
		п1_Транспорт,
		п2_Дата,
		п3_Статус,
		п4_Подробности,
		п5_Время,
		п6_статус,
		п7_Подробности,
		п8_Время,
		п9_статус,
		п10_Подробности
		);
	
КонецФункции


Функция ШаблонHTMLДокумента(ВставитьТаблицуСтилей = Истина, ВставитьСкриптПоказатьСкрытьКонтент = Ложь) Экспорт
	
	ШаблонHTMLДокумента = 
	"<HTML>
	|<HEAD>
	|<META charset=""utf-8"">
	|<META name=viewport content=""text/html, width=device-width, initial-scale=1"" http-equiv=Content-Type>
	|<!-- СкриптПоказатьСкрытьКонтент -->
	|<!-- ТаблицаСтилейПоУмолчанию -->
	|<!-- ДополнительнаяТаблицаСтилей -->
	|</HEAD>
	|<BODY>
	|<!-- ТелоДокумента -->
	|</BODY>
	|</HTML>";
	
	Если ВставитьТаблицуСтилей Тогда
		ШаблонHTMLДокумента = СтрЗаменить(ШаблонHTMLДокумента, "<!-- ТаблицаСтилейПоУмолчанию -->", 
					ТаблицаСтилейПоУмолчанию());
	КонецЕсли;
	
	Если ВставитьСкриптПоказатьСкрытьКонтент Тогда
		ШаблонHTMLДокумента = СтрЗаменить(ШаблонHTMLДокумента, "<!-- СкриптПоказатьСкрытьКонтент -->", 
					ТекстСкриптаПоказатьСкрытьКонтент());
	КонецЕсли;
	
	Возврат ШаблонHTMLДокумента;
	
КонецФункции

Функция ШаблонСвертываемогоКонтента(НачальноеОтображениеСвернутое = Истина) Экспорт
	
	Если НачальноеОтображениеСвернутое Тогда
		ОтображениеЗаголовкаСвернутого = "inline";
		ОтображениеЗаголовкаРазвернутого = "none";
		ОтображениеСвертываемогоКонтента = "none";
	Иначе
		ОтображениеЗаголовкаСвернутого = "none";
		ОтображениеЗаголовкаРазвернутого = "inline";
		ОтображениеСвертываемогоКонтента = "block";
	КонецЕсли;
	
	Возврат 
		"<SPAN class=hiddenContentWithTitle id=hCT<!-- Идентификатор -->>
		|<!-- ТекстПередГиперссылкой --><A class=hiddenContentHRef id=hca<!-- Идентификатор --> onclick=""ShowHideContent('<!-- Идентификатор -->')"" href=""javascript:void(0)""> 
		|<SPAN class=titleWhenHidden id=tHidden<!-- Идентификатор --> style=""DISPLAY: " + ОтображениеЗаголовкаСвернутого + """><!-- ЗаголовокСвернутого --></SPAN><SPAN class=titleWhenVisible id=tVisible<!-- Идентификатор --> style=""DISPLAY: " + ОтображениеЗаголовкаРазвернутого + """><!-- ЗаголовокРазвернутого --></SPAN>
		|</A><!-- ТекстПослеГиперссылки -->
		|<DIV class=hiddenContent id=hC<!-- Идентификатор --> style=""DISPLAY: " + ОтображениеСвертываемогоКонтента + """>
		|<!-- СвертываемыйКонтент -->
		|</DIV></SPAN>";
	
КонецФункции

Функция СвертываемыйКонтент(Идентификатор, Контент, ЗаголовокРазвернутого, ЗаголовокСвернутого = Неопределено, НачальноеОтображениеСвернутое = Истина) Экспорт
	
	Если ЗаголовокСвернутого = Неопределено Тогда
		ЗаголовокСвернутого = ЗаголовокРазвернутого;
	КонецЕсли;
	
	ТекстHTML = ШаблонСвертываемогоКонтента(НачальноеОтображениеСвернутое);
	ТекстHTML = СтрЗаменить(ТекстHTML, "<!-- Идентификатор -->", Идентификатор);
	ТекстHTML = СтрЗаменить(ТекстHTML, "<!-- ЗаголовокРазвернутого -->", ЗаголовокРазвернутого);
	ТекстHTML = СтрЗаменить(ТекстHTML, "<!-- ЗаголовокСвернутого -->", ЗаголовокСвернутого);
	ТекстHTML = СтрЗаменить(ТекстHTML, "<!-- СвертываемыйКонтент -->", Контент);
	
	Возврат ТекстHTML;
	
КонецФункции

Функция МногострочныйТекстВСписокHTML(МногострочныйТекст, ВидСписка = "Маркированный") Экспорт
	
	Если ВидСписка <> "Маркированный" И ВидСписка <> "Нумерованный" Тогда
		ВызватьИсключение НСтр("ru = 'Неверный параметр ВидСписка.'");
	КонецЕсли;
	
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(МногострочныйТекст, Символы.ПС);
	
	СписокHTML = "";
	Для каждого Строка Из Массив Цикл
		СписокHTML = СписокHTML + "<li>" + Строка + "</li>" + Символы.ПС;
	КонецЦикла;
	
	Если ВидСписка = "Маркированный" Тогда
		СписокHTML = "<ul>" + СписокHTML + "</ul>";
	Иначе  // Если ВидСписка = "Нумерованный" Тогда
		СписокHTML = "<ol>" + СписокHTML + "</ol>";
	КонецЕсли;
	
	Возврат СписокHTML;
	
КонецФункции

