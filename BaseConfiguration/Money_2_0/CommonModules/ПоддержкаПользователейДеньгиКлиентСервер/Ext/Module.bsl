Функция ТекстСвертки(Идентификатор, ЗаголовокСвертки, Содержимое)
	
	ЗаголовокСвернутого   = "<H4>+ " + ЗаголовокСвертки + "</H4>";
	ЗаголовокРазвернутого = "<H4>&#8211; " + ЗаголовокСвертки + "</H4>";
	Возврат СвертываемыйКонтент(Идентификатор, Содержимое + "<br>", 
			ЗаголовокРазвернутого, ЗаголовокСвернутого, Истина);
	
