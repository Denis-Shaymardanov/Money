Функция ТекстЗаголовкаСостояния(СостояниеОбмена)
	
	ТекстЗаголовка = "";
	Если СостояниеОбмена.ТекущийВидТранспорта = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.FILE") Тогда
		ТекстЗаголовка = НСтр("ru='Обмен файлами вручную'");
	ИначеЕсли СостояниеОбмена.Режим = "КлиентОблака" Тогда
		ТекстЗаголовка = НСтр("ru='Синхронизация с облачным сервисом 1С:Деньги'");
	ИначеЕсли СостояниеОбмена.ТекущийВидТранспорта = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.WS") Тогда
		ТекстЗаголовка = НСтр("ru='Синхронизация в домашней сети'");
	Иначе
		ТекстЗаголовка = СтрШаблон(НСтр("ru='Обмен через облачное хранилище файлов %1'"), 
				СостояниеОбмена.СостояниеТранспорта.Провайдер);
	КонецЕсли;
	
	Возврат СтрШаблон(
	"
	|<h1>%1</h1>
	|
	|", ТекстЗаголовка);
	
КонецФункции

Функция ТекстСостоянияТранспорта(СостояниеОбмена)
	
	ВсеКодыСостояния    = ПроцессыОбменаВызовСервера.ВсеКодыСостоянияСервера();
	СостояниеТранспорта = СостояниеОбмена.СтатусТранспорта;
	ЭтоОшибка           = Ложь;
	ТекущееСостояние    = "";
	МоментОпроса        = "";
	РезультатОпроса     = "";
	ТекстРекомендации   = "";
	
	Если Не СостояниеОбмена.ИспользоватьСинхронизацию Тогда
		ТекущееСостояние = НСтр("ru='На устройстве выключена синхронизация'");
		ТекстРекомендации = НСтр("ru='Выберите способ синхронизации и настройте соединение с сервером или настольной программой'");
		
	ИначеЕсли Не СостояниеТранспорта.СоединениеНастроено Тогда
		
		Если СостояниеОбмена.Режим = "КлиентОблака" Тогда
			ТекущееСостояние = НСтр("ru='Не настроено подключение к серверу'");
			ТекстРекомендации = НСтр("ru='Откройте настройки подключения к облачному сервису, укажите корректные логин "
			+"и пароль и подключите это приложение.
			|Если в облачном сервисе еще нет учетной записи, зарегистрируйтесь'");
			
		Иначе
			ТекущееСостояние = НСтр("ru='Не настроено соединение с настольной программой'");
			ТекстРекомендации = НСтр("ru='В настройках настольной программы выберите домашнюю сеть и (или) облачное хранилище файлов, "
			+"укажите нужные параметры и нажмите кнопку ""Проверить"". 
			|После этого выполните обмен файлами заново'");
			
		КонецЕсли;
	
	Иначе
		
		#Если Клиент Тогда
			СвойстваФЗ = ДеньгиКлиент.ПараметрПриложения("Деньги.Обмен.ФоновоеЗадание", Неопределено);
		#Иначе
			СвойстваФЗ = ПроцессыОбменаВызовСервера.ФоновоеЗаданиеОбмена();
		#КонецЕсли
		
		Если СвойстваФЗ = Неопределено Или СвойстваФЗ.Статус = "Выполнено" Тогда
			
			ТекущееСостояние = СостояниеОбмена.СтруктураПредставления.СостояниеТранспорта;
			
		ИначеЕсли СвойстваФЗ.Статус = "Выполняется" Тогда 
			ТекущееСостояние = НСтр("ru='выполняется обмен данными в фоновом задании'");
			
		ИначеЕсли СвойстваФЗ.Статус = "Отменено" Тогда 
			ТекущееСостояние = НСтр("ru='оменено фоновое задание обмена данными'");
			
		ИначеЕсли СвойстваФЗ.Статус = "Ошибка" Тогда 
			ТекущееСостояние = СтрШаблон(
					НСтр("ru='фоновое задание обмена данными было завершено с ошибкой:
					|%1'"),
					СвойстваФЗ.КраткоеПредставлениеОшибки);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СостояниеТранспорта.Кодсостояния) Тогда
			
			МоментОпроса = СтрШаблон(НСтр("ru='Последнее обращение: %1'"), ?(ЗначениеЗаполнено(СостояниеТранспорта.ПоследняяПроверка), 
						ДатаПолностью(СостояниеТранспорта.ПоследняяПроверка), 
						НСтр("ru='дата-время неизвестны'")));
			
			Если СостояниеТранспорта.Кодсостояния = ВсеКодыСостояния.Готов.Код Тогда
				Если СостояниеОбмена.Режим = "КлиентОблака" Тогда
					РезультатОпроса = НСтр("ru='сервер готов к работе'");
				ИначеЕсли СостояниеОбмена.ТекущийВидТранспорта = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.FILE") Тогда 
					РезультатОпроса = НСтр("ru='к обмену файлом все готово'");
				ИначеЕсли СостояниеОбмена.ТекущийВидТранспорта = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.WS") Тогда 
					РезультатОпроса = НСтр("ru='домашляя сеть готова к работе'");
				Иначе
					РезультатОпроса = НСтр("ru='облачное хранилище готово к работе'");
				КонецЕсли;
				
			ИначеЕсли СостояниеТранспорта.Кодсостояния < 10000 Тогда
				ЭтоОшибка = Истина;
				РезультатОпроса = "<span class=err>" + СтрШаблон(НСтр("ru='возникла ошибка с кодом %1<br>
				|%2'"), 
					СостояниеТранспорта.Кодсостояния,
					?(ЗначениеЗаполнено(СостояниеТранспорта.ТекстОшибки), 
							ТекстДляHTML(СостояниеТранспорта.ТекстОшибки), 
							НСтр("ru='дополнительной информации нет'"))) + "</span>";
							
				Если СостояниеОбмена.Режим = "КлиентОблака" Тогда
					ТекстРекомендации = НСтр("ru='Причиной могли стать временные проблемы со связью или доступностью сервера.
					|Попробуйте повторить через несколько минут. Если ошибка будет повторяться, отправьте сообщение "
					+"в нашу поддержку, посторяемся разобраться с проблемой как можно быстрей'");
					
				Иначе
					ТекстРекомендации = НСтр("ru='Причиной могли стать временные проблемы со связью или доступность "
					+"облачного хранилища файлов. Проверьте настройки облачного хранилища, авторизацию в нем, наличие свободного места там.
					|После - повторите попытку. Если ошибка будет повторяться, отправьте сообщение "
					+"в нашу поддержку, посторяемся разобраться с проблемой как можно быстрей'");
						
				КонецЕсли;
					
			Иначе
				ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеСостоянияПоКоду(СостояниеТранспорта.Кодсостояния);
				ЭтоОшибка = ОписаниеРезультата.ЯвляетсяОшибкой;
				Если ЭтоОшибка Тогда
					ШаблонРезультата = "<span class=err>" + НСтр("ru='произошла ошибка с кодом: %1 - <b>%2</b><br>
						|%3'") + "</span>";
				Иначе
					ШаблонРезультата = НСтр("ru='получен результат с кодом: %1 - <b>%2</b><br>
						|%3'");
				КонецЕсли;
				РезультатОпроса = СтрШаблон(ШаблонРезультата, 
					СостояниеТранспорта.Кодсостояния, ТекстДляHTML(ОписаниеРезультата.ТекстОписания),
					?(ЗначениеЗаполнено(СостояниеТранспорта.ТекстОшибки), 
							ТекстДляHTML(СостояниеТранспорта.ТекстОшибки), 
							НСтр("ru='дополнительной информации нет'")));
				ТекстРекомендации = ТекстДляHTML(ОписаниеРезультата.ТекстРекомендации);
				
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЕсли;
	
	Возврат СтрШаблон("
	|<div>
	|<h2>Информация о транспорте</h2>
	|
	|<p>
	|Текущее состояние: %1<br>
	|%2 %3
	|</p>
	|<hr>
	|%4
	|</div>
	|",
		ТекущееСостояние, 
		МоментОпроса + ?(МоментОпроса = "", "", ": "),
		РезультатОпроса + ?(РезультатОпроса = "", "", "<br>"),
		?(ТекстРекомендации = "", "", "<p><span class=example>" + ТекстРекомендации + "</span></p>")
		);
	
	
	
КонецФункции

Функция ТекстСостоянияПроцесса(СостояниеОбмена, ИмяПроцесса)
	
	ЗаголовокПроцесса  = "";
	ДатаСостояния      = "";
	ТекстСостояния     = "";
	ТекстОшибки        = "";
	ТекстРекомендации  = "";

	Если НРег(ИмяПроцесса) = "прием" Тогда
		ЗаголовокПроцесса = НСтр("ru='⇘ Прием данных'");
		ТекстСостояния = ТекстДляHTML(СостояниеОбмена.СтруктураПредставления.СостояниеПрием);
	Иначе
		ЗаголовокПроцесса = НСтр("ru='⇖ Передача данных'");
		ТекстСостояния = ТекстДляHTML(СостояниеОбмена.СтруктураПредставления.СостояниеПередача);
	КонецЕсли;
	
	СтруктураПроцесса = СостояниеОбмена[ИмяПроцесса];
	
	Если Не ЗначениеЗаполнено(СтруктураПроцесса.КодРезультатаДействия)
		И Не ЗначениеЗаполнено(СтруктураПроцесса.ДействиеПроцесса) Тогда
		
		ТекстСостояния     = НСтр("ru='процесс не начинался или его состояние было очищено'");
		Если СостояниеОбмена.Режим = "КлиентОблака" Тогда
			ТекстРекомендации = НСтр("ru='Дождитесь автоматического запуска синхронинизации или выполните синхронизацию вручную'");
		Иначе
			ТекстРекомендации = НСтр("ru='Выполните обмен с настольной программой'");
		КонецЕсли;
		
	Иначе
		
		ТекстСостояния = СтрШаблон("%1 - <b>%2</b>", СтруктураПроцесса.КодРезультатаДействия, ТекстСостояния);
		
		Если ЗначениеЗаполнено(СтруктураПроцесса.ТекстОшибки) Тогда
			htmlТекстОшибки = "<div class=details><code>" + ТекстДляHTML(СтруктураПроцесса.ТекстОшибки) + "</code></div>";
			ТекстОшибки = ?(ЗначениеЗаполнено(СтруктураПроцесса.ТекстОшибки), 
					ТекстСвертки("ТекстОшибки" + ИмяПроцесса, НСтр("ru='подробности…'"), htmlТекстОшибки), 
					"");
		КонецЕсли;
		
		ДатаСостояния = ?(СтруктураПроцесса.ПроцессЗавершен, 
				СтрШаблон(НСтр("ru='(%1)'"), 
						ДатаПолностью(СтруктураПроцесса.ЗавершениеДействия)), 
				СтрШаблон(НСтр("ru='(начало: %1)'"), 
						ДатаПолностью(СтруктураПроцесса.НачалоДействия)));
		
		Если ЗначениеЗаполнено(СтруктураПроцесса.КодРезультатаДействия) Тогда
			
			ОписаниеРезультата = ПроцессыОбменаВызовСервера.ОписаниеРезультатаПоКоду(СтруктураПроцесса.КодРезультатаДействия);
			Если ОписаниеРезультата.ЯвляетсяОшибкой Тогда
				ТекстСостояния = "<span class=err>" 
						+ ТекстСостояния + "</span>";
			КонецЕсли;
			
			Если Не ОписаниеРезультата.ЯвляетсяУспехом Тогда
				ТекстРекомендации = ТекстДляHTML(ОписаниеРезультата.ТекстРекомендации);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураПроцесса.ДействиеПроцесса) Тогда
			
			ТекстРекомендации = НСтр("ru='Некоторые процессы обмена могут выполняться достаточно долго. 
			|Это зависит от выбранного сценария и количества записей, помеченных для обмена.<br>
			|Дождитесь завершения процесса. Если процесс был остановлен - нажмите кнопку ""Продолжить"" 
			|и подождите, пока он не завершится'");
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Возврат СтрШаблон("
	|<div>
	|<h2>%1</h2>
	|
	|<p>
	|%2 %3
	|</p><br>
	|%4<br>
	|<hr>
	|%5
	|</div>
	|",
		ЗаголовокПроцесса,
		ТекстСостояния,
		ДатаСостояния,
		?(ТекстОшибки = "", "", ТекстОшибки + "<br>"),
		?(ТекстРекомендации = "", "", "<p><span class=example>" + ТекстРекомендации + "</span></p>")
		);
	
	
КонецФункции



