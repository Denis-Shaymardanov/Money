Функция НовыйТаблицаВычетаЗаПериод(Организация = Неопределено, НачалоПериода = Неопределено)
	
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2,0));
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("НомерМесяца", ТипЧисло);
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("ВсегоДетей", ТипЧисло);
	Результат.Колонки.Добавить("Несовершеннолетних", ТипЧисло);
	Результат.Колонки.Добавить("РодныеДетиИнвалиды", ТипЧисло);
	Результат.Колонки.Добавить("ПриемныеДетиИнвалиды", ТипЧисло);
	Результат.Колонки.Добавить("ПрименяетсяДвойнойВычет", Новый ОписаниеТипов("Булево"));
	
	НачГода = ?(ЗначениеЗаполнено(НачалоПериода), НачалоГода(НачалоПериода), НачалоГода(ТекущаяДата()));
	Для Счетчик = 1 По 12 Цикл
		СтрокаВычета = Результат.Добавить();
		СтрокаВычета.Период      = НачалоМесяца(ДобавитьМесяц(НачГода, Счетчик));
		СтрокаВычета.НомерМесяца = Счетчик;
		СтрокаВычета.Организация = Организация;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

