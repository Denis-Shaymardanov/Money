#Область ПрограммныйИнтерфейс

// Возвращает структуру с описанием указанного кода результата действия
//
//Параметры:
//	КодРезультата - Число - код результата действия обмена
//
//Возвращаемое значение:
//	Структура или ФиксированнаяСтруктура - см. ДобавитьКодРезультата();
//
Функция ОписаниеРезультатаПоКоду(КодРезультата) Экспорт

	ИскомыйКод = ?(ЗначениеЗаполнено(КодРезультата), КодРезультата, 0);
	ВсеКоды    = ВсеКодыРезультатовДействий();
	Результат  = Новый Структура("Код,ТекстОписания,ТекстРекомендации,ЯвляетсяОшибкой,ЯвляетсяУспехом",
			КодРезультата,
			НСтр("ru='Неизвестный результат'"),
			НСтр("ru='Операция завершилась с неизвестным результатом'"),
			Истина, Ложь);
	
	Для Каждого СтруктураКода Из ВсеКоды Цикл
		Если СтруктураКода.Значение.Код = ИскомыйКод Тогда
			Результат = СтруктураКода.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает все коды результатов действий процесса обмена с описаниями причин и подсказок для пользователя текущего сеанса
// т.е. если сервер вернул код 70503, то пользовтаель получит описание именно для клиента облачного сервиса
// 
//Параметры:
//	нет
//
//Возвращаемое значение:
//	ФиксированнаяСтруктура, ключем является ключевое слово, значением - фиксированная структура с описанием кода и рекомендациями пользователю
//		* Неизвестно 0
//		* Выполнено 70200
//		* ОшибкаПрограммы 70400
//		* НетЛицензий 70402
//		* ОбменЗапрещен 70403
//		* НетИнтернетСоединения 70407
//		* ИстеклоВремяОжидания 70408
//		* ТребуетсяОбновление 70426
//		* ОперацияОтменена 70499
//		* ОшибкаНаСервере 70500
//		* СерверНедоступен 70503
//		* ОшибкаПолученияФайла 70600
//		* ОшибкаЧтенияПакета 70601
//		* НомерПакетаМеньшеИлиРавен 70610
//		* СценарийНеСоответствует 70611	
//		* НеправильныйОтправительИлиПолучатель 70612
//		* ОшибкаОтправкиФайла 70660	
//		* ОтсутствуютДанныеДляВыгрузки 70701	
//		* ОтсутствуютДанныеДляЗагрузки 70702	
//		* ОшибкаБлокировкиКонтрольнойЗаписи 70704
//		* ПриемОжидаетЗавершенияПередачи 70705
//		* ОблачныйСервисНеНастроен 70801	
//		* НетФайлаСпискаУстройств 70802	
//		* ФайлСпискаУстройствПустой 70803
//		* ФайлСпискаЧужой 70804
//
Функция ВсеКодыРезультатовДействий() Экспорт
	
	КодыРезультатов = Новый Структура();
	Режим           = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	
	ДобавитьКодРезультата(КодыРезультатов, "Неизвестно", 0,     "Не выполнялось", "Операция не выполнялась");
	ДобавитьКодРезультата(КодыРезультатов, "Выполнено", 70200, "Выполнено",      "Операция успешно выполнена");
	
	// Проблемы на стороне клиента
	ДобавитьКодРезультата(КодыРезультатов, "ОшибкаПрограммы", 70400, "Внутренняя ошибка программы", 
			"Попробуйте выполнить операцию еще раз. Если ошибка повторится, отправьте сообщение в службу поддержки, постараемся решить проблему как можно быстрей.
			|Подробный текст ошибки записан в журнале регистрации"
			, Истина);
	ДобавитьКодРезультата(КодыРезультатов, "НетЛицензий", 70402, "Недостаточно лицензий",
			"Проверьте активные подписки. При необходимости, купите подписку на недостающее количество лицензий или отключите от облачного сервиса лишние информационные базы");
	Если Режим = "ЦентрМобильных" Тогда
		ДобавитьКодРезультата(КодыРезультатов, "ОбменЗапрещен", 70403, "Обмен с мобильным приложением запрещен", 
				"Мобильное приложение, от которого получен файл с данными, помечено устаревшим или утерянным.
				|Проверьте статус устройства в меню 'Сервис' -> 'Синхронизация с мобильными устройствами'. Если нужно, верните устройству отметку 'Устройство активно' ");
	Иначе
		ДобавитьКодРезультата(КодыРезультатов, "ОбменЗапрещен", 70403, "Обмен с этой информационной базой запрещен", 
				"Эта информационная база помечена на сервере устаревшей или утерянной.
				|Проверьте её статус в меню 'Сервис' -> 'Управление сервисом автосинхронизации' -> 'Список подключенных программ'");
	КонецЕсли;
	
	ДобавитьКодРезультата(КодыРезультатов, "НетИнтернетСоединения", 70407, "Интернет-соединение отсутствует или запрещено", 
			"Проверьте доступность интернета на устройстве.
			|Так же проверьте разрешеня на обмен данными через интернет и в роуминге в настройках синхронизации");
	
	ДобавитьКодРезультата(КодыРезультатов, "ИстеклоВремяОжидания", 70408, "Истекло время ожидания ответа",
			"От сервера не получен ответ. Проверьте интернет-соединение, доступность сервера и повторите попытку");
	ДобавитьКодРезультата(КодыРезультатов, "ТребуетсяОбновление", 70426, "Требуется обновить приложение",
			"Проверьте обновление программы в меню 'Сервис' -> 'Настройка и обслуживание' или на сайте releases.1c.ru. 
			|Установите свежие обновления и повторите операцию");
	ДобавитьКодРезультата(КодыРезультатов, "ОперацияОтменена", 70499, "Отменено пользователем",
			"Синхронизация была отменена пользователем");
	
	// Проблемы на стороне сервера
	ДобавитьКодРезультата(КодыРезультатов, "ОшибкаНаСервере", 70500, "Внутренняя ошибка на сервере", 
			"Об этой ошибке сервер уже отправил сообщение в службу поддержки и мы постараемся устранить проблему как можно скорей.
			|Попробуйте выполнить операцию еще раз спустя какое-то время
			|Подробный текст ошибки записан в журнале регистрации"
			, Истина);
	ДобавитьКодРезультата(КодыРезультатов, "СерверНедоступен", 70503, "Сервер временно недоступен", 
			"Возможно, на сервере выполняются технические регламенты или устанавливаются обновления.
			|Попробуйте выполнить операцию еще раз спустя какое-то время");
	
	// Прочие проблемы
	Если Режим = "ЦентрМобильных" Тогда
		ДобавитьКодРезультата(КодыРезультатов, "ОшибкаПолученияФайла", 70600, "Ошибка получения файла", 
				"Не удалось получить файл или одну из его частей.
				|Попробуйте заново выполнить обмен в Миниденьгах, затем повторите синхронизацию в настольной программе
				|Если новая попытка закончится с тем же результатом, сообщите нам в службу поддержки, постараемся разобраться с проблемой как можно быстрей.
				|Подробный текст ошибки записан в журнале регистрации",
				 Истина);
	Иначе
		ДобавитьКодРезультата(КодыРезультатов, "ОшибкаПолученияФайла", 70600, "Ошибка получения файла", 
				"Не удалось получить файл или одну из его частей.
				|Попробуйте выполнить операцию еще раз. Если ошибка повторится, сообщите нам в службу поддержки, постараемся разобраться с проблемой как можно быстрей.
				|Подробный текст ошибки записан в журнале регистрации",
				 Истина);
	КонецЕсли;
	ДобавитьКодРезультата(КодыРезультатов, "ОшибкаЧтенияПакета", 70601, "Ошибка чтения пакета", 
			"Не удалось прочитать файл с пакетом данных.
			|Попробуйте выполнить операцию еще раз. Если ошибка повторится, отправьте сообщение в службу поддержки.
			|Подробный текст ошибки записан в журнале регистрации",
			Истина);
	Если Режим = "ЦентрМобильных" Тогда
		ДобавитьКодРезультата(КодыРезультатов, "НомерПакетаМеньшеИлиРавен", 70610, "Номер пакета меньше или равен номеру загруженного ранее", 
				"Возможно, от мобильного устройства получен устаревший файл. Программа не стала его загружать, чтобы не затереть последние изменения.
				|Выполните синхронизацию еще раз - сначала в мобильном приложении, затем в этой программе. 
				|Если ситуация не изменится, а вы уверены в корректности загружаемых данных, обнулите номер принятого пакета в этой программе:
				| - в Синхронизации с мобильными устройствами откройте нужное мобильное устройство
				| - раскройте группу ""Параметры обмена данными"" и измените ""# принятого"" на ноль
				| - нажмите ""Записать и закрыть""
				|После этого повторите обмен в настольной программе ");
	Иначе
		ДобавитьКодРезультата(КодыРезультатов, "НомерПакетаМеньшеИлиРавен", 70610, "Номер пакета меньше или равен номеру загруженного ранее", 
				"В программу попал устаревший пакет данных. Ранее был загружен более свежий пакет.
				|Попробуйте выполнить синхронизацию еще раз.");
	КонецЕсли;
	ДобавитьКодРезультата(КодыРезультатов, "СценарийНеСоответствует", 70611, "Сценарий обмена не соответствует затребованному", 
			"Данные, полученные программой, подготовлены не по тому сценарию, который ожидается. Следует выполнить синхронизацию еще раз.");
	
	ДобавитьКодРезультата(КодыРезультатов, "НеправильныйОтправительИлиПолучатель", 70612, "Неправильные коды отправителя или получателя данных", 
			"Приложение получило данные, в которых указаны некорректные коды отправителя и/или получателя.
			|Возможно, файл с данными был изменен в стороннем приложении, или синхронизация была настроена некорректно.
			|Попрбуйте отключить синхронизацию, затем включить ее и повторить синхронизацию заново");
	
	ДобавитьКодРезультата(КодыРезультатов, "ОшибкаОтправкиФайла", 70660, "Ошибка отправки файла", 
			"При отправке файла возникли проблемы; подробная инофрмация записана в журнале регистрации.
			|Пожалуйста, повторите полный цикл синхронизации еще раз. Если ошибка повторится, сообщите нам в службу поддержки, постараемся разобраться с проблемой как можно быстрей.",
			Истина);
	
	ДобавитьКодРезультата(КодыРезультатов, "ОтсутствуютДанныеДляВыгрузки", 70701, "Нет данных для выгрузки", 
			"В этой базе нет изменений, не выгруженных на сервер");
	ДобавитьКодРезультата(КодыРезультатов, "ОтсутствуютДанныеДляЗагрузки", 70702, "Нет данных для загрузки", 
			"Возможно, пакет не содержал изменений или был удален из базы до его обработки.
			|Попробуйте выпонить синхронизацию еще раз");
	
	ДобавитьКодРезультата(КодыРезультатов, "ОшибкаБлокировкиКонтрольнойЗаписи", 70704, "Не удалось заблокировать контрольную запись", 
			"Возможно, обмен с этим узлом уже выполняется в друном сеансе или в фоновом задании.
			|Дождитесь завершения синхронизации перед повторением попытки");
	
	Если Режим = "ЦентрМобильных" Тогда
		ДобавитьКодРезультата(КодыРезультатов, "ПриемОжидаетЗавершенияПередачи", 70705, "Ожидается завершение передачи", 
				"Выбранный сценарий не позволяет загрузить данные из мобильного приложения до того, как в мобильном "
				+"завершится загрузка полученных данных.
				|Дождитесь завершения загрузки в мобильном приложении, после чего синхронизация продолжится");
	Иначе
		ДобавитьКодРезультата(КодыРезультатов, "ПриемОжидаетЗавершенияПередачи", 70705, "Ожидается завершение передачи", 
				"Выбранный сценарий не позволяет получить данные с сервера до того, как сервер "
				+"завершит загрузку полученных данных.
				|Дождитесь завершения загрузки на сервере, после чего синхронизация продолжится");
	КонецЕсли;
	
	ДобавитьКодРезультата(КодыРезультатов, "ОблачныйСервисНеНастроен", 70801, "Облачное хранилище файлов не настроено", 
			"Возможно, не завершена настройка соединения с облачным хранилищем файлов.
			|Откройте в меню Сервис -> ""Синхронизация с мобильными устройствами"" и проверте:
			|	- включен переключатель обмена файлами через облачное хранилище
			|	- в настройках обачного сервиса указано имя этой базы и выбран правильный сервис
			|	- программа авторизована в этом сервисе
			|	- нажатие на кнопку ""Проверка сервиса"" сообщает о готовности к обмену");
			
	ДобавитьКодРезультата(КодыРезультатов, "НетФайлаСпискаУстройств", 70802, "В хранилище нет файла списка устройств", 
			"Возможно, в облачном серсиве этот служебный файл был удален или настройка обмена не была завершена
			|Пожалуйста, откройте в меню Сервис -> ""Синхронизация с мобильными устройствами"" и в настройках облачного 
			|сервиса нажмите кнопку ""Проверка сервиса"". Убедитесь, что программа сообщает о готовности к обмену");
			
	ДобавитьКодРезультата(КодыРезультатов, "ФайлСпискаУстройствПустой", 70803, "Файл списка устройств пустой", 
			"В служебном файле в облачном хранилище нет активных мобильных устройств.
			|Убедитесь, что в настольной программе нужные мобильные устройства отмечены как активные.
			|Откройте Миниденьги на мобильном устройстве и проверьте, что там:
			|	- выбран способ синхронизации ""Обмен файлами черех настольную программу""
			|	- в настройках синхронизации с облачным хранилищем облачный сервис и имя базы на компьютере указаты такие же, как в настольной программе
			|	- Миниденьги авторизованы в облачном хранилище под тем же логином, что и настольная программа
			|После проверки настроек в Миниденьгах выполните обмен файлами сначала в Миниденьгах, затем в настольной программе, после этого снова в Миниденьгах");
			
	ДобавитьКодРезультата(КодыРезультатов, "ФайлСпискаЧужой", 70804, "Файл списка принадлежит другой настольной программе", 
			"Скорей всего в настройках облачного сервиса указано имя этой базы, которое ранее использовалось другой копией настольной программы.
			|Откройте в меню Сервис -> ""Синхронизация с мобильными устройствами"" и в настройках облачного сервиса измените Имя этой базы.
			|Точно такое же имя укажите в настройках синхронизации Миниденег. После этого выполните синхронизацию сначала в настольной программе, затем в Миниденьгах");
	
	Возврат Новый ФиксированнаяСтруктура(КодыРезультатов);
	
КонецФункции

// Возвращает структуру с описанием указанного кода сосояния сервера
//
//Параметры:
//	КодРезультата - Число - код состояния сервера
//
//Возвращаемое значение:
//	Структура или ФиксированнаяСтруктура - см. ДобавитьКодРезультата();
//
Функция ОписаниеСостоянияПоКоду(КодРезультата) Экспорт

	ИскомыйКод = ?(ЗначениеЗаполнено(КодРезультата), КодРезультата, 0);
	Результат  = Новый Структура("Код,ТекстОписания,ТекстРекомендации,ЯвляетсяОшибкой,ЯвляетсяУспехом",
			ИскомыйКод,
			НСтр("ru='Неизвестное состояние'"),
			НСтр("ru='Состояние сервера не было определено'"),
			Истина, Ложь);

	Если ИскомыйКод = 0 Тогда
		Возврат Результат;
	
	ИначеЕсли ИскомыйКод < 10000 Тогда
		
		Результат.ТекстОписания = НСтр("ru='Ошибка выполнения запроса на сервере'");
		Результат.ТекстРекомендации = НСтр("ru='Ошибка могла возникнуть из-за картковременных помех со связью или на сервере.
		|Попробуйте повторить операцию еще раз немного позже.
		|Если запрос на сервере будет постоянно завершаться с этим результатом, отравьте сообщение нам в службу поддержки'");
		
		Возврат Результат;
		
	КонецЕсли;
	
	ВсеКоды    = ВсеКодыСостоянияСервера();
	Для Каждого СтруктураКода Из ВсеКоды Цикл
		Если СтруктураКода.Значение.Код = ИскомыйКод Тогда
			Результат = СтруктураКода.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
