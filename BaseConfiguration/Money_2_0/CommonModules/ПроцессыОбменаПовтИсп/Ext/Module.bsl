Процедура ДобавитьКодРезультата(ВсеКоды, Ключ, Код, ТекстОписания, ТекстРекомендации = "", ЯвляетсяОшибкой = Ложь)
	
	Описание = Новый Структура;
	Описание.Вставить("Код",               Код);
	Описание.Вставить("ТекстОписания",     ТекстОписания);
	Описание.Вставить("ТекстРекомендации", ТекстРекомендации);
	Описание.Вставить("ЯвляетсяОшибкой",   ЯвляетсяОшибкой);
	Описание.Вставить("ЯвляетсяУспехом",   Код = 10200 Или Код = 70200);
	
	ВсеКоды.Вставить(Ключ, Новый ФиксированнаяСтруктура(Описание));
	
