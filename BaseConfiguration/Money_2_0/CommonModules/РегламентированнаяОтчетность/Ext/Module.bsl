			"http://v8.1c.ru/lawmonitor/lawchanges.jsp?&regReportForm=%1&regReportOnly=true&userConfiguration=%2",
			Выборка.УИДОтчета, УИДКонфигурации);
	Иначе
		ОбщаяЧастьСсылкиНаИзмененияЗаконодательства = "";
