// БСП. ОбщегоНазначенияКлиентПереопределяемый.ПослеНачалаРаботыСистемы()
//
Процедура ПослеНачалаРаботыСистемы() Экспорт
	
	ПараметрыРаботыКлиента = СтандартныеПодсистемыКлиентПовтИсп.ПараметрыРаботыКлиентаПриЗапуске();
	Если Не ПараметрыРаботыКлиента.Свойство("Деньги_РежимРаботыПриложения") 
		Или ПараметрыРаботыКлиента.Деньги_РежимРаботыПриложения = "Неразделенный" Тогда
		// инетрфейс администратора сервера
		ИмяФормы = "РегистрСведений.СообщенияОбменаДаннымиОбластейДанных.ФормаСписка";
		ОткрытьФорму(ИмяФормы);
		Возврат;
	КонецЕсли;
		
	// интерфейс пользователя приложения
	
	// Открытие помощника начала работы
	Если ПараметрыРаботыКлиента.Свойство("ОткрытьПомощникНачалаРаботы") 
		И ПараметрыРаботыКлиента.ОткрытьПомощникНачалаРаботы Тогда
	
		ДеньгиВызовСервера.УстановитьИнтерфейсПриложенияПоФорме(
					"Обработка.ПомощникНачалаРаботы.Форма", Истина);
		ОбновитьИнтерфейс();
		Возврат;
	
	КонецЕсли;
	
	// Открытие раздела, заданного в настройках
	Если Нрег(ПараметрыРаботыКлиента.ПриЗапускеОткрыватьРаздел) = "операции"  Тогда
		ОткрытьФорму("Обработка.РазделОперации.Форма.СписокДокументовИОстатки");
	ИначеЕсли Нрег(ПараметрыРаботыКлиента.ПриЗапускеОткрыватьРаздел) = "бюджет"  Тогда
		ОткрытьФорму("Обработка.РазделБюджет.Форма.ФормаРаздела");
	ИначеЕсли Нрег(ПараметрыРаботыКлиента.ПриЗапускеОткрыватьРаздел) = "календарь"  Тогда
		ОткрытьФорму("Обработка.ПлановыеОперации.Форма.ФормаКалендаря");
	ИначеЕсли Нрег(ПараметрыРаботыКлиента.ПриЗапускеОткрыватьРаздел) = "накопления"  Тогда
		ОткрытьФорму("Обработка.РазделНакопления.Форма.ОсновнаяФорма");
	КонецЕсли; 
	
	Если ПараметрыРаботыКлиента.Деньги_РежимРаботыПриложения = "КлиентОблака"
		Или ПараметрыРаботыКлиента.Деньги_РежимРаботыПриложения = "ЦентрМобильных" Тогда
		// проверка и включение автоматической синхронизации с облаком
		ПодключитьОбработчикОжидания("ПроверитьОбработчикОповещенияОбИзмененииСостояния", 5, Истина);
	КонецЕсли;
	
	ОбновитьКлиентскиеПараметрыПриложения();
	
КонецПроцедуры

