//Возвращает текст ссылки из ДанныхСобытия обработчиков события ПриНажатии HTML-документов элементов форм
// 
//Параметры:
//	ИмяЭлемента - Строка - имя элемента, в котором произошло событие
//	ДанныеСобытия - Произвольный - одноименный параметр из обработчика 
//	СтандартнаяОбработка - Булево - одноименный параметр из обработчика
//	
//Возвращаемое значение:
//	Строка, Неопределено - 
//
Функция ТекстСсылкиИзОбработчикаПриНажатии(ИмяЭлемента, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	Идентификатор        = Неопределено;
	ТипБатона            = ТипЗнч(ДанныеСобытия.Button);
	
	Если ДанныеСобытия.Href <> Неопределено Тогда
		
		СсылкаСтрокой = СокрЛП(ДанныеСобытия.Href);
//		Если ЭтоИнтернетСсылка(СсылкаСтрокой) Тогда
//			СтандартнаяОбработка = Истина;
//			Возврат Неопределено;
//		КонецЕсли;
		
		ПозицияРазделителя = СтрНайти(СсылкаСтрокой, "|", НаправлениеПоиска.СКонца);
		Если ПозицияРазделителя > 0 Тогда
			Идентификатор = Сред(СсылкаСтрокой, ПозицияРазделителя+1);
		КонецЕсли;
		
	ИначеЕсли ТипБатона = Тип("ВнешнийОбъект")
		Или ТипБатона = Тип("COMОбъект") Тогда
		Идентификатор = ДанныеСобытия.Button.id;
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции


