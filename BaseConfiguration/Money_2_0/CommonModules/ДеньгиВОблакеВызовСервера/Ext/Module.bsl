#Область ПрограммныйИнтерфейс

// Записывают ошибку в журнале регистрации
//
//Параметры:
//	Ошибка - ИнформацияОбОшибке
//	ОписаниеДействия - Строка - действие, которое привело к ошибке
//
Процедура ЗарегистрироватьОшибкуВЖурнале(Ошибка, ОписаниеДействия = "", Метаданные = Неопределено, Данные = Неопределено) Экспорт
	
	ТекстКомментария = ОписаниеДействия + ?(ЗначениеЗаполнено(ОписаниеДействия), ":" + Символы.ПС, "");
	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ТекстКомментария = ТекстКомментария + ПодробноеПредставлениеОшибки(Ошибка);
	Иначе
		ТекстКомментария = ТекстКомментария + Ошибка;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Облако Денег" + ?(ОписаниеДействия = "", "", "." + ОписаниеДействия), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные, Данные, ТекстКомментария);
	
КонецПроцедуры

// Проверяет, добступны ли этой базе облачные данные
//
//Параметры:
//	ПараметрыПодключения - Структура, см. ДеньгиВОблаке.ПараметрыСоединенияСОблаком();
//
//Возвращаемое значение:
//	Булево - Истина, если база подключена к облаку
//
Функция ЭтаБазаПодключенаКОблаку(ПараметрыПодключения = Неопределено) Экспорт

	Режим = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	Если Режим = "Разделенный" Или Режим = "Неразделенный" Тогда
		Возврат Истина;
	ИначеЕсли Режим <> "КлиентОблака" Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ДеньгиВОблаке.ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, "", Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не ПараметрыПодключения.Отключено И Не ПараметрыПодключения.ЗапрещеноНаСервере;

КонецФункции
 

#КонецОбласти


