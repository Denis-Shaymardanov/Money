#Область ПрограммныйИнтерфейс

Функция ОрганизацияПоУмолчанию() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(РегламентированныйОтчет.Организация, Организации.Ссылка) КАК Организация
	|ИЗ
	|	Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
	|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО РегламентированныйОтчет.Организация = Организации.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегламентированныйОтчет.Дата УБЫВ,
	|	Организации.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Организация;
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

Функция РеквизитыНалогоплательщикаНДФЛ(Организация, ДатаЗначения, СписокПоказателей) Экспорт
	
