Процедура ЗаполнитьРеквизитыБанковскогоСчета(Организация, Реквизиты, ПредсталвениеСчета = Неопределено)
	
	Реквизиты.Вставить("ПредсталвениеСчета", Неопределено);
	
	Если Не ЗначениеЗаполнено(Организация) Или Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСчета = Неопределено;
	Если ЗначениеЗаполнено(ПредсталвениеСчета) Тогда
		СтрокиСчета = Организация.БанковскиеРеквизиты.НайтиСтроки(Новый Структура("ПредсталвениеСчета", ПредсталвениеСчета));
		СтрокаСчета = ?(ЗначениеЗаполнено(СтрокиСчета), СтрокиСчета[0], Неопределено);
	КонецЕсли;
	Если СтрокаСчета = Неопределено И Организация.БанковскиеРеквизиты.Количество() > 0 Тогда
		СтрокаСчета = Организация.БанковскиеРеквизиты[0];
	КонецЕсли;
	
	Если СтрокаСчета <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Реквизиты, СтрокаСчета);
		Реквизиты.Депозитный = Нрег(СтрокаСчета.ВидСчета) = "депозитный"; 
	КонецЕсли;
	
КонецПроцедуры


