				ДополнительныеПараметры.ПараметрыПодключения);
	ПроверитьОтветСервера(СостояниеЭтойБазы, РезультатКоманды, ТекстДействия, ИмяПроцесса);
	ПроверитьСтатусСервераВОтветеНаЗапрос(РезультатКоманды.ОтветСервера.general, ТекстДействия, 
								СостояниеЭтойБазы, ИмяПроцесса);
	
	Возврат РезультатКоманды.ОтветСервера.Передача;
	
КонецФункции

Функция ОписаниеПакетаДляПолученияССервера(СостояниеЭтойБазы, ДополнительныеПараметры)
	
	ИмяПроцесса = "Прием";
	ТекстДействия = НСтр("ru='Информация о пакете к получению с сервера'");

	РезультатКоманды = ВыполнитьКомандуСинхронизацииНаСервере("infosendpack", Неопределено, 
				ДополнительныеПараметры.ПараметрыПодключения);
	ПроверитьОтветСервера(СостояниеЭтойБазы, РезультатКоманды, ТекстДействия, ИмяПроцесса);
	ПроверитьСтатусСервераВОтветеНаЗапрос(РезультатКоманды.ОтветСервера.general, ТекстДействия, 
								СостояниеЭтойБазы, ИмяПроцесса);
	
	Возврат РезультатКоманды.ОтветСервера.ПакетКОтправке;
	
КонецФункции

// Вызывает исключение в случае некорркетного ответа сервера
// Используется для проверки ответов на метод POST execute
//
Процедура ПроверитьОтветСервера(СостояниеОбмена, ОтветСервера, ОписаниеОперации, Процесс) Экспорт
	
	Если ОтветСервера.КодСостояния <> 200 Тогда
		
		ЗаписьЖурналаРегистрации("Обмен данными.Синхронизация автономных копий." + Процесс, 
				УровеньЖурналаРегистрации.Ошибка,
				, 
				, 
				СтрШаблон("Ошибка выполнения операции ""%1"":
				|http-запрос к серверу вернул результат с кодом %2
				|и описанием: %3
				|", ОписаниеОперации, ОтветСервера.КодСостояния, ОтветСервера.ОписаниеОшибки));
		
		Если СостояниеОбмена <> Неопределено Тогда
			ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, 
					ОтветСервера.КодСостояния, 
					ОтветСервера.ОписаниеОшибки);
		КонецЕсли;
		
		ВызватьИсключение СтрШаблон(НСтр("ru='Ошибка процесса синхронизации ""%1"":
			|http-запрос завершился с кодом состояния %2 
			|описание: %3'"), Процесс, ОтветСервера.КодСостояния, ОтветСервера.ОписаниеОшибки);
	
	КонецЕсли;
	
	ТипОтвета = ТипЗнч(ОтветСервера.ОтветСервера);
	Если ТипОтвета <> Тип("Структура") И ТипОтвета <> Тип("ФиксированнаяСтруктура") Тогда
	
		ЗаписьЖурналаРегистрации("Обмен данными.Синхронизация автономных копий." + Процесс, 
				УровеньЖурналаРегистрации.Ошибка,
				, 
				, 
				СтрШаблон("Ошибка выполнения операции ""%1"":
				|http-запрос к серверу вернул результат с типом %2 вместо структуры
				|", ОписаниеОперации, ТипОтвета));
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось выполнить операцию ""%1"":
			|http-запрос вернул ответ некорректного типа %2 
			|описание: '"), ОписаниеОперации, ТипОтвета);
		Если СостояниеОбмена <> Неопределено Тогда
			ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, 
					500, 
					ТекстСообщения);
		КонецЕсли;
		
		ВызватьИсключение ТекстСообщения;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтатусСервераВОтветеНаЗапрос(СтруктураGenehal, ВыполняемоеДействие, СостояниеОбмена = Неопределено, Процесс = "")
	
	Процесс = ?(ЗначениеЗаполнено(Процесс), Процесс, "Подготовка");
	ВсеКоды = ПроцессыОбменаПовтИсп.ВсеКодыСостоянияСервера();
	
	Если СтруктураGenehal.response <> ВсеКоды.Готов.Код Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='На сервере не удалось выполнить действие ""%1""
			|Причина: %2'"),
					ВыполняемоеДействие, СтруктураGenehal.message);
		ТекстОшибки = СтрШаблон(НСтр("ru='Статус сервера не позволил выполнить действие ""%1"":
		|Код состояния сервера: %2
		|Сообщение сервера: %3
		|Подробности:
		|%4'"),
				ВыполняемоеДействие,
				СтруктураGenehal.response, 
				СтруктураGenehal.message,
				СтруктураGenehal.errordescription);
		
		ЗаписьЖурналаРегистрации("Обмен данными.Синхронизация автономных копий." + Процесс, 
				УровеньЖурналаРегистрации.Ошибка,
				, 
				, 
				ТекстОшибки);
		Если СостояниеОбмена <> Неопределено Тогда
			ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, СтруктураGenehal.response, ТекстОшибки);
		КонецЕсли;
		
		ВызватьИсключение ТекстСообщения;
		
	ИначеЕсли СостояниеОбмена <> Неопределено 
		И СтруктураGenehal.response <> СостояниеОбмена.СтатусТранспорта.КодСостояния  Тогда
		// обновление состояния сервера для информирования пользователя
		
		ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, 
				СтруктураGenehal.response, 
				СтруктураGenehal.message);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыОбменаДляОтправкиВСервис(ПараметрыОбмена = Неопределено) 
	
	ИмяПланаОбмена = "СинхронизацияАвтономныхКопий";
	ЭтотУзел = СинхронизацияАвтономныхКопийВызовСервера.ЭтотУзел(ИмяПланаОбмена);
	УзелЦБ   = СинхронизацияАвтономныхКопийВызовСервера.УзелЦентральнойБазы(ИмяПланаОбмена);
	Если ПараметрыОбмена = Неопределено Тогда
		ПараметрыОбмена = СинхронизацияАвтономныхКопий.ПараметрыОбменаСУзлом(УзелЦБ, Истина);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияФорматаОбмена", СинхронизацияАвтономныхКопийКлиентСервер.ТекущаяВерсияФормата()); 
	Результат.Вставить("МобильноеУстройство", Ложь); 
	Результат.Вставить("ПользовательБазы", ПараметрыОбмена.ПользовательБазы); 
	Результат.Вставить("Наименование", СокрЛП(ЭтотУзел)); 
	Результат.Вставить("ВидПериода", Неопределено); 
	Результат.Вставить("КоличествоПериодов", 0); 
	
	Сценарий = ПараметрыОбмена.ЗатребованныйСценарий;
	Если Сценарий = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВАвтономнойКопии Тогда
		Результат.Вставить("ЗатребованныйСценарий", "ЗаменитьВсеВАвтономнойКопии"); 
		Результат.Вставить("СценарийПереданныхДанных", "ОбъединениеДанных"); 
		Результат.Вставить("СценарийЗапрашиваемыхДанных", "ЗаменитьВсеВАвтономнойКопии"); 
		
	ИначеЕсли Сценарий = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВЦентральнойБазе Тогда
		Результат.Вставить("ЗатребованныйСценарий", "ЗаменитьВсеВЦентральнойБазе"); 
		Результат.Вставить("СценарийПереданныхДанных", "ЗаменитьВсеВЦентральнойБазе"); 
		Результат.Вставить("СценарийЗапрашиваемыхДанных", "ОбъединениеДанных"); 
		
	Иначе
		Результат.Вставить("ЗатребованныйСценарий", "ОбъединениеДанных"); 
		Результат.Вставить("СценарийПереданныхДанных", "ОбъединениеДанных"); 
		Результат.Вставить("СценарийЗапрашиваемыхДанных", "ОбъединениеДанных"); 
		
	КонецЕсли;
	
	Результат.Вставить("НомерПринятого",     ПараметрыОбмена.НомерПринятого);
	Результат.Вставить("НомерОтправленного", ПараметрыОбмена.НомерОтправленного);
	Результат.Вставить("НомерДляУстановленногоСценария", ПараметрыОбмена.НомерДляУстановленногоСценария);
	
	Возврат Результат;
	
КонецФункции 

Функция СтруктураСостоянияДляОтправкиВСервис(СостояниеОбмена)
	
	Если СостояниеОбмена = Неопределено Тогда
		СостояниеОбмена = СостояниеОбмена();
	КонецЕсли;
	
	Результат = Новый Структура("НомерПринятого,НомерОтправленного,ПроцессАктивен,СценарийОбмена");
	ЗаполнитьЗначенияСвойств(Результат, СостояниеОбмена);
	
	Если ЗначениеЗаполнено(СостояниеОбмена.СценарийОбмена) Тогда
		Результат.СценарийОбмена = ОбщегоНазначения.ИмяЗначенияПеречисления(СостояниеОбмена.СценарийОбмена);
	Иначе
		Результат.СценарийОбмена = "ЗаменитьВсеВАвтономнойКопии";
	КонецЕсли;
	Результат.Вставить("НомерДляУстановленногоСценария", СостояниеОбмена.НомерДляУстановленногоСценария);
			
	Результат.Вставить("Прием", ОбщегоНазначения.СкопироватьРекурсивно(СостояниеОбмена.Прием));
	Результат.Прием.ДействиеПроцесса = ?(ЗначениеЗаполнено(Результат.Прием.ДействиеПроцесса),
				ОбщегоНазначения.ИмяЗначенияПеречисления(Результат.Прием.ДействиеПроцесса), "");
	
	Результат.Вставить("Передача", ОбщегоНазначения.СкопироватьРекурсивно(СостояниеОбмена.Передача));
	Результат.Передача.ДействиеПроцесса = ?(ЗначениеЗаполнено(Результат.Передача.ДействиеПроцесса),
				ОбщегоНазначения.ИмяЗначенияПеречисления(Результат.Передача.ДействиеПроцесса), "");
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти


#Область Процесс_Передача

Функция ДопускаетсяПерезапускПроцессаПередача(СостояниеОбмена, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.СпособЗапуска = "Интерактивно" Тогда
		// Состояние не изменяем, процесс заново не начинаем
		Возврат Ложь;
	КонецЕсли;
	
	// Все последующие проверки выполняются только для автоматического режима синхронизации, когда 
	//процессы Прием и Передача могут выполняться параллельно 
	
	// Проверка сценария
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
	Если СостояниеОбмена.СценарийОбмена = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВАвтономнойКопии
		И ЗначениеЗаполнено(СостояниеОбмена.Прием.ДействиеПроцесса) И Не СостояниеОбмена.Прием.ПроцессЗавершен Тогда
		// невозможно начинать новую передачу, пока не будет завершен прием по сценарию "Заменить все в автономной копии"
		Возврат Ложь;
	КонецЕсли;
	
	Если СостояниеОбмена.СценарийОбмена = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВЦентральнойБазе
		И СостояниеОбмена.Передача.КодРезультатаДействия <> ВсеКодыРезультатов.Выполнено.Код Тогда
		// Передача по сценарию "заменить все на сервере" не была успешно завершена
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

// Проверяет состояние процесса "Передача" и, при необходимости, выполняет следующее действие или 
//изменяет результат выполняемого дейсвтия
Процедура ОбработкаПроцессаПередачи(СостояниеОбмена, ДополнительныеПараметры)
	
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
	Если СостояниеОбмена.Передача.ПроцессЗавершен Тогда
		Если Не ДопускаетсяПерезапускПроцессаПередача(СостояниеОбмена, ДополнительныеПараметры) Тогда
			Возврат;
		Иначе
			СброситьСостояние(СостояниеОбмена, "Передача", ДополнительныеПараметры.ПараметрыПодключения);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СостояниеОбмена.Передача.ДействиеПроцесса)
		Или СостояниеОбмена.Передача.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Выгрузка
			И Не ЗначениеЗаполнено(СостояниеОбмена.Передача.КодРезультатаДействия) Тогда
		// выгрузка не выполнялась или не была завершена
		
		ВыгрузитьИзмененияВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры);
		
	ИначеЕсли СостояниеОбмена.Передача.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Выгрузка Тогда
		
		Если СостояниеОбмена.Передача.КодРезультатаДействия <> ВсеКодыРезультатов.Выполнено.Код Тогда
			// повторить выгрузку
			ВыгрузитьИзмененияВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры);
		Иначе
			// отправить выгруженное на сервере
			ОтправитьПакетНаСервер(СостояниеОбмена, ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли СостояниеОбмена.Передача.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Отправка Тогда
		
		Если СостояниеОбмена.Передача.КодРезультатаДействия <> ВсеКодыРезультатов.Выполнено.Код Тогда
			// передача пакета не начиналась или не завершилась
			// отправка (продолжение отправки) пакета по частям 
			ОтправитьПакетНаСервер(СостояниеОбмена, ДополнительныеПараметры);
			
		Иначе
			// пакет передан на сервер, начать его загрузку
			ОчиститьВыгруженныйПакет(СостояниеОбмена, ДополнительныеПараметры);
			ЗагрузитьДанныеНаСервере(СостояниеОбмена, ДополнительныеПараметры);
		
		КонецЕсли;
		
	ИначеЕсли СостояниеОбмена.Передача.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Загрузка Тогда
		// проверка состояния загрузки на сервере делается в ПродолжитьПроцесс() после
		//получения состояния сервера. Здесь только проверяем запуск процесса на севрере 
		
		Если Не ЗначениеЗаполнено(ДополнительныеПараметры.СостояниеСервера)
			Или Не ДополнительныеПараметры.СостояниеСервера.Свойство("Прием")
			Или ДополнительныеПараметры.СостояниеСервера.Прием.ДействиеПроцесса <> "Загрузка"
			Или Не ДополнительныеПараметры.СостояниеСервера.Прием.ПроцессЗавершен Тогда
				// нет информации о загрузке пакета на сервере
			ЗагрузитьДанныеНаСервере(СостояниеОбмена, ДополнительныеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьИзмененияВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры)
	
	ВсеКоды = ДополнительныеПараметры.ВсеКодыРезультатов;
	Если СостояниеОбмена.СценарийОбмена = Перечисления.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных
		И Не ОбменДаннымиСлужебный.ИзмененияЗарегистрированы(СостояниеОбмена.УзелКорреспондента) Тогда
			
		ОтметитьЗавершениеДействия(СостояниеОбмена, "Передача", "Загрузка", 
				ВсеКоды.ОтсутствуютДанныеДляВыгрузки.Код, "");
		ОбновитьСостояниеКлиентаНаСервере(СостояниеОбмена, ДополнительныеПараметры, "Прием");
		Возврат;
		
	КонецЕсли;
	
	НомерПакетаКОтправке = СостояниеОбмена.НомерОтправленного + 1;
	ОтметитьНачалоДействия(СостояниеОбмена, "Передача", "Выгрузка", НомерПакетаКОтправке, 0, 0, 0, 0);
	ОбновитьСостояниеКлиентаНаСервере(СостояниеОбмена, ДополнительныеПараметры, "Прием");
	
	ПроцессыОбменаСлужебный.ВыгрузитьИзмененияВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры);
	
	ОбновитьСостояниеКлиентаНаСервере(СостояниеОбмена, ДополнительныеПараметры, "Прием");
	
КонецПроцедуры

Процедура ОтправитьПакетНаСервер(СостояниеОбмена, ДополнительныеПараметры)
	
	Узел               = СостояниеОбмена.УзелКорреспондента;
	НомерПакета        = СостояниеОбмена.Передача.НомерПакета;
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
	
	// Проверка выгруженных изменений
	СписокПакетов = РегистрыСведений.ПакетыСинхронизацииКОтправке.ОчередьПакетовДляУзла(Узел, НомерПакета);
	Если Не ЗначениеЗаполнено(СписокПакетов) Тогда
		// Отправлять нечего
		ОтметитьЗавершениеДействия(СостояниеОбмена, "Передача", "Отправка", ВсеКодыРезультатов.Выполнено.Код, "Отсутствуют данные для отправки");
		Возврат;
	КонецЕсли;
	
	ОтметитьНачалоДействия(СостояниеОбмена, "Передача", "Отправка", Неопределено, СписокПакетов.Количество(), 0);
	
	Ключ = РегистрыСведений.КонтрольПроцессовОбменаДанными.СоздатьКлючЗаписи(
				Новый Структура("Узел, Процесс", СостояниеОбмена.УзелКорреспондента, Перечисления.ПроцессыОбменаДанными.Передача));
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Ключ);
	Исключение
		ОтметитьЗавершениеДействия(СостояниеОбмена, "Передача", "Отправка", 
				ВсеКодыРезультатов.ОшибкаБлокировкиКонтрольнойЗаписи.Код, 
				ИнформацияОбОшибке());
		ТекстПредупреждения = СтрШаблон(НСтр("ru='Не удалось заблокировать запись узла ""%1"" для отправки пакета на сервер'"), 
					СостояниеОбмена.УзелКорреспондента);
		ВызватьИсключение ТекстПредупреждения;
	КонецПопытки;

	// Отправить все части по одной
	ОбработаноЧастей = 0;
	Для каждого СтрокаСписка Из СписокПакетов Цикл
		
		Если СтрокаСписка.Отправлено Тогда
			ОбработаноЧастей = ОбработаноЧастей + 1;
			ОбновитьСтатистикуДействия(СостояниеОбмена, "Передача", Неопределено, 
					Неопределено, ОбработаноЧастей);
			Продолжить;
		КонецЕсли;
		
		РезультатОтправки = ПередатьЧастьПакета(ДополнительныеПараметры.ПараметрыПодключения, СтрокаСписка);
		Если РезультатОтправки.КодСостояния = 200 Или РезультатОтправки.КодСостояния = 201 Тогда
			
			СтрокаСписка.Отправлено = Истина;
			Запись = РегистрыСведений.ПакетыСинхронизацииКОтправке.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаСписка, "УзелКорреспондента,НомерПакетаКОтправке,НомерЧастиПакета");
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Отправлено = Истина;
				Запись.Записать(Истина);
			КонецЕсли;
			ОбработаноЧастей = ОбработаноЧастей + 1;
			ОбновитьСтатистикуДействия(СостояниеОбмена, "Передача", Неопределено, 
					Неопределено, ОбработаноЧастей);
			
		Иначе
			
			ОбработатьОшибкуСервераПоОтправке(СостояниеОбмена, РезультатОтправки, ДополнительныеПараметры);
			РазблокироватьДанныеДляРедактирования(Ключ);
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОтметитьЗавершениеДействия(СостояниеОбмена, "Передача", "Отправка", ВсеКодыРезультатов.Выполнено.Код, "");
	РазблокироватьДанныеДляРедактирования(Ключ);
	
КонецПроцедуры

// Отправляет на сервер данные, сохраненные в РС ПакетыСинхронизацииКОтправке
//
//Параметры:
//	ПараметрыПодключения - Структура или непоределено
//	ПараметрыПакета - Структура или строка таблицы значений с описанием ключей записи регистра сведений
//
//Возвращаемое значение:
//	Структура:
//		* ПакетОтправлен - Булево
//		* КодСостояния - 200 в случае успеха или другой код в случае ошибки
//		* ОписаниеОшибки - Строка - имеет смысл только если КодСостояния <> 200
//
Функция ПередатьЧастьПакета(ПараметрыПодключения, ПараметрыПакета)
	
	Результат = Новый Структура;
	Результат.Вставить("ПакетОтправлен", Истина); 
	Результат.Вставить("КодСостояния",   201); 
	Результат.Вставить("ОписаниеОшибки", ""); 
	
	Запись = РегистрыСведений.ПакетыСинхронизацииКОтправке.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, ПараметрыПакета, "УзелКорреспондента,НомерПакетаКОтправке,НомерЧастиПакета");
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		ВызватьИсключение НСтр("ru='Ошибка отправки пакета на сервер'") + Символы.ПС + Символы.ПС
				+ Символы.Таб + "Узел = " + ПараметрыПакета.УзелКорреспондента + Символы.ПС
				+ Символы.Таб + "Номер пакета = " + ПараметрыПакета.НомерПакетаКОтправке + Символы.ПС
				+ Символы.Таб + "Номер части = " + ПараметрыПакета.НомерЧастиПакета;
	КонецЕсли;
	
	СтрокаПараметров = СтрШаблон("sentno=%1&partno=%2&total=%3&type=%4&date=%5", 
			Формат(ПараметрыПакета.НомерПакетаКОтправке, "ЧДЦ=0; ЧГ="),
			Формат(ПараметрыПакета.НомерЧастиПакета, "ЧДЦ=0; ЧГ="),
			Формат(ПараметрыПакета.ВсегоЧастей, "ЧДЦ=0; ЧГ="),
			ОбщегоНазначения.ИмяЗначенияПеречисления(ПараметрыПакета.ТипПакета),
			Формат(ПараметрыПакета.ДатаВыгрузки, "ЧДЦ=0; ЧГ=; ДФ=ггггММддЧЧммсс")
			);
	
	ДеньгиВОблаке.ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураЗапроса = ДеньгиВОблаке.НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, 
							ДеньгиВОблаке.АдресСервисаСинхронизации(), 
							"upload/" + ПараметрыПодключения.КодЭтогоУзла + "?" + СтрокаПараметров);
	Ответ = RESTВызовСервера.РезультатHTTPЗапроса("PUT", СтруктураЗапроса, , 
					СинхронизацияАвтономныхКопий.КлючДляЖурналаРегистрации("ВыгрузкаДанных"), 
					"201", Запись.ДанныеПакета.Получить());
	
	Результат.КодСостояния = Ответ.КодСостояния;
	Результат.ПакетОтправлен = Результат.КодСостояния = 201;
	Результат.ОписаниеОшибки = Ответ.ОписаниеОшибки;
	
	Возврат Результат;
	
КонецФункции 

Процедура ОбработатьОшибкуСервераПоОтправке(СостояниеОбмена, ОтветСервера, ДополнительныеПараметры)
	
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
	Результат = Неопределено;
	Если ОтветСервера.КодСостояния = 402 Тогда
		Результат = ВсеКодыРезультатов.НетЛицензий;
	ИначеЕсли ОтветСервера.КодСостояния = 408 Или ОтветСервера.КодСостояния = 504 Тогда
		Результат = ВсеКодыРезультатов.ИстеклоВремяОжидания;
	ИначеЕсли ОтветСервера.КодСостояния = 403 Тогда
		Результат = ВсеКодыРезультатов.ОбменЗапрещен;
	ИначеЕсли ОтветСервера.КодСостояния = 503 Тогда
		Результат = ВсеКодыРезультатов.СерверНедоступен;
	Иначе 
		Результат = ВсеКодыРезультатов.ОшибкаНаСервере
	КонецЕсли;
	
	ОтметитьЗавершениеДействия(СостояниеОбмена, "Передача", "Отправка", Результат.Код, 
			?(ЗначениеЗаполнено(ОтветСервера.ОписаниеОшибки), ОтветСервера.ОписаниеОшибки, "Неизвестная ошибка"));
	
КонецПроцедуры

Процедура ОчиститьВыгруженныйПакет(СостояниеОбмена, ДополнительныеПараметры)
	
	РегистрыСведений.ПакетыСинхронизацииКОтправке.УдалитьПакеты(СостояниеОбмена.УзелКорреспондента, 
				СостояниеОбмена.Передача.НомерПакета);
	ОбновитьСтатистикуДействия(СостояниеОбмена, "Передача", Неопределено, 0, 0);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеНаСервере(СостояниеОбмена, ДополнительныеПараметры)
	
	ИмяПроцесса  = "Передача";
	Если Не ДополнительныеПараметры.Свойство("ПараметрыПодключения") Тогда
		ДополнительныеПараметры.Вставить("ПараметрыПодключения", Неопределено);
	КонецЕсли;
	
	ПараметрыКонанды = Новый Структура("НомерПакета", СостояниеОбмена.Передача.НомерПакета);
	
	РезультатКоманды = ВыполнитьКомандуСинхронизацииНаСервере("readingpackage", 
						ПараметрыКонанды, 
						ДополнительныеПараметры.ПараметрыПодключения);
	ПроверитьОтветСервера(СостояниеОбмена, РезультатКоманды, НСтр("ru='Запуск загрузки данных на сервере'"), ИмяПроцесса);
	
	ВсеКодыСостояний = ДополнительныеПараметры.ВсеКодыСостояний;
	ОбщийОбъектОтвета = РезультатКоманды.ОтветСервера.general;
	Если ОбщийОбъектОтвета.response <> ВсеКодыСостояний.Готов.Код Тогда
		// на сервере возникли проблемы
		ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, ОбщийОбъектОтвета.response, 
				ОбщийОбъектОтвета.message + Символы.ПС + ОбщийОбъектОтвета.errordescription);
		Возврат;
	КонецЕсли;
	
	Если РезультатКоманды.ОтветСервера.Свойство("Прием") Тогда
		
		ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
		
		// обновляем СостояниеОбмена обмена значениями, полученными с сервера
		ЗаполнитьСостояниеПроцессаДаннымиССервера(СостояниеОбмена.Передача, 
				РезультатКоманды.ОтветСервера.Прием, ,"Количество,НомерОбработанного,ОбъектовВсего");
		// Завершение процесса приема на сервере является завершением процесса передачи на клиенте
		Если СостояниеОбмена.Передача.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Загрузка
				И СостояниеОбмена.Передача.КодРезультатаДействия = ВсеКодыРезультатов.Выполнено.Код
			Или ЗначениеЗаполнено(СостояниеОбмена.Передача.КодРезультатаДействия) 
				И СостояниеОбмена.Передача.КодРезультатаДействия <> ВсеКодыРезультатов.Выполнено.Код Тогда
			
			СостояниеОбмена.Передача.ПроцессЗавершен    = Истина;
			СостояниеОбмена.Передача.ЗавершениеДействия = ТекущаяДата();
			
		КонецЕсли;
		ПроцессыОбменаСлужебный.ЗаписатьСостояниеВРегистр(СостояниеОбмена, ИмяПроцесса);
		
		ПроверитьЗавершениеПроцессаПередачи(СостояниеОбмена, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти


#Область Процесс_Прием

Функция СценарийТребуетЗавершенияПередачи(СостояниеОбмена)
	
	ПараметрыОбмена = СинхронизацияАвтономныхКопий.ПараметрыОбменаСУзлом(СостояниеОбмена.УзелКорреспондента);
	Возврат ПараметрыОбмена.ЗатребованныйСценарий <> Перечисления.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных
	
КонецФункции

// Проверяет состояние процесса "Прием" и, при необходимости, выполняет следующее действие или 
//изменяет результат выполняемого дейсвтия
Процедура ОбработкаПроцессаПриема(СостояниеОбмена, ДополнительныеПараметры)
	
	ИмяПроцесса        = "Прием";
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
	
	Если СостояниеОбмена.Прием.ПроцессЗавершен Тогда
		Если СостояниеОбмена.Прием.КодРезультатаДействия = ВсеКодыРезультатов.ПриемОжидаетЗавершенияПередачи.Код Тогда
			СброситьСостояние(СостояниеОбмена, ИмяПроцесса, ДополнительныеПараметры.ПараметрыПодключения);
		Иначе
			Возврат
		КонецЕсли;
	КонецЕсли;
	
	// проверить, что сценарий позволяет выполнить Прием параллельно Передаче
	Если СценарийТребуетЗавершенияПередачи(СостояниеОбмена) 
			И Не ПроцессЗавершенУспешно(СостояниеОбмена, "Передача", ДополнительныеПараметры) Тогда
		ПроцессыОбменаСлужебный.ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, "Выгрузка", 
					ВсеКодыРезультатов.ПриемОжидаетЗавершенияПередачи.Код, "");
		Возврат;
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(СостояниеОбмена.Прием.ДействиеПроцесса)
			Или СостояниеОбмена.Прием.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Выгрузка 
				И Не ЗначениеЗаполнено(СостояниеОбмена.Прием.КодРезультатаДействия) Тогда
		// выгрузка данных не выполнялась или была прервана
		ВыгрузитьИзмененияНаСервере(СостояниеОбмена, ДополнительныеПараметры);
			
	ИначеЕсли СостояниеОбмена.Прием.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Выгрузка Тогда
		
		Если СостояниеОбмена.Прием.КодРезультатаДействия = ВсеКодыРезультатов.Выполнено.Код Тогда
			// данные выгружены. Начать/продолжить получение пакета с сервера
			ПолучитьПакетССервера(СостояниеОбмена, ДополнительныеПараметры);
			
		Иначе
			//проверить или перезапустить выгрузку на сервере
			ВыгрузитьИзмененияНаСервере(СостояниеОбмена, ДополнительныеПараметры);
			
		КонецЕсли;
		
	ИначеЕсли СостояниеОбмена.Прием.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Получение Тогда
		
		Если СостояниеОбмена.Прием.КодРезультатаДействия = ВсеКодыРезультатов.Выполнено.Код Тогда
			// пакет с сервера получен, начать его загрузку
			ЗагрузитьПакетВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры);
			
		Иначе
			// Проверить/продолжить получение пакета с сервера
			ПолучитьПакетССервера(СостояниеОбмена, ДополнительныеПараметры);
			
		КонецЕсли;
		
	ИначеЕсли СостояниеОбмена.Прием.ДействиеПроцесса = Перечисления.ДействияПроцессовОбмена.Загрузка Тогда
		
		Если СостояниеОбмена.Прием.КодРезультатаДействия = ВсеКодыРезультатов.Выполнено.Код Тогда
			// пакет с сервера загружен, но не записан результат
			ПроцессыОбменаСлужебный.ОтметитьЗавершениеДействия(СостояниеОбмена, "Прием", "Загрузка", ВсеКодыРезультатов.Выполнено.Код, "");
			ОтметитьНаСервереЗавершениеПередачи(СостояниеОбмена, ДополнительныеПараметры, ВсеКодыРезультатов.Выполнено.Код);
			
		Иначе
			// предыдущая загрузка была прервана
			ЗагрузитьПакетВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьИзмененияНаСервере(СостояниеОбмена, ДополнительныеПараметры)
	
	ИмяПроцесса = "Прием";
	ИмяДействия = "Выгрузка";
	
	Если СостояниеОбмена.Прием.ПроцессЗавершен 
		Или СостояниеОбмена.Прием.ДействиеПроцесса <> Перечисления.ДействияПроцессовОбмена.Выгрузка Тогда
		ОтметитьНачалоДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, 0, 0, 0, 0, 0);
	КонецЕсли;
	
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;
	Результат = РезультатКомандыВыгрузкиНаСервере(СостояниеОбмена, ДополнительныеПараметры);
	Если Результат = Неопределено Тогда
		// Проблемеы с доступом к серверу
		ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, 
			ВсеКодыРезультатов.СерверНедоступен.Код, "");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСостояниеПроцессаДаннымиССервера(СостояниеОбмена.Прием, Результат);
	Если ЗначениеЗаполнено(Результат.КодРезультатаДействия) Тогда
		// на сервере процесс завершился
		
		ПроцессыОбменаСлужебный.ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, 
					СостояниеОбмена.Прием.ДействиеПроцесса, 
					СостояниеОбмена.Прием.КодРезультатаДействия, 
					СостояниеОбмена.Прием.ТекстОшибки);
	Иначе
		ПроцессыОбменаСлужебный.ЗаписатьСостояниеВРегистр(СостояниеОбмена, ИмяПроцесса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьПакетССервера(СостояниеОбмена, ДополнительныеПараметры)
	
	ИмяПроцесса = "Прием";
	ИмяДействия = "Получение";
	
	Если СостояниеОбмена.Прием.ПроцессЗавершен 
		Или СостояниеОбмена.Прием.ДействиеПроцесса <> Перечисления.ДействияПроцессовОбмена.Получение Тогда
		ОтметитьНачалоДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, , 0, 0, 0, 0);
	КонецЕсли;
	
	ВсеКодыРезультатов = ДополнительныеПараметры.ВсеКодыРезультатов;

	// блокировка ключевой записи процесса
	Ключ = РегистрыСведений.КонтрольПроцессовОбменаДанными.СоздатьКлючЗаписи(
				Новый Структура("Узел, Процесс", СостояниеОбмена.УзелКорреспондента, Перечисления.ПроцессыОбменаДанными.Передача));
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Ключ);
	Исключение
		ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, 
				ВсеКодыРезультатов.ОшибкаБлокировкиКонтрольнойЗаписи.Код, 
				ИнформацияОбОшибке());
		ТекстПредупреждения = СтрШаблон(НСтр("ru='Не удалось заблокировать запись узла ""%1"" для получения данных с сервера'"), 
					СостояниеОбмена.УзелКорреспондента);
		ВызватьИсключение ТекстПредупреждения;
	КонецПопытки;

	ПакетКПолучению = ОписаниеПакетаДляПолученияССервера(СостояниеОбмена, ДополнительныеПараметры);
	Если ПакетКПолучению = Неопределено Тогда
		// Проблемеы с доступом к серверу
		ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, ВсеКодыРезультатов.СерверНедоступен.Код, "");
		РазблокироватьДанныеДляРедактирования(Ключ);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПакетКПолучению.НомерПакета)
		Или Не ЗначениеЗаполнено(ПакетКПолучению.ВсегоЧастей) Тогда
		ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, "Загрузка", ВсеКодыРезультатов.ОтсутствуютДанныеДляЗагрузки.Код, "");
		РазблокироватьДанныеДляРедактирования(Ключ);
		Возврат;
	КонецЕсли;
	
	// Удаление более старых пакетов
	Если ПакетКПолучению.НомерПакета > 1 Тогда
		РегистрыСведений.ПакетыСинхронизацииПолученные.УдалитьПакеты(СостояниеОбмена.УзелКорреспондента, ПакетКПолучению.НомерПакета - 1);
	КонецЕсли;
	
	ПолученныеПакеты = РегистрыСведений.ПакетыСинхронизацииПолученные.ИнформацияОПолученныхПакетах(СостояниеОбмена.УзелКорреспондента, 
									ПакетКПолучению.НомерПакета);
	// Проверка полученных пакетов
	Если ПолученныеПакеты.КоличествоВсего <> 0 И ПолученныеПакеты.КоличествоВсего <> ПакетКПолучению.ВсегоЧастей Тогда
		// удаляем все ранее полученные пакеты
		РегистрыСведений.ПакетыСинхронизацииПолученные.УдалитьПакеты(СостояниеОбмена.УзелКорреспондента, ПакетКПолучению.НомерПакета);
		ПолученныеПакеты.ПолученныеЧасти.Очистить();
	КонецЕсли;
	
	// для исключения повторного получения уже полученных пакетов
	КонтрольПолученных = Новый Соответствие;
	Для Каждого Элемент Из ПолученныеПакеты.ПолученныеЧасти Цикл
		КонтрольПолученных.Вставить(Элемент.НомерЧастиПакета, Истина);
	КонецЦикла;
	
	ОписаниеЧасти = Новый Структура("ТипПакета,НомерПакетаКОтправке,ВсегоЧастей,ДатаВыгрузки,НомерЧастиПакета", 
				ПакетКПолучению.ТипПакета, ПакетКПолучению.НомерПакета, ПакетКПолучению.ВсегоЧастей,
				Дата(ПакетКПолучению.ДатаВыгрузки), 0);
	Для Счетчик = 1 По ПакетКПолучению.ВсегоЧастей Цикл
		
		Если КонтрольПолученных[Счетчик] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеЧасти.НомерЧастиПакета = Счетчик;
		
		Для Повторов = 1 По 3 Цикл
			
			ОтветСервера = ПолучитьЧастьПакета(ДополнительныеПараметры.ПараметрыПодключения, 
								СостояниеОбмена.УзелКорреспондента, ОписаниеЧасти);
			Если ОтветСервера.КодСостояния = 200 Тогда
				КонтрольПолученных.Вставить(Счетчик, Истина);
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОтветСервера.КодСостояния <> 200 Тогда
			ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, 
					ВсеКодыРезультатов.ОшибкаНаСервере.Код, ОтветСервера.ОписаниеОшибки);
			РазблокироватьДанныеДляРедактирования(Ключ);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Если КонтрольПолученных.Количество() = ПакетКПолучению.ВсегоЧастей Тогда
		ОтметитьЗавершениеДействия(СостояниеОбмена, ИмяПроцесса, ИмяДействия, 
				ВсеКодыРезультатов.Выполнено.Код, "");
	КонецЕсли;
	
	РазблокироватьДанныеДляРедактирования(Ключ);
	
КонецПроцедуры

// Получает с сервера часть пакета с указанными в описании свойсвами
//
//Параметры:
//	ПараметрыПодключения - Структура или непоределено
//	ОписаниеЧасти - Структура - должна содержать реквизиты, аналогичные измерениям и ресурсам в РС ПакетыСинхронизацииКОтправке
//
//Возвращаемое значение:
//		* ЧастьПолучена - булево - истина, если указанная часть получена и сохранена в базе
//		* КодСостояния - 200 в случае успеха или другой код в случае ошибки
//		* ОписаниеОшибки - Строка - имеет смысл только если КодСостояния <> 200
//
Функция ПолучитьЧастьПакета(ПараметрыПодключения, Узел, ОписаниеЧасти) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЧастьПолучена", Истина); 
	Результат.Вставить("КодСостояния",   200); 
	Результат.Вставить("ОписаниеОшибки", ""); 
	
	СтрокаПараметров = СтрШаблон("receivedno=%1&partno=%2", 
			Формат(ОписаниеЧасти.НомерПакетаКОтправке, "ЧДЦ=0; ЧГ="), 
			Формат(ОписаниеЧасти.НомерЧастиПакета, "ЧДЦ=0; ЧГ="));
	ДеньгиВОблаке.ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураЗапроса = ДеньгиВОблаке.НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, 
							ДеньгиВОблаке.АдресСервисаСинхронизации(), 
							"download/" + ПараметрыПодключения.КодЭтогоУзла + "?" + СтрокаПараметров);
	Ответ = RESTВызовСервера.РезультатHTTPЗапроса("GET", СтруктураЗапроса, , 
					"Обмен данными." + Перечисления.ДействияПриОбмене.ЗагрузкаДанных, "200", , );
	
	
	Если Ответ.КодСостояния = 200 Тогда
		
		Если ТипЗнч(Ответ.ЗначениеОтвета) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение "Ответ севрера не содержит двоинчые данные для записи в регистр сведений ПакетыСинхронизацииПолученные";
		КонецЕсли;
		
		Запись = РегистрыСведений.ПакетыСинхронизацииПолученные.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ОписаниеЧасти);
		Если ЗначениеЗаполнено(ОписаниеЧасти.ТипПакета) Тогда
			Запись.ТипПакета = ?(ТипЗнч(ОписаниеЧасти.ТипПакета) = Тип("Строка"), 
							Перечисления.ТипыПакетовСинхронизации[ОписаниеЧасти.ТипПакета], 
							ОписаниеЧасти.ТипПакета);
		КонецЕсли;
		Запись.УзелКорреспондента = Узел;
		Запись.НомерПакетаКПолучению = ОписаниеЧасти.НомерПакетаКОтправке;
		Запись.ДанныеПакета = Новый ХранилищеЗначения(Ответ.ЗначениеОтвета, Новый СжатиеДанных(9));
		Запись.Записать(Истина);
		
		// Отмека на сервере о получении пакета
		СтруктураЗапроса = ДеньгиВОблаке.НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, 
								ДеньгиВОблаке.АдресСервисаСинхронизации(), 
								"markdownload/" + ПараметрыПодключения.КодЭтогоУзла + "?" + СтрокаПараметров);
		ОтветПодтверждения = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, , 
						"Обмен данными." + Перечисления.ДействияПриОбмене.ЗагрузкаДанных, "200");
		
		Если ОтветПодтверждения.КодСостояния <> 200 Тогда
			Результат.ЧастьПолучена   = Истина;
			Результат.КодСостояния    = ОтветПодтверждения.КодСостояния;
			Результат.ОписаниеОшибки  = НСтр("ru='Ошибка подтверждения получения пакета на сервере:'") 
					+ Символы.ПС + ОтветПодтверждения.ОписаниеОшибки;
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.ЧастьПолучена   = Ответ.КодСостояния = 200;
	Результат.КодСостояния    = Ответ.КодСостояния;
	Результат.ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	
	Возврат Результат;
	
КонецФункции 

Процедура ЗагрузитьПакетВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры)
	
	ПроцессыОбменаСлужебный.ОтметитьНачалоДействия(СостояниеОбмена, "Прием", "Загрузка", 
				СостояниеОбмена.Прием.НомерПакета, 0, 0, 0, 0);
	ОбновитьСостояниеКлиентаНаСервере(СостояниеОбмена, ДополнительныеПараметры, "Передача");
	
	ПроцессыОбменаСлужебный.ЗагрузитьПакетВЭтойБазе(СостояниеОбмена, ДополнительныеПараметры, СостояниеОбмена.Прием.НомерПакета);
	
	Если СостояниеОбмена.Прием.ПроцессЗавершен Тогда
		
		ЗначенияНомеров = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СостояниеОбмена.УзелКорреспондента, 
				"НомерПринятого,НомерОтправленного");
		ЗаполнитьЗначенияСвойств(СостояниеОбмена, ЗначенияНомеров);
		
		ОтметитьНаСервереЗавершениеПередачи(СостояниеОбмена, ДополнительныеПараметры, 
				ДополнительныеПараметры.ВсеКодыРезультатов.Выполнено.Код);
	КонецЕсли;
	
КонецПроцедуры



