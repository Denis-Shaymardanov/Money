// Отправляет в МС запрос на платежную ссылку. Возвращает идентификатор для отслеживания результата
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	КодТарифа - Строка - код тарифа, как он задан в менеджете сервиса
//	ВариантПодписки - Число - идентификатор выбранной пользователем длительности подписки (см. массив "ВариантыПодписок" в сведниях о тарифах)
//	НачалоДействия - Дата - с которой (включительно) должна начаться подписка. Запрещено использовать прошедшие периоды
//	ОкончаниеДействия - Дата - по которую (включительно) должна действовать подписка. Рассчитывается с учетом остатка неиспользованных подписок
//	КоличествоЛицензий - Число - сколько подписок нужно сделать с заданными условиями
//
//Возвращаемое значение:
//	Структура:
//		* КодСостояния - Число - 200, если заказ выполнен успешно и др. коды в случае проблем
//		* ИДУниверсальногоОбъекта - Строка - идентификатор, по которому можно отслеживать в МС состояние оплаты
//
Функция ЗаказатьПлатежнуюСсылку(КодТарифа, ВариантПодписки, НачалоДействия, ОкончаниеДействия, КоличествоЛицензий) Экспорт

	Режим = РежимИспользованияПриложения();
	Если Режим = "КлиентОблака" Тогда
		
		Возврат ИдентификаторДляПлатежнойСсылкиИзОблака(КодТарифа, ВариантПодписки, НачалоДействия, ОкончаниеДействия, КоличествоЛицензий);
		
	ИначеЕсли Режим = "Разделенный" Тогда 
		
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДБиллинг");
		ТекстОшибки = "";
		
		ИД = Модуль.ИдентификаторДляПлатежнойСсылки(КодТарифа, ВариантПодписки, НачалоДействия, ОкончаниеДействия, КоличествоЛицензий, ТекстОшибки);
		Результат = Новый Структура("КодСостояния,ИДУниверсальногоОбъекта,ОписаниеОшибки");
		Если ЗначениеЗаполнено(ИД) Тогда
			Результат.КодСостояния            = 200;
			Результат.ИДУниверсальногоОбъекта = ИД;
		Иначе
			Результат.КодСостояния            = 500;
			Результат.ОписаниеОшибки          = ТекстОшибки;
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(НСтр("ru='Режим работы ""%1"" не предполагает использование дополнительных лицензий'"), );

КонецФункции

// Получает из МС универсальный объект и проверяет в нем наличие платежной ссылки. 
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	ИДУниверсальногоОбъекта - Строка - идентификатор универсального объекта в менеджере сервиса
//
//Возвращаемое значение:
//	Структура:
//		* ПлатежнаяСсылка - Строка - адрес ссылки, которую нужно показать пользователю для оплаты
//		* ИдентификаторПлатежа - Строка - идентификатор, по которому можно отслеживать в МС состояние оплаты
//
Функция ПолучитьПлатежнуюСсылку(ИДУниверсальногоОбъекта) Экспорт

	Режим = РежимИспользованияПриложения();
	
	Результат = Новый Структура("КодСостояния,ИДУниверсальногоОбъекта,ПлатежнаяСсылка,ОписаниеОшибки");
	Результат.Вставить("ИДУниверсальногоОбъекта", ИДУниверсальногоОбъекта);
	УниверсальныйОбъект = Неопределено;
	
	Если Режим = "КлиентОблака" Тогда
		
		ОтветСервера = УниверсальныйОбъектИнтеграцииИзОблака(ИДУниверсальногоОбъекта);
		ЗаполнитьЗначенияСвойств(Результат, ОтветСервера, "КодСостояния,ОписаниеОшибки");
		Если Результат.КодСостояния = 200 Тогда
			УниверсальныйОбъект = ОтветСервера.ЗначениеОтвета;
		КонецЕсли;
		
	ИначеЕсли Режим = "Разделенный" Тогда 
		
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДБиллинг");
		УниверсальныйОбъект = Модуль.ОбъектЗаявкиНаПодписку(ИДУниверсальногоОбъекта, Результат.ОписаниеОшибки);
		Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
			Результат.КодСостояния   = 500;
		Иначе
			Результат.КодСостояния   = 200;
		КонецЕсли;
		
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru='Режим работы ""%1"" не предполагает использование дополнительных лицензий'"), );
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УниверсальныйОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не УниверсальныйОбъект.Свойство("СтруктураДанных") 
			Или Не ЗначениеЗаполнено(УниверсальныйОбъект.СтруктураДанных) Тогда
		Результат.КодСостояния   = 500;
		Результат.ОписаниеОшибки = НСтр("ru='С сервера не возвращена структура универсального объекта'");
		
	ИначеЕсли УниверсальныйОбъект.СтруктураДанных.Свойство("Ошибка") 
			И УниверсальныйОбъект.СтруктураДанных.Ошибка Тогда
		Результат.КодСостояния   = 500;
		Если УниверсальныйОбъект.СтруктураДанных.Свойство("ОписаниеОшибки")
				И ЗначениеЗаполнено(УниверсальныйОбъект.СтруктураДанных.ОписаниеОшибки)Тогда
			Результат.ОписаниеОшибки = УниверсальныйОбъект.СтруктураДанных.ОписаниеОшибки;
		Иначе
			Результат.ОписаниеОшибки = НСтр("ru='На сервере произошла неизвестная ошибка (возвращен признак оошибки но нет ее описания)'") ;
		КонецЕсли;
		
	ИначеЕсли Не УниверсальныйОбъект.СтруктураДанных.Свойство("ПлатежнаяСсылка")
		Или Не ЗначениеЗаполнено(УниверсальныйОбъект.СтруктураДанных.ПлатежнаяСсылка) Тогда
		Результат.КодСостояния   = 302;
		
	Иначе
		Результат.КодСостояния   = 200;
		Результат.ПлатежнаяСсылка = УниверсальныйОбъект.СтруктураДанных.ПлатежнаяСсылка;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Проверяет на сервере создание подписки по заявке с указанными ИБ
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	ИДУниверсальногоОбъекта - Строка - идентификатор универсального объекта в менеджере сервиса
//
//Возвращаемое значение:
//	Структура:
//		* ПодпискаСоздана - Булево - Истина, если создана
//		* КодСостояния - 200, если проверка выполнена, или другой код в случае ошибки
//		* ОписаниеОшибки - Строка - имеет смысл только если КодСостояния <> 200
//
Функция ПодпискаПоЗаявкеСоздана(ИДУниверсальногоОбъекта) Экспорт

	Режим = РежимИспользованияПриложения();
	
	Результат  = Новый Структура("КодСостояния,ПодпискаСоздана,ОписаниеОшибки");
	
	Если Режим = "КлиентОблака" Тогда
		
		ОтветСервера = ПодпискаПоЗаявкеСозданаИзОблака(ИДУниверсальногоОбъекта);
		ЗаполнитьЗначенияСвойств(Результат, ОтветСервера, "КодСостояния,ОписаниеОшибки");
		Если Результат.КодСостояния = 200 Тогда
			Результат.ПодпискаСоздана = ОтветСервера.ЗначениеОтвета;
		КонецЕсли;
		
	ИначеЕсли Режим = "Разделенный" Тогда 
		
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДБиллинг");
		Результат.ПодпискаСоздана = Модуль.ПодпискаПоЗаявкеСоздана(ИДУниверсальногоОбъекта, Результат.ОписаниеОшибки);
		Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
			Результат.КодСостояния   = 500;
		Иначе
			Результат.КодСостояния   = 200;
		КонецЕсли;
		
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru='Режим работы ""%1"" не предполагает использование дополнительных лицензий'"), );
	КонецЕсли;
	
	Возврат Результат;

КонецФункции



