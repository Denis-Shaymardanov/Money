#Область ПрограммныйИнтерфейс

// Возвращает признак того, что в сборке использованы библиотеки разделенного режима
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	Нет
//
//Возвращаемое значение:
//	Булево - Истина, если сборка предназначена для работы в облаке
//
Функция ИспользуютсяПодсистемыОблака() Экспорт
	Возврат ОбщегоНазначения.ПодсистемаСуществует("ОблачныеСервисыДенег"); //ОСД
КонецФункции

// Возвращает имя режима, в котором используется приложение
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	Нет
//
//Возвращаемое значение:
//	Строка - один из следующих вариантов:
//		 - "Независимый"     - настольная программа без синхронизации с другими программами
//		 - "ЦентрМобильных"  - настольная программа, является центральной базой для мобильных приложений
//		 - "Неразделенный"   - облачное приложение в неразделенном режиме
//		 - "Разделенный"     - облачное приложение в разделенном режиме
//		 - "КлиентОблака"    - автономная копия, синхронизируемая с облаком
//
Функция РежимИспользованияПриложения() Экспорт
	Возврат ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
КонецФункции


#Область Настройки_соединения_с_облаком

// Возвращает параметры соединения с сервером облачного приложения
//
//Параметры:
//	нет
//
//Возвращаемое значение:
//	Структура - см. НовыйПараметрыСоединенияСОблаком()
//
Функция ПараметрыСоединенияСОблаком() Экспорт
	Возврат ДеньгиВОблакеПовтИсп.ПараметрыСоединенияСОблаком();
КонецФункции

// Очищает параметры соединения с сервером облачного приложения
//
//Параметры:
//	нет
//
Процедура ОчиститьПараметрыСоединенияСОблаком() Экспорт

	ПустыеПараметры = ДеньгиВОблаке.НовыйПараметрыСоединенияСОблаком();
	ПустыеПараметры.Отключено = Истина;
	РегистрыСведений.ЗначенияНастроекИнтеграции.ЗаписатьНастройку(
				ДеньгиВОблакеКлиентСервер.ИмяНастройкиПараметрыСоединения(), 
				ПустыеПараметры);
	ПланыОбмена.СинхронизацияАвтономныхКопий.ОчиститьКодЦентральнойБазы();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Записывает параметры соединения с сервером облачного приложения
//
//Параметры:
//	ПолныйПутьКБазе - Строка - URL доступа к базе на сервере
//	Логин  - Строка - логин пользователя абонента
//	Пароль - Строка - пароль пользователя абонента
//	НомерОбласти - Число - номер области данных на сервере
//	КодАбонента - Число - код абонента на сервере
//
Процедура ЗаписатьПараметрыСоединенияСОблаком(ПолныйПутьКБазе, Логин, Пароль, НомерОбласти, ИмяЭтойБазы, КодАбонента, Отключено) Экспорт
	
	СтруктураАдсера = ОбщегоНазначенияКлиентСервер.СтруктураURI(ПолныйПутьКБазе);
	
	Настройка = НовыйПараметрыСоединенияСОблаком();
	Настройка.ПолныйПутьКБазе = ПолныйПутьКБазе;
	Настройка.АдресСервера    = СтруктураАдсера.ИмяСервера;
	Настройка.Логин           = ?(ЗначениеЗаполнено(Логин), Логин, СтруктураАдсера.Логин);
	Настройка.Пароль          = ?(ЗначениеЗаполнено(Пароль), Пароль, СтруктураАдсера.Пароль);
	Настройка.НомерОбласти    = НомерОбласти;
	Настройка.ИмяЭтойБазы     = ИмяЭтойБазы;
	Настройка.КодАбонента     = КодАбонента;
	Настройка.Отключено       = Отключено;
	
	РегистрыСведений.ЗначенияНастроекИнтеграции.ЗаписатьНастройку(ДеньгиВОблакеКлиентСервер.ИмяНастройкиПараметрыСоединения(), Настройка);
	
	// Обновление настроек WS-соединения с узлом плана обмена
	УзелСервера = СинхронизацияАвтономныхКопийВызовСервера.УзелЦентральнойБазы();
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("Корреспондент",     УзелСервера);
	СтруктураЗаписи.Вставить("WSURLВебСервиса",   ПолныйПутьКБазе);
	СтруктураЗаписи.Вставить("WSЗапомнитьПароль", Истина);
	СтруктураЗаписи.Вставить("WSИмяПользователя", Настройка.Логин);
	СтруктураЗаписи.Вставить("WSПароль",          Настройка.Пароль);
	СтруктураЗаписи.Вставить("ВидТранспортаСообщенийОбменаПоУмолчанию", Перечисления.ВидыТранспортаСообщенийОбмена.WS);
	
	РегистрыСведений.НастройкиТранспортаОбменаДанными.ОбновитьЗапись(СтруктураЗаписи);
	
	ЭтотУзел = СинхронизацияАвтономныхКопийВызовСервера.ЭтотУзел();
	Если ЭтотУзел.Наименование <> ИмяЭтойБазы Тогда
		ЭтотУзелОбъект = ЭтотУзел.ПолучитьОбъект();
		ЭтотУзелОбъект.Наименование = ИмяЭтойБазы;
		ЭтотУзелОбъект.ОбменДанными.Загрузка = Истина;
		ЭтотУзелОбъект.Записать();
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Обновляет значение "ЗапрещеноНаСервере" в параметрах облачного приложения
//
//Параметры:
//	ПараметрыПриложения - Структура - см. НовыйПараметрыСоединенияСОблаком();
//	ДоступностьНаСервере - Булево - доступность или недоступность на сервере
//
Процедура ЗаписатьДоступностьЭтойБазыНаСервере(ПараметрыПриложения, ЗапрещеноНаСервере) Экспорт
	
	Если ПараметрыПриложения = Неопределено Тогда
		ПараметрыПриложения = ПараметрыСоединенияСОблаком();
	КонецЕсли;
	Если ПараметрыПриложения.ЗапрещеноНаСервере = ЗапрещеноНаСервере Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПриложения.ЗапрещеноНаСервере = ЗапрещеноНаСервере;
	РегистрыСведений.ЗначенияНастроекИнтеграции.ЗаписатьНастройку(ДеньгиВОблакеКлиентСервер.ИмяНастройкиПараметрыСоединения(), ПараметрыПриложения);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Обновляет значение "Отключено" в параметрах облачного приложения
//
//Параметры:
//	ПараметрыПриложения - Структура - см. НовыйПараметрыСоединенияСОблаком();
//
Процедура ИзменитьПометкуОтключенияЭтойБазы(Отключено, ПараметрыПриложения = Неопределено) Экспорт
	
	Режим = РежимИспользованияПриложения();
	Если Режим = "Неразделенный" Или Режим = "Разделенный" Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПриложения = Неопределено Тогда
		ПараметрыПриложения = ПараметрыСоединенияСОблаком();
	КонецЕсли;
	
	Если ПараметрыПриложения.Отключено <> Отключено Тогда
		ПараметрыПриложения.Отключено = Отключено;
		РегистрыСведений.ЗначенияНастроекИнтеграции.ЗаписатьНастройку(ДеньгиВОблакеКлиентСервер.ИмяНастройкиПараметрыСоединения(), ПараметрыПриложения);
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
КонецПроцедуры

// Возвращает адрес менеджера сервсиса - в разделенном режиме из модулей БТС,
//	в автономной копии - из значений настроек
//
Функция СерверМенеджераСервиса() Экспорт
	
	Если ИспользуютсяПодсистемыОблака() Тогда
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДСервер");
		Возврат  Модуль.СерверМенеджераСервиса();
	Иначе
		Возврат РегистрыСведений.ЗначенияНастроекИнтеграции.ЗначениеНастройки(ДеньгиВОблакеКлиентСервер.ИмяНастройкиСерверМС(), ДеньгиВОблакеКлиентСервер.АдресСервераМС());
	КонецЕсли;
	
КонецФункции


