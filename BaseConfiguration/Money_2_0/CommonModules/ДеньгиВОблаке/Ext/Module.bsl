//
//Параметры:
//	ПараметрыПодключения - структура с параметрами подключения к облаку см. ПараметрыСоединенияСОблаком()
//
//Возвращаемое значение:
//	Струкура
//
Функция НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, АдресСервиса = Неопределено, АдресЗапроса = Неопределено) Экспорт

	Результат = RESTВызовСервера.НовыйСтруктураЗапроса(ПараметрыПодключения.ПолныйПутьКБазе, 
					ПараметрыПодключения.Логин, ПараметрыПодключения.Пароль);
	
