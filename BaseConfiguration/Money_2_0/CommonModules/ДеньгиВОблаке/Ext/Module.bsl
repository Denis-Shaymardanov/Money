// Отмечает на сервере все записи базы для выгрузки в указанный узел
//
//Параметры:
//	ПараметрыПодключения - Структура или непоределено
//	Узел - ПланОбменаСсылка
//
//Возвращаемое значение:
//		* ЗначениеОтвета - структура или неопределено
//		* КодСостояния - 200 в случае успеха или другой код в случае ошибки
//		* ОписаниеОшибки - Строка - имеет смысл только если КодСостояния <> 200
//
Функция ПолучитьССервераИнформацию(ПараметрыПодключения, МассивКоманд) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеОтвета", Неопределено); 
	Результат.Вставить("КодСостояния",   200); 
	Результат.Вставить("ОписаниеОшибки", ""); 
	
	ПараметрыЗапроса = Новый Структура("Команды", МассивКоманд);
	ТекстЗапроса = ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса);
	
	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураЗапроса = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, АдресСервисаСинхронизации(), 
							"/getinfo/" + ПараметрыПодключения.КодЭтогоУзла);
	Ответ = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, ТекстЗапроса, 
					"Обмен данными.СинхронизацияАвтономныхКопий.Управление", "200");
	
	Результат.КодСостояния    = Ответ.КодСостояния;
	Результат.ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	Если Результат.КодСостояния = 200 Тогда
		Результат.ЗначениеОтвета   = Ответ.ЗначениеОтвета;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

