Функция ПолучитьСостояниеПодпискиИзОблака(ИмяУслуги, КодИБ, КлючЛицензии, ПараметрыПодключения = Неопределено) 

	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураПодключения = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, АдресСервисаБиллинга(), "subscription/prop");
	
	СтруктураПодключения.ПараметрыЗапроса.Вставить("Plan",        ПараметрыПодключения.ИмяПланаОбмена);
	СтруктураПодключения.ПараметрыЗапроса.Вставить("ServerID",    ПараметрыПодключения.КодЦентральнойБазы);
	СтруктураПодключения.ПараметрыЗапроса.Вставить("NodeID",      КодИБ);
	СтруктураПодключения.ПараметрыЗапроса.Вставить("ServiceName", ИмяУслуги);
	СтруктураПодключения.ПараметрыЗапроса.Вставить("LicenseKey",  КлючЛицензии);
	
	Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("GET", СтруктураПодключения, 
					"", 
					"Биллинг.Получение свойств подписки");
	Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
		ВызватьИсключение Ответ.ОписаниеОшибки;
	КонецЕсли;
	
	РезультатОбработки = Ответ.ЗначениеОтвета;
	
	Возврат РезультатОбработки;

КонецФункции

