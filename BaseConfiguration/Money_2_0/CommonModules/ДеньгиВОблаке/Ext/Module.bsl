Функция ИдентификаторДляПлатежнойСсылкиИзОблака(КодТарифа, ВариантПодписки, НачалоДействия, ОкончаниеДействия, КоличествоЛицензий, ПараметрыПодключения = Неопределено) 
	
	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураПодключения = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, АдресСервисаБиллинга(), "subscription/paymentlink");
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ServerID",   ПараметрыПодключения.КодЦентральнойБазы);
	ПараметрыЗапроса.Вставить("TariffID",   КодТарифа);
	ПараметрыЗапроса.Вставить("OptionID",   ВариантПодписки);
	ПараметрыЗапроса.Вставить("StartData",  НачалоДействия);
	ПараметрыЗапроса.Вставить("EndData",    ОкончаниеДействия);
	ПараметрыЗапроса.Вставить("Count",      КоличествоЛицензий);
	
	Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураПодключения, 
					ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), 
					"Биллинг.Создание платежной ссылки");
	
	Результат = Новый Структура("КодСостояния,ИДУниверсальногоОбъекта,ОписаниеОшибки");
	ЗаполнитьЗначенияСвойств(Результат, Ответ, "КодСостояния,ОписаниеОшибки");
	Результат.ИДУниверсальногоОбъекта = Ответ.ЗначениеОтвета;
	
	Возврат Результат;
	
