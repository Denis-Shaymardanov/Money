#Область Подключение_к_облаку

// Записывает в облаке изменения свойств информационной базы в фоновом режиме
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//		ПараметрыПодключения - Структура, содержит новые значения параметров подключения
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ИзменитьПарольИИмяБазыВОблакеВФоне(ПараметрыМетода, АдресРезультата, ДополнительныйАдрес = Неопределено) Экспорт
	
	ПараметрыПодключения = Неопределено;
	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, "", Истина);
	
	НовыеЗначения = ПараметрыМетода;
	НовыйПароль = Неопределено;
	НовыеЗначения.Свойство("Пароль", НовыйПароль);
	НовоеИмя = Неопределено;
	НовыеЗначения.Свойство("ИмяЭтойБазы", НовоеИмя);
	
	Если ЗначениеЗаполнено(НовыйПароль) И НовыйПароль <> ПараметрыПодключения.Пароль Тогда
		
		ОписаниеОшибки     = "";
		РезультатИзменений = СменитьПарольПользователяВОблаке(НовыйПароль);
		//РезультатИзменений = ЗаменитьПарольНаСервере(ПараметрыПодключения.Логин, 
		//		ПараметрыПодключения.Пароль, НовыйПароль, ПараметрыПодключения.КодАбонента, ОписаниеОшибки);
		Если РезультатИзменений.КодСостояния = 200 Тогда
			ПараметрыПодключения.Пароль = РезультатИзменений.Пароль;
			ЗаписатьПараметрыСоединенияСОблаком(ПараметрыПодключения.ПолныйПутьКБазе, ПараметрыПодключения.Логин, 
						ПараметрыПодключения.Пароль, ПараметрыПодключения.НомерОбласти, ПараметрыПодключения.ИмяЭтойБазы,
						ПараметрыПодключения.КодАбонента, ПараметрыПодключения.Отключено);
		Иначе
			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеИмя) И НовоеИмя <> ПараметрыПодключения.ИмяЭтойБазы Тогда
		
		НовыеСвойства      = Новый Структура("Наименование", НовоеИмя);
		РезультатИзменений = ИзменитьСвойстваИБВОблаке(ПараметрыПодключения.КодЭтогоУзла, НовыеСвойства, ПараметрыПодключения);
		Если РезультатИзменений = Истина Тогда
			ПараметрыПодключения.ИмяЭтойБазы  = НовоеИмя;
		КонецЕсли;
		
	КонецЕсли;
	
	// Фиксация изменений в локальных настройках
	ЗаписатьПараметрыСоединенияСОблаком(ПараметрыПодключения.ПолныйПутьКБазе, ПараметрыПодключения.Логин, 
					ПараметрыПодключения.Пароль,
					ПараметрыПодключения.НомерОбласти, 
					?(ЗначениеЗаполнено(НовоеИмя), НовоеИмя, ПараметрыПодключения.ИмяЭтойБазы),
					ПараметрыПодключения.КодАбонента, ПараметрыПодключения.Отключено);
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Истина, АдресРезультата);
	
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура НачатьРегистрациюАбонентаВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	АдресРезультата = ПоместитьВоВременноеХранилище(НачатьРегистрациюНовогоАбонента(ПараметрыМетода.Логин), АдресРезультата);
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПроверитьСостояниеРегистрацииНовогоАбонентаВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	ТекстОшибки = "";
	Результат   = СостояниеРегистрацииНовогоАбонента(ПараметрыМетода.АдресЗавершенияРегистрации, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	АдресРезультата = ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ИзменитьПарольПользователяВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	ТекстОшибки = "";
	Результат = СменитьПарольПользователяВОблаке(ПараметрыМетода.НовыйПароль, ПараметрыМетода.ТекущийПароль, ПараметрыМетода.Логин, ТекстОшибки);
	//Результат   = ЗаменитьПарольНаСервере(ПараметрыМетода.Логин, ПараметрыМетода.ТекущийПароль, 
	//						ПараметрыМетода.НовыйПароль, ПараметрыМетода.КодАбонента, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	АдресРезультата = ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПроверитьРегистрациюБазыНаСервереВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	АдресРезультата = ПоместитьВоВременноеХранилище(РегистрацияЭтойБазыНаСервере(ПараметрыМетода.ПараметрыПодключения), АдресРезультата);
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПодключитьБазуКАбонентуВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	ТекстОшибки = "";
	Результат   = ПараметрыАбонентаПоЛогинуПользователя(ПараметрыМетода.Логин, ПараметрыМетода.Пароль, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	АдресРезультата = ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПолучитьСвойстваЭтойБазыИзОблакаВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	АдресРезультата = ПоместитьВоВременноеХранилище(СвойстваЗарегистрированнойБазы(СинхронизацияАвтономныхКопийВызовСервера.КодЭтогоУзла()), АдресРезультата);
КонецПроцедуры

// Запускает фоновое задание
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ОбновитьСвойстваБазыВОблакеВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	ПараметрыПодключения = Неопределено;
	ПараметрыМетода.Свойство("ПараметрыПодключения", ПараметрыПодключения);
	НовыеСвойства = Неопределено;
	ПараметрыМетода.Свойство("СвойстваБазы", НовыеСвойства);
	
	Если Не ЗначениеЗаполнено(НовыеСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьСвойстваИБВОблаке(ПараметрыМетода.КодИБ, НовыеСвойства, ПараметрыПодключения);
	
	Если ПараметрыМетода.КодИБ = СинхронизацияАвтономныхКопийВызовСервера.КодЭтогоУзла() Тогда
		
		НовоеНаименование           = Неопределено;
		НовыеСвойства.Свойство("Наименование", НовоеНаименование);
		НовоеСинхронизацияЗапрещена = Неопределено;
		НовыеСвойства.Свойство("СинхронизацияЗапрещена", НовоеСинхронизацияЗапрещена);
		Если ЗначениеЗаполнено(НовоеНаименование) Или НовоеСинхронизацияЗапрещена <> Неопределено Тогда
			// Фиксация изменений в локальных настройках
			ЗаписатьПараметрыСоединенияСОблаком(ПараметрыПодключения.ПолныйПутьКБазе, ПараметрыПодключения.Логин, 
							ПараметрыПодключения.Пароль,
							ПараметрыПодключения.НомерОбласти, 
							?(ЗначениеЗаполнено(НовоеНаименование), НовоеНаименование, ПараметрыПодключения.ИмяЭтойБазы),
							ПараметрыПодключения.КодАбонента, 
							?(НовоеСинхронизацияЗапрещена = Неопределено, ПараметрыПодключения.Отключено, НовоеСинхронизацияЗапрещена)
							);
		КонецЕсли;
		
	КонецЕсли;
	
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Истина, АдресРезультата);
	
КонецПроцедуры



// Выполняет запрос регистрации приложения на сервере. В случае успеха заполняет АдресЗавершения
//и возвращает:
//		* 200 - регистрация выполнена, область готова. В параметр АдресЗавершения попмещена ссылка на приложение в облаке
//		* 302 - регистрация выполнена, нужно ожидать завершение подготовки области. В параметр АдресЗавершения попмещена ссылка на завершение регистрации
//	В случае ошибки заполняет ОписаниеОшибки и возвращает код ошибки:
//		* 500 - прочие ошибки
//		* 501 - почтовый адрес неправильный
//		* 502 - указанный адрес уже используется
//	Доступность: Автономная копия
//
//Параметры:
//	ПочтаАбонента - Строка - e-mail, онже логин абонента
//	ИмяПользователя - Строка - имя пользователя-владельца абонента для регистрации в списке пользователей
//	ТелефонАбонента - Строка - номер телефона владельца абонента
//	
//Возвращаемое значение
//	Структура
//		* КодСостояния - Число - код из ответа сервера
//		* АдресЗавершенияРегистрации - Строка или Неопределено - http адрес страницы ожидания завершения регистрации
//		* ОписаниеОшибки - Строка - описание ошибки ответа
//
Функция НачатьРегистрациюНовогоАбонента(ПочтаАбонента, ИмяПользователя = "", ТелефонАбонента = "") Экспорт

	СтруктураЗапроса = НовыйСтруктураЗапросаРегистрации();
	
	СтрокаТела = СтрШаблон("name=%1&email=%2&phone=%3&promo=%4&promouser=ExtRegMoney", 
				"""" + ?(ЗначениеЗаполнено(ИмяПользователя), ИмяПользователя, СтрШаблон(НСтр("ru='Владелец абонента %1'"), ПочтаАбонента)) + """",
				ПочтаАбонента, "", Строка(КодСайтаПромоРегистрации()));
	СтрокаТела = СтрокаТела + "&userExistsErrorRedirectUrl=userExists" // редирект для существующего пользователя
				+ "&unknownErrorRedirectUrl=unknownError" // редирект для неопределенной ошибки на сервере
				+ "&promocodeNotFoundRedirectUrl=promocodeNotFound" // редирект для промокода, котороый не найден
				+ "&promocodeBlockedRediretUrl=promocodeBlocked" // редирект для заблокированного промокода
				+ "&promocodeExpiredRedirectUrl=promocodeExpired"; // редирект для промокода, у которого истек срок
				
	Ответ = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, СтрокаТела, "Биллинг.Регистрация абонента");
	
	Результат = Новый Структура("КодСостояния,АдресЗавершенияРегистрации,ОписаниеОшибки");
	Результат.КодСостояния   = Ответ.КодСостояния;
	Результат.АдресЗавершенияРегистрации = "";
	Результат.ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	
	Если Результат.КодСостояния = 302 И Ответ.ОтветСервера.Заголовки["Location"] <> Неопределено Тогда
		
		
		АдресРедиректа = Ответ.ОтветСервера.Заголовки["Location"];
		Если СтрНайти(АдресРедиректа, "/userExists") > 0 Тогда
			Результат.КодСостояния = 403;
			Результат.ОписаниеОшибки = НСтр("ru='Пользователь с таким логином (e-mail) уже существует'");
		ИначеЕсли СтрНайти(АдресРедиректа, "/promocodeNotFound") > 0 Тогда
			Результат.КодСостояния = 422;
			Результат.ОписаниеОшибки = НСтр("ru='Промо-код не найден'");
		ИначеЕсли СтрНайти(АдресРедиректа, "/promocodeBlocked") > 0 Тогда
			Результат.КодСостояния = 423;
			Результат.ОписаниеОшибки = НСтр("ru='Промо-код заблокирован'");
		ИначеЕсли СтрНайти(АдресРедиректа, "/promocodeExpired") > 0 Тогда
			Результат.КодСостояния = 500;
			Результат.ОписаниеОшибки = НСтр("ru='Истек срок действия промо-кода'");
		ИначеЕсли СтрНайти(АдресРедиректа, "/unknownError") > 0 Тогда
			Результат.КодСостояния = 500;
			Результат.ОписаниеОшибки = НСтр("ru='На сервере произошла неизвестная ошибка'");
		Иначе
			Результат.АдресЗавершенияРегистрации = АдресРедиректа;
		КонецЕсли;
		
	ИначеЕсли Результат.КодСостояния = 400 Тогда
		
		Результат.ОписаниеОшибки = НСтр("ru='Регистрация не выполнена из-за проблем с логином или паролем!'");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет завершение регистрации по ссылке, полученной в  НачатьРегистрациюНовогоАбонента();
//	Доступность: Автономная копия
//
//Параметры:
//	АдресЗавершенияРегистрации - Строка - возвращаемый параметр, заполняется ссылкой на завершение регистрации в случае успеха
//	ОписаниеОшибки  - Строка - возвращаемый параметр, заполняется описанием ошибки в случае проблем 
//	
//Возвращаемое значение
//	Структура
//		* КодСостояния
//			* 200 - регистрация выполнена, область готова. В параметр АдресЗавершенияРегистрации попмещена ссылка на приложение в облаке
//			* 302 - регистрация выполнена, нужно ожидать завершение подготовки области. В параметр АдресЗавершенияРегистрации попмещена ссылка на завершение регистрации
//			* другое значение - ответ сервреа с заполнением параметра ОписаниеОшибки
//		* ПолныйПутьКБазе
//		* Логин
//		* Пароль
//		* НомерОбласти
//		* КодАбонента
//		* АдресЗавершенияРегистрации - Строка - заполняется только если КодСостояния = 302
//
Функция СостояниеРегистрацииНовогоАбонента(АдресЗавершенияРегистрации, ОписаниеОшибки = "", HTTPСоединение = Неопределено) Экспорт

	Результат = Новый Структура("КодСостояния,ПолныйПутьКБазе,Логин,Пароль,НомерОбласти,КодАбонента");
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресЗавершенияРегистрации);
	Попытка
		
		Если HTTPСоединение = Неопределено Тогда
			HTTPСоединение = Новый HTTPСоединение(
				СтруктураURI.Хост,
				СтруктураURI.Порт,
				СтруктураURI.Логин,
				СтруктураURI.Пароль,
				RESTВызовСервера.ИнтернетПроксиПоНастройкам(),
				40,
				?(СтруктураURI.Порт = 443 Или НРег(СтруктураURI.Схема) = "https", Новый ЗащищенноеСоединениеOpenSSL(), Неопределено)
			);
		КонецЕсли;
		
		HTTPЗапрос = Новый HTTPЗапрос(СтруктураURI.ПутьНаСервере);
		РезультатЗапроса = HTTPСоединение.Получить(HTTPЗапрос);
		Ответ = РезультатЗапроса.ПолучитьТелоКакСтроку();
		
	Исключение
		
		ТекстОшибки = СтрШаблон("Ошибка выполнения HTTP-запроса:
				| запрос = ""%1""
				| ошибка: %2", 
				СтруктураURI.ПутьНаСервере, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДеньгиВОблакеВызовСервера.ЗарегистрироватьОшибкуВЖурнале(
					ТекстОшибки, НСтр("ru='Регистрация нового абонента'"));
		ОписаниеОшибки = НСтр("ru='Сервис регистрации временно недоступен, попробуйте немного позднее.'");
		Результат.КодСостояния = -100;
		Возврат Результат;
		
	КонецПопытки;
	
	ЧтениеHTML = Новый ЧтениеHTML();
	ЧтениеHTML.УстановитьСтроку(Ответ);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеHTML);
	
	Адрес = "";
	usr = "";
	pwd = "";

	Если ДокументDOM.Формы.Количество() > 0
		И ДокументDOM.Формы[0].Идентификатор = "login" Тогда
		Для каждого ТекЭлемент ИЗ ДокументDOM.Формы[0].Элементы Цикл
			Если ТекЭлемент.Имя = "usr" Тогда
				usr = ТекЭлемент.Значение;
			ИначеЕсли ТекЭлемент.Имя = "pwd" тогда
				pwd = ТекЭлемент.Значение;
			Конецесли;
		КонецЦикла;
		Адрес = ДокументDOM.Формы[0].Действие;
	КонецЕсли;
	
	Адрес = СтрЗаменить(Адрес, "?OIDA-", "");
	
	Если Адрес <> "/e1cib/start" Тогда
		
		Результат.ПолныйПутьКБазе = СтрЗаменить(Адрес, "/e1cib/start", "");
		Результат.Логин           = usr;
		Результат.Пароль          = pwd;
		Результат.КодСостояния    = 200;
		
		ПозицияРазделителя = СтрНайти(Результат.ПолныйПутьКБазе, "/", НаправлениеПоиска.СКонца);
		ОбластьСтрокой = Прав(Результат.ПолныйПутьКБазе, СтрДлина(Результат.ПолныйПутьКБазе) - ПозицияРазделителя);
		Если Не ПустаяСтрока(ОбластьСтрокой) И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ОбластьСтрокой) Тогда
			Результат.НомерОбласти = Число(ОбластьСтрокой);
		КонецЕсли;
		
		// Определение кода абонента
		Если ЗначениеЗаполнено(usr) Тогда
			Абоненты = АбонентыПользователя(usr, pwd, ОписаниеОшибки);
			Если ТипЗнч(Абоненты) = Тип("Массив") И Абоненты.Количество() > 0 Тогда
				Результат.КодАбонента = Абоненты[0].id;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Результат.КодСостояния = 302;
		Результат.Вставить("АдресЗавершенияРегистрации", АдресЗавершенияРегистрации);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает список абонентов пользователя
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	ПользовательАбонента - Строка - Логин пользователя абонента
//	ПарольПользователя - Строка - пароль пользователя абонента
//	ОписаниеОшибки  - Строка - возвращаемый параметр, заполняется описанием ошибки в случае проблем 
//
//Возвращаемое значение:
//	Массив структур, описывающих абонентов пользователя:
//		* id - число - код абонента
//		* name - Строка - Наименование
//		* role - Строка - РолиПользователя
//
Функция АбонентыПользователя(ПользовательАбонента, ПарольПользователя, ОписаниеОшибки = "") Экспорт

	СтруктураЗапроса = НовыйСтруктураЗапросаВнешнегоИнтерфейса(ПользовательАбонента, ПарольПользователя);
	
	ПараметрыЗапроса = Новый Структура("general", Новый Структура);
	ПараметрыЗапроса.general.Вставить("type", "ext");
	ПараметрыЗапроса.general.Вставить("method", "account/list");
	
	Ответ           = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), "Биллинг.Получение списка абонентов");
	ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат Неопределено;
	ИначеЕсли Ответ.КодСостояния = 401 Тогда 
		ОписаниеОшибки = НСтр("ru='Ошибка авторизации: неверный адрес почты или пароль'");
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Ответ.ЗначениеОтвета) <> Тип("Структура")
		Или Не Ответ.ЗначениеОтвета.Свойство("account") Тогда 
		ОписаниеОшибки = НСтр("ru='Сервер вернул неправильный ответ'");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СкопироватьРекурсивно(Ответ.ЗначениеОтвета.account);

КонецФункции

// Возвращает список областей указанного абонента
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	ПользовательАбонента - Строка - Логин пользователя абонента
//	ПарольПользователя - Строка - пароль пользователя абонента
//	КодАбонента - Число - код абонента менеджера сервиса
//	ОписаниеОшибки  - Строка - возвращаемый параметр, заполняется описанием ошибки в случае проблем 
//
//Возвращаемое значение:
//	Массив структур, описывающих абонентов пользователя:
//		* КодАбонента - число
//		* Наименование - Строка
//		* РолиПользователя - Строка
//
Функция ОбластиАбонента(ПользовательАбонента, ПарольПользователя, КодАбонента, ОписаниеОшибки = "") Экспорт

	СтруктураЗапроса = НовыйСтруктураЗапросаВнешнегоИнтерфейса(ПользовательАбонента, ПарольПользователя);
	
	ПараметрыЗапроса = Новый Структура("general", Новый Структура);
	ПараметрыЗапроса.general.Вставить("type", "ext");
	ПараметрыЗапроса.general.Вставить("method", "tenant/list");
	
	ПараметрыЗапроса.Вставить("auth", Новый Структура);
	ПараметрыЗапроса.auth.Вставить("account", КодАбонента);
	
	Ответ  = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), "Биллинг.Получение областей абонента");
	ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СкопироватьРекурсивно(Ответ.ЗначениеОтвета.tenant);

КонецФункции

// Возвращает структуру с параметрами подключения, восстановленную по логину и паролю пользователя менеджера сервиса
//Для успешного выполнения пользователь должен быть владельцем абонента
//	Доступность: Автономная копия
//
//Параметры:
//	ПользовательАбонента - Строка - Логин пользователя абонента
//	ПарольПользователя - Строка - пароль пользователя абонента
//	ОписаниеОшибки  - Строка - возвращаемый параметр, заполняется описанием ошибки в случае проблем 
//
//Возвращаемое значение:
//	Струкутура - см. НовыйПараметрыСоединенияСОблаком() Или Неопределено в случае ошибки
//
//
Функция ПараметрыАбонентаПоЛогинуПользователя(Логин, Пароль, ОписаниеОшибки = "") Экспорт

	Результат = НовыйПараметрыСоединенияСОблаком();
	Результат.Логин  = Логин;
	Результат.Пароль = Пароль;
	
	СписокАбонентов = АбонентыПользователя(Логин, Пароль, ОписаниеОшибки);
	Если Не ЗначениеЗаполнено(СписокАбонентов) Тогда
		ОписаниеОшибки = НСтр("ru='Для указанного пользователя невозможно получить список абонентов. Пожалуйста, укажите логин и пароль владельца абонента'"); 
		Возврат Неопределено;
	КонецЕсли;
	
	КодПриложенияНаСервере = КодПриложенияНаСервере();
	Для каждого Абонент Из СписокАбонентов Цикл
		
		Если Абонент = Неопределено Или Не ЗначениеЗаполнено(Абонент.id) Тогда
			Продолжить;
		КонецЕсли;
		
		Области = ОбластиАбонента(Логин, Пароль, Абонент.id, ОписаниеОшибки);
		Если Области = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для каждого Область Из Области Цикл
			Если Область.application = КодПриложенияНаСервере Тогда
				Результат.КодАбонента     = Абонент.id;
				Результат.НомерОбласти    = Область.id;
				Результат.ПолныйПутьКБазе = Область.url;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выполняет запрос на замену пароля пользователя для входа в сервис. Возвращает код состояния сервера:
//	200 - пароль изменен
//	- другие значения
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	Логин - Строка - e-mail, онже логин абонента
//	ТекущийПароль - Строка - текущий пароль пользоватаеля абонента
//	НовыйПароль - Строка - пароль, который нужно установить
//	КодАбонента - Число - код абонента пользователя
//	ОписаниеОшибки  - Строка - возвращаемый параметр, заполняется описанием ошибки в случае проблем 
//
//Возвращаемое значение:
//	Структура
//		* КодСостояния
//			* 200 - пароль изменен
//			* другое значение - ответ сервреа с заполнением параметра ОписаниеОшибки
//		* Логин
//		* Пароль
//
Функция ЗаменитьПарольНаСервере(Логин, ТекущийПароль, НовыйПароль, КодАбонента, ОписаниеОшибки = "") Экспорт

	СтруктураЗапроса = НовыйСтруктураЗапросаВнешнегоИнтерфейса(Логин, ТекущийПароль);
	
	ПараметрыЗапроса = Новый Структура("auth,general", Новый Структура, Новый Структура);
	ПараметрыЗапроса.auth.Вставить("account", КодАбонента);
	ПараметрыЗапроса.general.Вставить("type", "ext");
	ПараметрыЗапроса.general.Вставить("method", "user/change_password");
	
	ПараметрыЗапроса.Вставить("password", ТекущийПароль);
	ПараметрыЗапроса.Вставить("new_password", НовыйПароль);
	
	Ответ           = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), "Биллинг.Смена пароля пользователя сервиса");
	ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", ?(Ответ.КодСостояния = 200, НовыйПароль, ТекущийПароль));
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру для описания параметров подключения к облаку
//	Доступность: Автономная копия
Функция НовыйПараметрыСоединенияСОблаком() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("АдресСервера", ); 
	Результат.Вставить("УзелСервера", ); // ссылка на узел плана обмена
	Результат.Вставить("Логин", );
	Результат.Вставить("Пароль", );
	Результат.Вставить("НомерОбласти",    ); // число
	Результат.Вставить("ПолныйПутьКБазе", );
	Результат.Вставить("ИмяЭтойБазы",   ИмяКомпьютера());
	Результат.Вставить("КодАбонента",   "");
	Результат.Вставить("Отключено", Истина); // используется ли синхронизация с облаком?
	Результат.Вставить("ЗапрещеноНаСервере", Ложь); // в плане обмена на сервере установлен запрет на синхронизацию для этого узла
	Результат.Вставить("АдресСервисаСинхронизации", "");

	Возврат Результат;
	
КонецФункции

// Проверяет корректность параметров подключения, если указано - вызывает исключение при обнаружении ошибок
//	Доступность: Автономная копия
//
//Параметры:
//	ПараметрыПодключения - структура с параметрами подключения к облаку см. ДеньгиДоступКОблакуВызовСервера.ПараметрыСоединенияСОблаком()
//	ТекстОшибки - Строка - заполняется описанием ошибок, если таковые находятся
//	ВызыватьИсключание - Булево - нужно ли вызывать исключение при обнаружении ошибки
//
//Возвращаемое значение:
//	Булево - Истина, если параметры подключения успешно прошли проверку
//
Функция ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, ТекстОшибки = "", ВызыватьИсключение = Ложь) Экспорт

	Если ПараметрыПодключения = Неопределено Тогда
		ПараметрыПодключения = ПараметрыСоединенияСОблаком();
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Если Не ЗначениеЗаполнено(ПараметрыПодключения.ПолныйПутьКБазе) Тогда
		ТекстОшибки = НСтр("ru='Не указан URL облака'"); 
		Если ВызыватьИсключение Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыПодключения.Логин) Или Не ЗначениеЗаполнено(ПараметрыПодключения.Пароль) Тогда
		ТекстОшибки = ТекстОшибки + ?(ТекстОшибки="", "", Символы.ПС) + НСтр("ru='Логин/пароль пользователя облака не заданы, или указаны некорректно'"); 
		Если ВызыватьИсключение Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстОшибки = "";

КонецФункции

#КонецОбласти 


#Область Взаимодействие_с_биллингом

// Получает с сервера в фоновом режиме информацию для оформления подписок: актуальные тарифы с ценами, 
//остатки неиспльзоавнных подписок
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПолучитьТарифыИОстаткиПодписокВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	АдресРезультата = ПоместитьВоВременноеХранилище(ТарифыИОстаткиПодписок(), АдресРезультата);
	
КонецПроцедуры

// Получает ссылку на страницу оплаты по указанным параметрам подписки
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ЗаказатьПлатежнуюСсылкуВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	АдресРезультата = ПоместитьВоВременноеХранилище(
			ЗаказатьПлатежнуюСсылку(ПараметрыМетода.КодТарифа, ПараметрыМетода.ВариантПодписки, 
					ПараметрыМетода.НачалоДействия, ПараметрыМетода.ОкончаниеДействия, ПараметрыМетода.КоличествоЛицензий), 
			АдресРезультата);
	
КонецПроцедуры

// Проверяет наличие платежной ссылки в универсальном объекте. 
//В хранилище значения помещает ответ сервера с кодом состояния. Если код состояния 302, значит, ссылка еще не готова и следует повторить запрос
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПроверитьГотовностьПлатежнойСсылкиВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	АдресРезультата = ПоместитьВоВременноеХранилище(
			ПолучитьПлатежнуюСсылку(ПараметрыМетода.ИДУниверсальногоОбъекта), 
			АдресРезультата);
	
КонецПроцедуры

// Проверяет оформление подписки по заявке с указанными ID
//В хранилище помещает структуру с кодом состояния и результатом проверки. Если код состояния 302, значит заявка еще не обработана юиллинговой подсистемой
//
//Параметры:
//	ПараметрыМетода - Структута - параметры выполняемого задания
//	АдресРезультата - Строка - адрес, в который будет помещен результат выполнения задания
//
Процедура ПроверитьСозданиеПодпискиПоЗаявкеВФоне(ПараметрыМетода, АдресРезультата) Экспорт
	
	АдресРезультата = ПоместитьВоВременноеХранилище(
			ПодпискаПоЗаявкеСоздана(ПараметрыМетода.ИДУниверсальногоОбъекта), 
			АдресРезультата);
	
КонецПроцедуры


// Регистрирует эту информационную базу на сервере и возвращает параметры, 
//	Доступность: Автономная копия
//
//Параметры:
//	ПараметрыПодключения - структура с параметрами подключения к облаку см. ПараметрыСоединенияСОблаком()
//
//Возвращаемое значение:
//	Структура - обработанный результат метода POST http-сервиса moneybill/connectIB
//
Функция РегистрацияЭтойБазыНаСервере(ПараметрыПодключения = Неопределено) Экспорт

	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураЗапроса = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, АдресСервисаБиллинга(), 
							"connectIB/registration/" + ПараметрыПодключения.КодЭтогоУзла);
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ServerID", ПараметрыПодключения.КодЦентральнойБазы);
	
	Если Не ЗначениеЗаполнено(ПараметрыПодключения.ИмяЭтойБазы) Тогда
		ПараметрыПодключения.ИмяЭтойБазы = ИмяКомпьютера();
	КонецЕсли;
	
	СвойстваИБ = Новый Структура;
	СвойстваИБ.Вставить("Наименование",         ПараметрыПодключения.ИмяЭтойБазы);
	СвойстваИБ.Вставить("МобильноеУстройство",  Ложь);
	ПараметрыЗапроса.Вставить("PropertiesIB",   СвойстваИБ);
	
	СвойстваПодкючения = Новый Структура("Логин,Пароль,НомерОбласти,КодАбонента,ПолныйПутьКБазе");
	ЗаполнитьЗначенияСвойств(СвойстваПодкючения,   ПараметрыПодключения);
	ПараметрыЗапроса.Вставить("PropertiesConnect", СвойстваПодкючения);
	
	ПараметрыЗапроса.Вставить("ClientUIDS",   ИдентификаторыКлиента());
	
	Ответ           = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураЗапроса, ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), "Биллинг.Регистрация ИБ");
	Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
		ИзменитьПометкуОтключенияЭтойБазы(Истина, ПараметрыПодключения);
		ВызватьИсключение Ответ.ОписаниеОшибки;
	КонецЕсли;
	
	РезультатОбработки = Ответ.ЗначениеОтвета;
	Если ПараметрыПодключения.КодЦентральнойБазы = "000" И СтрДлина(РезультатОбработки.КодЦБ) >= 36 Тогда
		СинхронизацияАвтономныхКопийВызовСервера.ЗаменитьКодЦентральнойБазы(РезультатОбработки.КодЦБ);
		ПараметрыПодключения.КодЦентральнойБазы = РезультатОбработки.КодЦБ;
	КонецЕсли;
	
	Если ПараметрыПодключения.ЗапрещеноНаСервере <> РезультатОбработки.ИБЗапрещена Тогда
		ЗаписатьДоступностьЭтойБазыНаСервере(ПараметрыПодключения, РезультатОбработки.ИБЗапрещена);
	КонецЕсли;

	Возврат РезультатОбработки;

КонецФункции

// Возвращает структуру с описанием разрешений и количества доступных лицензий
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	КодИБ - Строка - код проверяемой ИБ
//
//Возвращаемое значение:
//	Структура
//		* КодЦБ - Строка - Код текущей центральной базы
//		* ИБЗапрещена - Булево - Истина, если пользователь запретил синхронизацию с узлом
//		* ИБУстаревшая - Булево - активна ли база или помечена как устаревшая
//		* ПредлагатьСтартовуюПодписку - Булево - можно ли предлагать стартовую подписку
//		* ВсегоЛицензий - Число - кол-во доступных лицензий. (-111 = без ограничений)
//		* СвободноЛицензий - Число - кол-во неиспользованных доступных лицензий. (-111 = без ограничений)
//		* ЗанятоЛицензий - Число - кол-во занятых лицензий (-111 = без ограничений)
//		* НомерПринятого - число - номер принятого на сервере пакета
//		* НомерОтправленного - число - номер отправленного сервером пакета
//
Функция СвойстваЗарегистрированнойБазы(КодИБ, ПараметрыПодключения = Неопределено) Экспорт
	
	Режим = РежимИспользованияПриложения();
	Если Режим = "КлиентОблака" Тогда
		Возврат ПолучитьСвойстваЭтойБазыВОблаке(КодИБ, ПараметрыПодключения);
	ИначеЕсли Режим = "Разделенный" Тогда 
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДБиллинг");
		Возврат  Модуль.СвойстваЗарегистрированнойБазы(КодИБ);
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

// Вызывает метод hs-сервиса для звписи изменений свойств узла на сервере
//
//Параметры:
//	КодИБ - Строка - код узла ЭтотУзел() в плане обмена СинхронизацияАвтономныхКопий
//	НовыеСвойства - Структура - содежит измененные свойства для записи в облаке
//
//Возвращаемое значение:
//	Структура
//		КодСостояния - Число - 200, если выполнено без ошибок
//		ОписаниеОшибки - Строка - информация об ошибке, если код состояния <> 200
//
Функция ИзменитьСвойстваИБВОблаке(КодУзла, НовыеСвойства, ПараметрыПодключения = Неопределено) Экспорт

	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураПодключения = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, 
					АдресСервисаБиллинга(), 
					"connectIB/change/"+ ?(ЗначениеЗаполнено(КодУзла), КодУзла, ПараметрыПодключения.КодЭтогоУзла));
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ServerID", ПараметрыПодключения.КодЦентральнойБазы);
	
	ПараметрыЗапроса.Вставить("PropertiesIB",   НовыеСвойства);
	
	СвойстваПодкючения = Новый Структура("Логин,Пароль,НомерОбласти,КодАбонента");
	ЗаполнитьЗначенияСвойств(СвойстваПодкючения,   ПараметрыПодключения);
	ПараметрыЗапроса.Вставить("PropertiesConnect", СвойстваПодкючения);
	
	Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураПодключения, 
					ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), 
					"Биллинг.Изменение свойств узла");
	Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
		ВызватьИсключение Ответ.ОписаниеОшибки;
	КонецЕсли;
	
	Возврат Ответ.ЗначениеОтвета;

КонецФункции

// Выполняет запрос в облако для изменения признака "Устарела"
//
//Параметры:
//	КодИБ - Строка - код узла ЭтотУзел() в плане обмена СинхронизацияАвтономныхКопий
//	ЗначениеПризнака - Булево - значение признака "Устарела"
//
Функция ИзменитьПризнакУстарелаВОблаке(КодИБ, ЗначениеПризнака, ПараметрыПодключения = Неопределено) Экспорт
	
	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураПодключения = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, 
					АдресСервисаБиллинга(), 
					"connectIB/" + ?(ЗначениеПризнака, "outdate", "update") + "/"
						+ ?(ЗначениеЗаполнено(КодИБ), КодИБ, ПараметрыПодключения.КодЭтогоУзла));
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ServerID", ПараметрыПодключения.КодЦентральнойБазы);
	ПараметрыЗапроса.Вставить("CurrentIB", ПараметрыПодключения.КодЭтогоУзла);
	
	СвойстваПодкючения = Новый Структура("Логин,Пароль,НомерОбласти,КодАбонента");
	ЗаполнитьЗначенияСвойств(СвойстваПодкючения,   ПараметрыПодключения);
	ПараметрыЗапроса.Вставить("PropertiesConnect", СвойстваПодкючения);
	
	Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураПодключения, 
					ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), 
					"Биллинг.Изменение признака ""устаревшая""");
	Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
		ВызватьИсключение Ответ.ОписаниеОшибки;
	КонецЕсли;
	
	Возврат Ответ.ЗначениеОтвета;
	
КонецФункции

// Выполняет запрос в облако для изменения признака "СинхронизацияЗапрещена"
//
//Параметры:
//	КодИБ - Строка - код узла ЭтотУзел() в плане обмена СинхронизацияАвтономныхКопий
//	ЗначениеПризнака - Булево - значение признака "СинхронизацияЗапрещена"
//
Функция ИзменитьЗапретСоединенияВОблаке(КодИБ, ЗначениеПризнака, ПараметрыПодключения = Неопределено) Экспорт
	
	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураПодключения = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, 
					АдресСервисаБиллинга(), 
					"connectIB/" + ?(ЗначениеПризнака, "ban", "unban") + "/"
						+ ?(ЗначениеЗаполнено(КодИБ), КодИБ, ПараметрыПодключения.КодЭтогоУзла));
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ServerID", ПараметрыПодключения.КодЦентральнойБазы);
	ПараметрыЗапроса.Вставить("CurrentIB", ПараметрыПодключения.КодЭтогоУзла);
	
	СвойстваПодкючения = Новый Структура("Логин,Пароль,НомерОбласти,КодАбонента");
	ЗаполнитьЗначенияСвойств(СвойстваПодкючения,   ПараметрыПодключения);
	ПараметрыЗапроса.Вставить("PropertiesConnect", СвойстваПодкючения);
	
	Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураПодключения, 
					ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), 
					"Биллинг.Изменение признака ""Синхронизация запрещена""");
	Если ЗначениеЗаполнено(Ответ.ОписаниеОшибки) Тогда
		ВызватьИсключение Ответ.ОписаниеОшибки;
	КонецЕсли;
	
	Возврат Ответ.ЗначениеОтвета;
	
КонецФункции

// Выполняет проверку состояния подписки на услугу
//
//Параметры:
//	ТипУслуги - Строка - "Загрузка", "Выгрузка"
//	ИмяПланаОбмена - Строка - имя плана обмена, которому принадлежит узел
//	КодУзлаИнформационнойБазы - Строка
//
Процедура ПроверитьСостояниеПодпискиНаУслугу(ТипУслуги, ИмяПланаОбмена, КодУзлаИнформационнойБазы) Экспорт
	
	СостояниеПодписки = СостояниеПодпискиНаУслугу(ИмяУслугиАвтоСинхронизация(), КодУзлаИнформационнойБазы);
	
	Если СостояниеПодписки.ИБЗапрещена Тогда
		Если ИмяПланаОбмена = "МобильноеПриложение" Тогда
			ВызватьИсключение НСтр("ru='Запрещено подключение этого мобильного устройства к облаку'");
		Иначе
			ВызватьИсключение НСтр("ru='Запрещено подключение этой информационной базы к облаку'");;
		КонецЕсли;
	КонецЕсли;
	
	Если СостояниеПодписки.ИБУстаревшая И ТипУслуги <> "ВыгрузкаРезервнойКопии" Тогда
		Если ИмяПланаОбмена = "МобильноеПриложение" Тогда
			ВызватьИсключение НСтр("ru='В облаке это мобильное устройство отмечено как устаревшее. 
				|Вернуть устройство в рабочее состояние можно из настольной программы или другого мобильного устройства, подключенных к облаку'");
		Иначе
			ВызватьИсключение НСтр("ru='В облаке эта информационная база отмечена как устаревшая. 
				|Вернуть базу в рабочее состояние можно из другой базы или с мобильного устройства, подключенных к облаку'");
		КонецЕсли;
	КонецЕсли;
	
	Если СостояниеПодписки.ВсегоЛицензий <> -111 И СостояниеПодписки.СвободноЛицензий < 0 Тогда
		
		НеХватаетЛицензий = -СостояниеПодписки.СвободноЛицензий;
		ВызватьИсключение СтрШаблон(НСтр("ru='Для выполнения синхронизации не хватает лицензий (%1 шт.)'"), НеХватаетЛицензий);
		
	КонецЕсли;
	
КонецПроцедуры
 

// Возвращает состояние подписки на услугу для указанной информационной базы
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	ИмяУслуги - Строка - наименование услуги, заданное на сервере
//	КодИБ - Строка - код узла ЭтотУзел() в плане обмена СинхронизацияАвтономныхКопий
//
//Возвращаемое значение:
//	Структура - см. ДеньгиБиллинг.СостояниеПодпискиНаУслугу()
//
Функция СостояниеПодпискиНаУслугу(ИмяУслуги, КодИБ, КлючЛицензии = Неопределено) Экспорт

	Режим = РежимИспользованияПриложения();
	Если Режим = "КлиентОблака" Тогда
		Возврат ПолучитьСостояниеПодпискиИзОблака(ИмяУслуги, КодИБ, КлючЛицензии);
	ИначеЕсли Режим = "Разделенный" Тогда 
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДБиллинг");
		Возврат  Модуль.СостояниеПодпискиНаУслугу(ИмяУслуги, КодИБ, КлючЛицензии);
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(НСтр("ru='Режим работы ""%1"" не предполагает использование дополнительных лицензий'"), Режим);

КонецФункции

