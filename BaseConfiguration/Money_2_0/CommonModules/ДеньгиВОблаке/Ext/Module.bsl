	СтруктураПодключения.ПараметрыЗапроса.Вставить("ServerID",    ПараметрыПодключения.КодЦентральнойБазы);
	СтруктураПодключения.ПараметрыЗапроса.Вставить("NodeID",      ПараметрыПодключения.КодЭтогоУзла);

	Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("GET", СтруктураПодключения, 
