Процедура ПроверитьСценарииАвтономногоКлиента() Экспорт
	
	СинхронизацияАвтономныхКопий.УдалитьЛишниеРегламетныеЗадания();
	
	Режим = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	Если Режим = "Неразделенный" Или Режим = "Разделенный"  Тогда
		Возврат;
	КонецЕсли;
	
	УзелЦБ = СинхронизацияАвтономныхКопийВызовСервера.УзелЦентральнойБазы();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелЦБ", УзелЦБ);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СценарииОбменовДаннымиНастройкиОбмена.Ссылка КАК Ссылка,
	|	СценарииОбменовДаннымиНастройкиОбмена.Ссылка.РегламентноеЗаданиеGUID КАК РегламентноеЗаданиеGUID,
	|	СценарииОбменовДаннымиНастройкиОбмена.Ссылка.ТранспортОбменаДанными КАК ТранспортОбменаДанными
	|ИЗ
	|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК СценарииОбменовДаннымиНастройкиОбмена
	|ГДЕ
	|	СценарииОбменовДаннымиНастройкиОбмена.УзелИнформационнойБазы = &УзелЦБ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Сценарий  = ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
	ИспользоватьРегламентноеЗадание = Ложь; //(Режим = "КлиентОблака");
	Расписание = Справочники.СценарииОбменовДанными.РасписаниеРегламентногоЗаданияПоУмолчанию();
	Расписание.ПериодПовтораВТечениеДня = 120;
	
	Если ЗначениеЗаполнено(Сценарий) Тогда
		
		ОбъектСценария =  Сценарий.ПолучитьОбъект();
		ОбъектСценария.ИспользоватьРегламентноеЗадание = ИспользоватьРегламентноеЗадание;
		Отказ = Ложь;
		Справочники.СценарииОбменовДанными.ОбновитьДанныеРегламентногоЗадания(Отказ, Расписание, ОбъектСценария);
		Если Не Отказ И ОбъектСценария.Модифицированность() Тогда
			ОбъектСценария.Записать();
		КонецЕсли;
		
	Иначе
		
		Справочники.СценарииОбменовДанными.СоздатьСценарий(УзелЦБ, Расписание, ИспользоватьРегламентноеЗадание);
		
	КонецЕсли;
	
	ЗаписьНастройки = РегистрыСведений.НастройкиТранспортаОбменаДанными.СоздатьМенеджерЗаписи();
	ЗаписьНастройки.Корреспондент = УзелЦБ;
	ЗаписьНастройки.Прочитать();
	Если Не ЗаписьНастройки.Выбран() 
		Или ЗаписьНастройки.ВидТранспортаСообщенийОбменаПоУмолчанию <> Перечисления.ВидыТранспортаСообщенийОбмена.WS Тогда
		
		ЗаписьНастройки.Корреспондент = УзелЦБ;
		ЗаписьНастройки.ВидТранспортаСообщенийОбменаПоУмолчанию = Перечисления.ВидыТранспортаСообщенийОбмена.WS;
		ЗаписьНастройки.WSИспользоватьПередачуБольшогоОбъемаДанных = Истина;
		ЗаписьНастройки.WSЗапомнитьПароль = Истина;
		ЗаписьНастройки.FILEКаталогОбменаИнформацией = КаталогВременныхФайлов();
		ЗаписьНастройки.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывает исключение в случае некорркетного ответа сервера
// Используется для проверки ответов на метод POST execute
//
Процедура ПроверитьОтветСервера(СостояниеОбмена, ОтветСервера, ОписаниеОперации, Процесс) Экспорт
	
	Если ОтветСервера.КодСостояния <> 200 Тогда
		
		ЗаписьЖурналаРегистрации("Обмен данными.Синхронизация автономных копий." + Процесс, 
				УровеньЖурналаРегистрации.Ошибка,
				, 
				, 
				СтрШаблон("Ошибка выполнения операции ""%1"":
				|http-запрос к серверу вернул результат с кодом %2
				|и описанием: %3
				|", ОписаниеОперации, ОтветСервера.КодСостояния, ОтветСервера.ОписаниеОшибки));
		
		Если СостояниеОбмена <> Неопределено Тогда
			ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, 
					ОтветСервера.КодСостояния, 
					ОтветСервера.ОписаниеОшибки);
		КонецЕсли;
		
		ВызватьИсключение СтрШаблон(НСтр("ru='Ошибка процесса синхронизации ""%1"":
			|http-запрос завершился с кодом состояния %2 
			|описание: %3'"), Процесс, ОтветСервера.КодСостояния, ОтветСервера.ОписаниеОшибки);
	
	КонецЕсли;
	
	ТипОтвета = ТипЗнч(ОтветСервера.ОтветСервера);
	Если ТипОтвета <> Тип("Структура") И ТипОтвета <> Тип("ФиксированнаяСтруктура") Тогда
	
		ЗаписьЖурналаРегистрации("Обмен данными.Синхронизация автономных копий." + Процесс, 
				УровеньЖурналаРегистрации.Ошибка,
				, 
				, 
				СтрШаблон("Ошибка выполнения операции ""%1"":
				|http-запрос к серверу вернул результат с типом %2 вместо структуры
				|", ОписаниеОперации, ТипОтвета));
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось выполнить операцию ""%1"":
			|http-запрос вернул ответ некорректного типа %2 
			|описание: '"), ОписаниеОперации, ТипОтвета);
		Если СостояниеОбмена <> Неопределено Тогда
			ПроцессыОбменаСлужебный.ОтметитьСтатусТранспорта(СостояниеОбмена, 
					500, 
					ТекстСообщения);
		КонецЕсли;
		
		ВызватьИсключение ТекстСообщения;
	
	КонецЕсли;
	
КонецПроцедуры



