КонецФункции

// Изменяет пароль пользователя облачного приложения
//
//Параметры:
//	НовыйПароль - Строка - пароль, который нунжно установить
//	
//
//Возвращаемое значение:
//	Структура
//		* КодСостояния
//			* 200 - пароль изменен
//			* другое значение - ответ сервреа с заполнением параметра ОписаниеОшибки
//		* Логин
//		* Пароль
//
Функция СменитьПарольПользователяВОблаке(НовыйПароль, ТекущийПароль = Неопределено, Логин = Неопределено, ОписаниеОшибки = "") Экспорт

	ПараметрыПодключения = Неопределено;
	ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Истина);
	СтруктураПодключения = НовыйСтруктураЗапросаОбласти(ПараметрыПодключения, АдресСервисаБиллинга(), 
				"connectIB/changepass/" + ПараметрыПодключения.КодЭтогоУзла);
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ServerID",    ПараметрыПодключения.КодЦентральнойБазы);
	ПараметрыЗапроса.Вставить("newPassword", НовыйПароль);
	ПараметрыЗапроса.Вставить("password",    ?(ТекущийПароль = Неопределено, ПараметрыПодключения.Пароль, ТекущийПароль));
	ПараметрыЗапроса.Вставить("login",       ?(Логин = Неопределено, ПараметрыПодключения.Логин, Логин));
	
	СтруктураПодключения.Пароль = ПараметрыЗапроса.password;
	
	Для Счетчик = 1 По 3 Цикл
	
		Ответ    = RESTВызовСервера.РезультатHTTPЗапроса("POST", СтруктураПодключения, 
						ПарсерJSON.ДанныеВСтрокуJSON(ПараметрыЗапроса), 
						"Биллинг.Изменение свойств узла");
		ОписаниеОшибки = Ответ.ОписаниеОшибки;
		Если Ответ.КодСостояния = 200 Тогда
			Прервать;
		Иначе
			ОбщегоНазначенияДеньги.Пауза(2);
		КонецЕсли;
			
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Логин",        ПараметрыЗапроса.login);
	Результат.Вставить("Пароль",      ?(Ответ.КодСостояния = 200, НовыйПароль, ПараметрыЗапроса.password));
	
	Возврат Результат;

КонецФункции

// Возвращает структуру с информацией, достаточной для оформления подписки
//	Доступность: Облако, Автономная копия
//
//Параметры:
//	ТолькоДоступные - Булево - если Истина, в выводе останется только возможные тарифы и варианты подписок
//
//Возвращаемое значение:
//	Структура или Неопределено
//
Функция ТарифыДляПодписки(ТолькоДоступные = Ложь) Экспорт

	Режим = РежимИспользованияПриложения();
	Если Режим = "КлиентОблака" Тогда
		
		Возврат ПолучитьСписокТарифовИзОблака(ТолькоДоступные);
		
	ИначеЕсли Режим = "Разделенный" Тогда 
		
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОСДБиллинг");
		ТекстОшибки = "";
		Модуль.СписокТарифовДляПодписки(ТолькоДоступные, ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ДеньгиВОблакеВызовСервера.ЗарегистрироватьОшибкуВЖурнале(ТекстОшибки, "Получение списка тарифов");
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		Возврат Истина;
		
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(НСтр("ru='Режим работы ""%1"" не предполагает тарификацию облачных услуг'"), );

КонецФункции

