&НаКлиенте
Процедура Подключаемый_КонтактнаяИнформацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		МодульУправлениеКонтактнойИнформациейКлиент().ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, Элемент.Имя, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КонтактнаяИнформацияОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		МодульУправлениеКонтактнойИнформациейКлиент().НачатьОбработкуНавигационнойСсылки(ЭтотОбъект, Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ПродолжитьОбновлениеКонтактнойИнформации(Результат, ДополнительныеПараметры) Экспорт
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		ОбновитьКонтактнуюИнформацию(Результат);
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ОбновитьКонтактнуюИнформацию(Результат)
	
	// Обязательный обработчик подсистемы контактной информации
	Если Не ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("ИмяРеквизита")
		И Результат.ИмяРеквизита = "КонтактнаяИнформацияПолеЮрАдресОрганизации" Тогда
		
		ЗаполнитьПоАдресу();
		
	КонецЕсли;
	
	МодульУправлениеКонтактнойИнформацией().ОбновитьКонтактнуюИнформацию(ЭтотОбъект, Объект, Результат);
	АдресЗаполнен = АдресЗаполнен();
	Если Не АдресЗаполнен Тогда
		Элементы.КонтактнаяИнформацияПолеЮрАдресОрганизации.ЦветТекста = ЦветаСтиля.ЦветОтрицательногоЧисла;
	Иначе
		Элементы.КонтактнаяИнформацияПолеЮрАдресОрганизации.ЦветТекста = Новый Цвет();
	КонецЕсли;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.КонтактнаяИнформация


&НаСервере
Процедура ЗаполнитьПоАдресу()
		
	ОрганизацииФормыДляОтчетности.ЗаполнитьПоАдресу(
		Объект,
		Объект.КодПоОКТМО,
		ОрганизацииФормыДляОтчетностиКлиентСервер.АдресОрганизацииЗначениеJSON(КонтактнаяИнформацияОписаниеДополнительныхРеквизитов));
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	ИзменитьВидимостьРеквизитыИП(Форма);
	ИзменитьВидимостьПрочихГрупп(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьВидимостьРеквизитыИП(Форма) 
	
	ЭтоИП = ЗначениеЗаполнено(Форма.Объект.КатегорияПлательщикаНДФЛ) 
			И Форма.Объект.КатегорияПлательщикаНДФЛ <> ПредопределенноеЗначение("Перечисление.КатегорииНалогоплательщикаНДФЛ.НеПредприниматель");
	ВидимостьИП = ЭтоИП И (Не ЗначениеЗаполнено(Форма.РедактируемыеГруппы) Или Форма.РедактируемыеГруппы.Найти("РеквизитыИП") <> Неопределено);
	Если ВидимостьИП Тогда
		Форма.ДопРеквизитыФормы.ОбязательныеРеквизиты = Форма.ДопРеквизитыФормы.ОбязательныеРеквизитыПредпринимателя;
	Иначе
		Форма.ДопРеквизитыФормы.ОбязательныеРеквизиты = Форма.ДопРеквизитыФормы.ОбязательныеРеквизитыФизлица;
	КонецЕсли;
	
	Если ВидимостьИП И Форма.ТолькоНеЗаполненное Тогда
		ВидимостьИП = Не ЗначениеЗаполнено(Форма.Объект.ОГРН) 
					Или Не ЗначениеЗаполнено(Форма.Объект.ДатаРегистрации)
					Или Не ЗначениеЗаполнено(Форма.Объект.КодПоОКПО);
	КонецЕсли;
	
	Форма.Элементы.РеквизитыИП.Видимость                     = ВидимостьИП;
	Форма.Элементы.ИНН.АвтоотметкаНезаполненного             = Истина;
	Форма.Элементы.ОГРН.АвтоотметкаНезаполненного            = ВидимостьИП;
	Форма.Элементы.ДатаРегистрации.АвтоотметкаНезаполненного = ВидимостьИП;
	Форма.Элементы.КодПоОКПО.АвтоотметкаНезаполненного       = ВидимостьИП;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьВидимостьПрочихГрупп(форма)
	
	Форма.ДопРеквизитыФормы.ОбязательныеРеквизиты.Очистить();
	ГруппыФормы = Форма.РедактируемыеГруппы;
	ГруппыНеЗаданы = Не ЗначениеЗаполнено(Форма.РедактируемыеГруппы);
	СписокГрупп = СтрРазделить("ФИОНалогоплательщика,ДатаИМестоРождения,УдостоверениеЛичности,РегистрацияНалогоплательщика,МестонахождениеИНалоговаяИнспекция,БанковскийСчет",",");
	Для каждого ИмяГруппы Из СписокГрупп Цикл
		
		ВидимостьГруппы = ГруппыНеЗаданы Или ГруппыФормы.Найти(ИмяГруппы) <> Неопределено; 
		Если ВидимостьГруппы И Форма.ТолькоНеЗаполненное Тогда
			ВидимостьГруппы = ВГруппеЕстьНезаполненныеЭлементы(Форма, ИмяГруппы);
		КонецЕсли;
		
		Форма.Элементы[ИмяГруппы].Видимость = ВидимостьГруппы;
		ИзменитьАвтозаполнениеЭлементовГруппы(Форма, ИмяГруппы, ВидимостьГруппы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СписокПолейГруппы(ИмяГруппы)
	
	Результат = Новый Массив;
	КлючиСтруктуры = "Путь,Заголовок,Элемент,БезАвтоотметки";
	
	Если ИмяГруппы = "ФИОНалогоплательщика" Тогда
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ФамилияИП", "Фамилия", "ФамилияИП"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ИмяИП", "Имя", "ИмяИП"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ПолФизическогоЛица", "Пол", "ПолФизическогоЛица"));
		
	ИначеЕсли ИмяГруппы = "ДатаИМестоРождения" Тогда
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ДатаРождения", "Дата рождения", "ДатаРождения"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.МестоРождения", "Место рождения", "МестоРождения"));
		
	ИначеЕсли ИмяГруппы = "УдостоверениеЛичности" Тогда
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.КодВидаДокумента", "Вид документа", "ДокументКодВида"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ДокументСерияНомер", "Серия и №", "ДокументСерияНомер"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ДокументДатаВыдачи", "Дата выдачи", "ДокументДатаВыдачи"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.ДокументМестоВыдачи", "Место выдачи", "ДокументМестоВыдачи"));
		
	ИначеЕсли ИмяГруппы = "РегистрацияНалогоплательщика" Тогда
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.КатегорияПлательщикаНДФЛ", "Категория", "КатегорияПлательщикаНДФЛ"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.Гражданство", "Гражданство", "Гражданство"));
		
	ИначеЕсли ИмяГруппы = "МестонахождениеИНалоговаяИнспекция" Тогда
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "КонтактнаяИнформацияПолеТелефонОрганизации", "Телефон", "КонтактнаяИнформацияПолеТелефонОрганизации"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "КонтактнаяИнформацияПолеЮрАдресОрганизации", "Место жительства", "КонтактнаяИнформацияПолеЮрАдресОрганизации"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.КодПоОКТМО", "Код по ОКТМО", "КодПоОКТМО"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "Объект.КодНалоговогоОргана", "Налоговая инспекция", "КодНалоговогоОргана"));
		
	ИначеЕсли ИмяГруппы = "БанковскийСчет" Тогда
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "БанковскийСчетВидСчета", "Вид счета", "БанковскийСчетВидСчета"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "БанковскийСчетНомерСчета", "Номер счета", "БанковскийСчетНомерСчета"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "БанковскийСчетБИК", "БИК", "БанковскийСчетБИК"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "БанковскийСчетКоррсчет", "Кор.счет банка", "БанковскийСчетКоррсчет"));
		Результат.Добавить(Новый Структура(КлючиСтруктуры, "БанковскийСчетНаименованиеБанка", "Наименование банка", "БанковскийСчетНаименованиеБанка"));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеПоляИлиРеквизитаФормы(Форма, СвойстваПоля)
	
	Если Лев(СвойстваПоля.Путь,7) = "Объект." Тогда
		Возврат Форма.Объект[Сред(СвойстваПоля.Путь, 8)];
	Иначе
		Возврат Форма[СвойстваПоля.Путь];
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВГруппеЕстьНезаполненныеЭлементы(Форма, ИмяГруппы)
	
	СписокПолейГруппы = СписокПолейГруппы(ИмяГруппы);
	Для каждого Поле Из СписокПолейГруппы Цикл
		Если Не ЗначениеЗаполнено(ЗначениеПоляИлиРеквизитаФормы(Форма, Поле)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция КопияСтруктуры(Структура)
	
	Возврат ОбщегоНазначения.СкопироватьРекурсивно(Структура);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьАвтозаполнениеЭлементовГруппы(Форма, ИмяГруппы, ВидимостьГруппы)
	
	Если ИмяГруппы = "БанковскийСчет" И (Не ЗначениеЗаполнено(Форма.ОбязательныеГруппы)
			Или Форма.ОбязательныеГруппы.Найти(ИмяГруппы) = Неопределено)
		Тогда
		Возврат;
	КонецЕсли;
	
	СписокПолейГруппы = СписокПолейГруппы(ИмяГруппы);
	Исключения = "КонтактнаяИнформацияПолеЮрАдресОрганизации,";
	Для каждого Поле Из СписокПолейГруппы Цикл
		Если Не СтрНайти(Исключения, Поле.Элемент + ",") > 0 Тогда
			Форма.Элементы[Поле.Элемент].АвтоотметкаНезаполненного = ВидимостьГруппы;
		КонецЕсли;
		Если ВидимостьГруппы Тогда
			Форма.ДопРеквизитыФормы.ОбязательныеРеквизиты.Добавить(КопияСтруктуры(Поле));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция АдресЗаполнен()
	
	Возврат ЗначениеЗаполнено(
			ОрганизацииФормыДляОтчетностиКлиентСервер.АдресОрганизацииЗначениеJSON(
					КонтактнаяИнформацияОписаниеДополнительныхРеквизитов));
	
КонецФункции

#КонецОбласти
