
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроверитьДопРеквизитыФормы();
	
	ОбязательныеГруппы  = ?(ЗначениеЗаполнено(Параметры.ОбязательныеГруппы), 
				Новый ФиксированныйМассив(Параметры.ОбязательныеГруппы), Неопределено);
	РедактируемыеГруппы = ?(ЗначениеЗаполнено(Параметры.РедактируемыеГруппы),
				Новый ФиксированныйМассив(Параметры.РедактируемыеГруппы), Неопределено);
	ТолькоНеЗаполненное = Параметры.ТолькоНеЗаполненное;
	
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		
		МодульУправлениеКонтактнойИнформацией = МодульУправлениеКонтактнойИнформацией();
		ИсключаемыеВиды = Новый Массив();
		ИсключаемыеВиды.Добавить(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ИсключаемыеВиды.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		
		ПараметрыРазмещенияКонтактнойИнформации = МодульУправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
		ПараметрыРазмещенияКонтактнойИнформации.ИмяЭлементаДляРазмещения = "КонтактныеДанные";
		ПараметрыРазмещенияКонтактнойИнформации.ИсключаемыеВиды = ИсключаемыеВиды;
		ПараметрыРазмещенияКонтактнойИнформации.ОтложеннаяИнициализация = Истина;
		
		МодульУправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, ПараметрыРазмещенияКонтактнойИнформации);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ПояснениеНекорректныйКодПоОКТМО = ОрганизацииФормыДляОтчетностиКлиентСервер.ПроверитьКодПоОКТМО(КодПоОКТМО);
		
		// ДЕНЬГИ 
		Если Не ЗначениеЗаполнено(Объект.КодВидаДокумента) Тогда
			Объект.КодВидаДокумента = "21";
		КонецЕсли;
		// конец ДЕНЬГИ
		
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПроверитьДопРеквизитыФормы();
	
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		// СтандартныеПодсистемы.КонтактнаяИнформация
		МодульУправлениеКонтактнойИнформацией().ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
		// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	КонецЕсли;
	
	ПрочитатьБанковскийСчет();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		// СтандартныеПодсистемы.КонтактнаяИнформация
		МодульКИ = МодульУправлениеКонтактнойИнформацией();
		МодульКИ.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, Объект, Отказ);
		// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	Если ЗначениеЗаполнено(ДопРеквизитыФормы.ОбязательныеРеквизиты) Тогда
		Для каждого ОписаниеРеквизита Из ДопРеквизитыФормы.ОбязательныеРеквизиты Цикл
			
			Если ОписаниеРеквизита.Путь = "КонтактнаяИнформацияПолеЮрАдресОрганизации" Тогда
				
				Если Не АдресЗаполнен() Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Поле",
						"Заполнение",
						ОписаниеРеквизита.Заголовок);
						
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстСообщения,
						Неопределено,// КлючДанных
						,//Поле
						ОписаниеРеквизита.Путь,// ПутьКДанным
						ЕстьОшибки);
				КонецЕсли;
				
				 
				Продолжить;
			КонецЕсли;
			
			Если Лев(ОписаниеРеквизита.Путь,7) = "Объект." Тогда
				ЗначениеРквизита = Объект[Сред(ОписаниеРеквизита.Путь, 8)];
			Иначе
				ЗначениеРквизита = ЭтотОбъект[ОписаниеРеквизита.Путь];
			КонецЕсли;
			 
			Если Не ЗначениеЗаполнено(ЗначениеРквизита) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Поле",
					"Заполнение",
					ОписаниеРеквизита.Заголовок);
					
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстСообщения,
					Неопределено,// КлючДанных
					,//Поле
					ОписаниеРеквизита.Путь,// ПутьКДанным
					ЕстьОшибки);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Отказ = ЕстьОшибки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) Тогда
		Объект.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Гражданство) Тогда
		Объект.Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СтранаРегистрации) Тогда
		Объект.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КатегорияПлательщикаНДФЛ) Тогда
		Объект.КатегорияПлательщикаНДФЛ = ПредопределенноеЗначение("Перечисление.КатегорииНалогоплательщикаНДФЛ.НеПредприниматель");
	КонецЕсли;

	Объект.Наименование = СокрЛП(СокрЛП(СокрЛП(Объект.ФамилияИП) + " " 
			+ СокрЛП(Объект.ИмяИП) + " " + СокрЛП(Объект.ОтчествоИП)));
	Объект.НаименованиеПолное = Объект.Наименование;
	Объект.НаименованиеСокращенное = СокрЛП(Объект.ФамилияИП) 
			+ ?(ПустаяСтрока(Объект.ИмяИП), "", " " + Врег(Лев(СокрЛП(Объект.ИмяИП), 1)) + "."
					+ ?(ПустаяСтрока(Объект.ОтчествоИП), "", Врег(Лев(СокрЛП(Объект.ОтчествоИП), 1))) + ".");
	Если Объект.КатегорияПлательщикаНДФЛ <> ПредопределенноеЗначение("Перечисление.КатегорииНалогоплательщикаНДФЛ.НеПредприниматель") Тогда
		Объект.НаименованиеПолное = "ИПбОЮЛ " + Объект.НаименованиеПолное;
		Объект.НаименованиеСокращенное = "ИП " + Объект.НаименованиеСокращенное;
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьБанковскийСчет(ТекущийОбъект);
	
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		МодульУправлениеКонтактнойИнформацией().ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_Организация", Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ДопРеквизитыФормы.ЕстьПодсистемаКИ Тогда
		// СтандартныеПодсистемы.КонтактнаяИнформация
		МодульУправлениеКонтактнойИнформацией().ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
		// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолФизическогоЛицаПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Объект.ПолФизическогоЛица) Тогда
		Объект.ПолФизическогоЛица = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КатегорияПлательщикаНДФЛПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Объект.КатегорияПлательщикаНДФЛ) Тогда
		Объект.КатегорияПлательщикаНДФЛ = ПредопределенноеЗначение("Перечисление.КатегорииНалогоплательщикаНДФЛ.НеПредприниматель");
	КонецЕсли;
	ИзменитьВидимостьРеквизитыИП(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПолеТелефонОрганизацииПриИзменении(Элемент)
	
	УправлениеКонтактнойИнформациейКлиент.НачатьИзменение(ЭтотОбъект, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПолеЮрАдресОрганизацииНажатие(Элемент, СтандартнаяОбработка)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Заголовок", НСтр("ru = 'Адрес места жительства'"));
	
	УправлениеКонтактнойИнформациейКлиент.НачатьВыбор(ЭтотОбъект, Элемент, Модифицированность, СтандартнаяОбработка, ПараметрыОткрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура КодПоОКТМОПриИзменении(Элемент)
	
	ПояснениеНекорректныйКодПоОКТМО = ОрганизацииФормыДляОтчетностиКлиентСервер.ПроверитьКодПоОКТМО(КодПоОКТМО);
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьДопРеквизитыФормы()
	
	Если ДопРеквизитыФормы <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизитыФормы = Новый Структура;
	ДопРеквизитыФормы.Вставить("ЕстьПодсистемаКИ", 
			ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КонтактнаяИнформация"));
	ДопРеквизитыФормы.Вставить("ОбязательныеРеквизиты", Новый Массив);
	
	ДопРеквизитыФормы.Вставить("ОбязательныеРеквизитыПредпринимателя", Новый Массив);
	ДопРеквизитыФормы.ОбязательныеРеквизитыПредпринимателя.Добавить(Новый Структура("Путь,Заголовок", "Объект.ИНН", "ИНН"));
	ДопРеквизитыФормы.ОбязательныеРеквизитыПредпринимателя.Добавить(Новый Структура("Путь,Заголовок", "Объект.ОГРН", "ОГРНИП"));
	ДопРеквизитыФормы.ОбязательныеРеквизитыПредпринимателя.Добавить(Новый Структура("Путь,Заголовок", "Объект.ДатаРегистрации", "ДатаРегистрации"));
	ДопРеквизитыФормы.ОбязательныеРеквизитыПредпринимателя.Добавить(Новый Структура("Путь,Заголовок", "Объект.КодПоОКПО", "ОКПО"));
	
	ДопРеквизитыФормы.Вставить("ОбязательныеРеквизитыФизлица", Новый Массив);
	ДопРеквизитыФормы.ОбязательныеРеквизитыФизлица.Добавить(Новый Структура("Путь,Заголовок", "Объект.ИНН", "ИНН"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция МодульУправлениеКонтактнойИнформацией()
	Возврат ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформацией");
КонецФункции

&НаКлиенте
Функция МодульУправлениеКонтактнойИнформациейКлиент()
	Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеКонтактнойИнформациейКлиент");
КонецФункции

&НаСервере
Процедура ПрочитатьБанковскийСчет()
	
	Если Объект.БанковскиеРеквизиты.Количество() > 0 Тогда
		СтрокаСчета = Объект.БанковскиеРеквизиты[0];
		БанковскийСчетВидСчета           = СтрокаСчета.ВидСчета;
		БанковскийСчетНомерСчета         = СтрокаСчета.НомерСчета;
		БанковскийСчетБИК                = СтрокаСчета.БИК;
		БанковскийСчетКоррсчет           = СтрокаСчета.КоррСчет;
		БанковскийСчетНаименованиеБанка  = СтрокаСчета.НаименованиеБанка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьБанковскийСчет(ТекущийОбъект)
	
	Если ПустаяСтрока(БанковскийСчетНомерСчета + БанковскийСчетБИК
			+БанковскийСчетКоррсчет + БанковскийСчетНаименованиеБанка) Тогда
		ТекущийОбъект.БанковскиеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ТекущийОбъект.БанковскиеРеквизиты.Количество() = 0 Тогда
		ТекущийОбъект.БанковскиеРеквизиты.Добавить();
	КонецЕсли;
	СтрокаСчета = ТекущийОбъект.БанковскиеРеквизиты[0];
	СтрокаСчета.ВидСчета          = БанковскийСчетВидСчета;
	СтрокаСчета.НомерСчета        = БанковскийСчетНомерСчета;
	СтрокаСчета.БИК               = БанковскийСчетБИК;
	СтрокаСчета.КоррСчет          = БанковскийСчетКоррсчет;
	СтрокаСчета.НаименованиеБанка = БанковскийСчетНаименованиеБанка;
	
	СтрокаСчета.ПредсталвениеСчета = ?(ЗначениеЗаполнено(СтрокаСчета.НомерСчета), 
						"*" + Прав(СокрП(СтрокаСчета.НомерСчета), 4), НСтр("ru='нет номера'"))
			+ " " + ?(ЗначениеЗаполнено(СтрокаСчета.НаименованиеБанка), 
						СокрЛП(СтрокаСчета.НаименованиеБанка), НСтр("ru='банк не указан'"))
	
КонецПроцедуры


