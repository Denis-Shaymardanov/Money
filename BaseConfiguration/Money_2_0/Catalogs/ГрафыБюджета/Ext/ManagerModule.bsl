#Область СлужебныйПрограммныйИнтерфейс

// Начальное заполнение элементов справочника. Вызывается при обновлении ИБ
//
Процедура ПриНачальномЗаполненииЭлементов() Экспорт
	
	Режим = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	Если Режим = "Разделенный" Тогда
		// на сервере - только для неразделенного режима
		Возврат;
	КонецЕсли;
	
	ОбновитьРеквизитыПредопределенныхЭлементов();
	
	
КонецПроцедуры


#КонецОбласти


#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("Отбор") Тогда
		Параметры.Вставить("Отбор", Новый Структура);
	КонецЕсли;
	
	Если Не Параметры.Отбор.Свойство("ПометкаУдаления") Тогда
		Параметры.Отбор.Вставить("ПометкаУдаления", Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ВспомогательныйФункционал

Функция ОбъектПредопределенногоЭлемента(ИмяПредопределенного, Наименование)
	
	Ссылка = ОбслуживаниеСправочников.ПровереннаяСсылкаПредопределенного(Справочники.ГрафыБюджета, 
			ИмяПредопределенного, 
			Наименование, 
			Ложь, 
			Неопределено);
			
	Возврат Ссылка.ПолучитьОбъект();
	
КонецФункции

#КонецОбласти


#КонецЕсли

