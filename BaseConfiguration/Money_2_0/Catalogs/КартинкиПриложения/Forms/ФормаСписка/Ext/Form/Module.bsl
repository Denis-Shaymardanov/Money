КонецФункции

&НаКлиенте
Процедура ОбработатьНажатиеИндикатора(ИД)
	
	Имена = СтрРазделить(ИД, ".", Ложь);
	
	СтрокиКартинки = ТаблицаКартинок.НайтиСтроки(Новый Структура("ИДНаСтранице", Имена[0]));
	Если Не ЗначениеЗаполнено(СтрокиКартинки) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаКартинки = СтрокиКартинки[0];
	Если ВРежимеВыбора Тогда
		ОповеститьОВыборе(СтрокаКартинки.Ссылка);
		Если Открыта() Тогда
			Закрыть(СтрокаКартинки.Ссылка);
		КонецЕсли;
	Иначе
		
		ОткрытьФорму("Справочник.КартинкиПриложения.ФормаОбъекта", 
					Новый Структура("Ключ", СтрокаКартинки.Ссылка),
					ЭтотОбъект,
					СтрокаКартинки.Ссылка)
		
	КонецЕсли;
	
КонецПроцедуры


