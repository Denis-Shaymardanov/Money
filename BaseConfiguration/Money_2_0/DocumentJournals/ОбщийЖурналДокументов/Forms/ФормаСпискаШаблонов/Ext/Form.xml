				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ВЫБОР
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.Расход
			ТОГДА 9
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.Доход
			ТОГДА 6
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.УниверсальнаяОперация
			ТОГДА 30
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.Перемещение
			ТОГДА 12
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.МыДалиВДолг
			ТОГДА 18
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.НамВернулиДолг
			ТОГДА 21
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.МыВзялиВДолг
			ТОГДА 24
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.МыВернулиДолг
			ТОГДА 27
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.ОбменВалюты
			ТОГДА 15
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Ссылка ССЫЛКА Документ.ВводИзменениеОстатка
			ТОГДА 33
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА ЖурналДокументовОбщийЖурналДокументов.Проведен
				ИЛИ ЖурналДокументовОбщийЖурналДокументов.ЭтоШаблон
			ТОГДА 1
		КОГДА ЖурналДокументовОбщийЖурналДокументов.ПометкаУдаления
			ТОГДА 2
		ИНАЧЕ 0
	КОНЕЦ КАК ИндексКартинки,
	ЖурналДокументовОбщийЖурналДокументов.Ссылка,
	ЖурналДокументовОбщийЖурналДокументов.Дата,
	ЖурналДокументовОбщийЖурналДокументов.ПометкаУдаления,
	ЖурналДокументовОбщийЖурналДокументов.Проведен,
	ЖурналДокументовОбщийЖурналДокументов.СуммаПоступления,
	ЖурналДокументовОбщийЖурналДокументов.ВалютаПоступления,
	ЖурналДокументовОбщийЖурналДокументов.СуммаСписания,
	ЖурналДокументовОбщийЖурналДокументов.ВалютаСписания,
	ВЫРАЗИТЬ(ЖурналДокументовОбщийЖурналДокументов.ОписаниеОперации КАК СТРОКА(1000)) КАК ОписаниеОперации,
	ЖурналДокументовОбщийЖурналДокументов.ЭтоШаблон,
	ЖурналДокументовОбщийЖурналДокументов.Комментарий,
	ЖурналДокументовОбщийЖурналДокументов.Пользователь,
	ЖурналДокументовОбщийЖурналДокументов.Тип,
	ЕСТЬNULL(Расписания.ОписаниеРасписания, "") КАК ОписаниеРасписания,
	НЕ ЕСТЬNULL(Расписания.Периодичность, ЗНАЧЕНИЕ(Перечисление.СпособыПовторовСобытий.НеИспользовать)) В (ЗНАЧЕНИЕ(Перечисление.СпособыПовторовСобытий.НеИспользовать), ЗНАЧЕНИЕ(Перечисление.СпособыПовторовСобытий.ПустаяСсылка)) КАК ЕстьРасписание,
	ЕСТЬNULL(ДатыРасписаний.ПлановаяДата, ДАТАВРЕМЯ(1, 1, 1)) КАК ПлановаяДата,
	ВЫБОР
		КОГДА ЕСТЬNULL(АктуальныеДаты.ПлановаяОперация.Дата, АктуальныеДаты.АктуальнаяДата) = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ЕСТЬNULL(ДатыРасписаний.ПлановаяДата, ДАТАВРЕМЯ(1, 1, 1))
		ИНАЧЕ ЕСТЬNULL(АктуальныеДаты.ПлановаяОперация.Дата, АктуальныеДаты.АктуальнаяДата)
	КОНЕЦ КАК АктуальнаяДата,
	ЕСТЬNULL(АктуальныеДаты.СуммаДолга, 0) КАК СуммаДолга,
	ЕСТЬNULL(АктуальныеДаты.СуммаПроцентов, 0) КАК СуммаПроцентов,
	ЕСТЬNULL(АктуальныеДаты.СуммаКомиссии, 0) КАК СуммаКомиссии,
	НЕ ЖурналДокументовОбщийЖурналДокументов.ПометкаУдаления
		И НЕ Расписания.НеИспользовать КАК Активность
ИЗ
	ЖурналДокументов.ОбщийЖурналДокументов КАК ЖурналДокументовОбщийЖурналДокументов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Расписания КАК Расписания
		ПО ЖурналДокументовОбщийЖурналДокументов.Ссылка = Расписания.ВладелецРасписания
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ДатыРасписаний.ВладелецРасписания КАК ВладелецРасписания,
			МИНИМУМ(ДатыРасписаний.ПлановаяДата) КАК ПлановаяДата
		ИЗ
			РегистрСведений.ДатыРасписаний КАК ДатыРасписаний
		ГДЕ
			ДатыРасписаний.ВладелецРасписания.ПометкаУдаления = ЛОЖЬ
			И ДатыРасписаний.Пропустить = ЛОЖЬ
			И ЕСТЬNULL(ДатыРасписаний.ПлановаяОперация.Проведен, ЛОЖЬ) = ЛОЖЬ
			И ЕСТЬNULL(ДатыРасписаний.ПлановаяОперация.ПометкаУдаления, ЛОЖЬ) = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			ДатыРасписаний.ВладелецРасписания) КАК ДатыРасписаний
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыРасписаний КАК АктуальныеДаты
			ПО ДатыРасписаний.ВладелецРасписания = АктуальныеДаты.ВладелецРасписания
				И ДатыРасписаний.ПлановаяДата = АктуальныеДаты.ПлановаяДата
		ПО ЖурналДокументовОбщийЖурналДокументов.Ссылка = ДатыРасписаний.ВладелецРасписания
			И (ЖурналДокументовОбщийЖурналДокументов.ПометкаУдаления = ЛОЖЬ)
ГДЕ
	ЖурналДокументовОбщийЖурналДокументов.ЭтоШаблон</QueryText>
