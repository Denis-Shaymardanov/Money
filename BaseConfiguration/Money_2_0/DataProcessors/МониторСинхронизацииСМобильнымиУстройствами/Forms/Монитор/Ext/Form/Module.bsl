#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантАктивности = "ВсеУстройства";
	
	ПроверитьНачальноеВключениеОбменаДанными();
	
	УстановитьПараметрыСпискаУстройств();
	
	ОбновитьВсеНаСервере();
	
	ОбновитьЭлементыФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроверитьОбработчикиОбновления();
КонецПроцедуры


&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	Если Настройки["ВариантАктивности"] <> Неопределено Тогда
		ВариантАктивности = Настройки["ВариантАктивности"];
		УстановитьУсловиеАктивностиВСпискеУстройств();
		ОбновитьГруппуСпискаМобильныхУстройств(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыполненОбменДанными" Тогда
		ОтключитьОбработчикОжидания("Подключаемый_ОбновитьСостояниеОбмена");
		ОбновитьВсеНаСервере();
		ПроверитьОбработчикиОбновления(Истина);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СинхронизацияВключенаПриИзменении(Элемент)
	ПереключитьИспользованиеОбменаВКонфигурации(СинхронизацияВключена);
	ОбновитьЭлементыФормы(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьСинхронизацию(Команда)
	#Область ПоказатьВопрос
	ТекстВопроса = НСтр("ru='Выключить синхронизацию на этом компьютере?'");
	
	ДополнительныеПараметры = Новый Структура;
	Оповещение = Новый ОписаниеОповещения("ВыключитьСинхронизациюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Выключить'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, Заголовок);
	#КонецОбласти
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьСинхронизациюЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СинхронизацияВключена = Ложь;
	ВыключитьСинхронизациюСервер();
	ОбновитьИнтерфейс();
	Оповестить("ИзмененаСинхронизация");
	
	Если Открыта() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыключитьСинхронизациюСервер()
	
	Если Не ОбщегоНазначения.РазделениеВключено() Тогда 
		Константы.ИспользоватьСинхронизациюДанных.Установить(Ложь);
	КонецЕсли;
	
	// Выбор способа устанавливает функциональные опции
	Константы.ДеньгиВыбранныйСпособСинхронизации.Установить(Перечисления.СпособыСинхронизацииДанных.НеИспользовать);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьДомашнююСетьПриИзменении(Элемент)
	ПереключитьИспользованиеДомашнейСетиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьФайловыйСервисПриИзменении(Элемент)
	ПереключитьИспользованиеФайловогоСервисаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриостановитьСинхронизациюПриИзменении(Элемент)
	
	Если ПриостановитьСинхронизацию Тогда
		АктивныеЗадания = ФоновоеЗаданиеОбмена();
	КонецЕсли;
	
	Если ПриостановитьСинхронизацию И АктивныеЗадания <> Неопределено Тогда
		
		#Область ПоказатьВопрос
		ТекстВопроса = НСтр("ru='Обмен файлами выполняется в данный момент в автоматическом режиме
				|Отменить этот обмен файлами?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьПрекращениеОбмена_Завершение", ЭтотОбъект, АктивныеЗадания);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Прекратить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да,);
		#КонецОбласти
		
	Иначе
		ПриостановитьСинхронизациюСервер(Ложь);
		ПроверитьОбработчикиОбновления(Истина);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти


#Область ОбработчикиТаблицы_СписокУстройств

&НаКлиенте
Процедура СписокУстройствВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуУстройства(Элемент.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СписокУстройствПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	
	Отказ = Истина;
	ПоказатьПредупреждение(, НСтр("ru='Добавление мобильных устройств происходит автоматически при первом получении данных от нового устройства'") );
	
КонецПроцедуры


#КонецОбласти 


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьВсеНаСервере();
	ОбновитьЭлементыФормы(ЭтотОбъект);
	ПроверитьОбработчикиОбновления();
КонецПроцедуры


&НаКлиенте
Процедура АвтосинхронизацияВключить(Команда)
	ВключитьАвтоСинхронизациюКлиент();
КонецПроцедуры

&НаКлиенте
Процедура АвтосинхронизацияКакИспользовать(Команда)
	ПоказатьТекстДокументации("АвтоматическаяСинхронизация");
КонецПроцедуры

&НаКлиенте
Процедура ДомашняяСетьКакИспользовать(Команда)
	ПоказатьТекстДокументации("ИспользованиеДомашнейСети");
КонецПроцедуры

&НаКлиенте
Процедура ДомашняяСетьНастройки(Команда)
	ОткрытьНастройкуДомашнейСети();
КонецПроцедуры

&НаКлиенте
Процедура ФайловыйСервисКакИспользовать(Команда)
	ПоказатьТекстДокументации("ИспользованиеОблачногоСервиса");
КонецПроцедуры

&НаКлиенте
Процедура ФайловыйСервисНастройки(Команда)
	ОткрытьНастройкуФайловогоСервиса();
КонецПроцедуры

&НаКлиенте
Процедура ФайловыйСервисСинхронизировать(Команда)
	ОткрытьОбменЧерезОблачногоПровайдера();
КонецПроцедуры

&НаКлиенте
Процедура ВсеУстройства(Команда)
	ВариантАктивности = Команда.Имя;
	УстановитьУсловиеАктивностиВСпискеУстройств();
	ОбновитьГруппуСпискаМобильныхУстройств(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТолькоАктивные(Команда)
	ВариантАктивности = Команда.Имя;
	УстановитьУсловиеАктивностиВСпискеУстройств();
	ОбновитьГруппуСпискаМобильныхУстройств(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТолькоОтключенные(Команда)
	ВариантАктивности = Команда.Имя;
	УстановитьУсловиеАктивностиВСпискеУстройств();
	ОбновитьГруппуСпискаМобильныхУстройств(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	ЗагрузитьДанныеИзфайлаКлиент();
КонецПроцедуры

&НаКлиенте
Процедура ПометитьВсеЗаписиКОтправке(Команда)
	ТекущиеДанные = Элементы.СписокУстройств.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПометитьВсеЗаписиКОтправкеНаСервере(ТекущиеДанные.Ссылка);
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции


#Область Обновление_данных

&НаКлиенте
Процедура ПроверитьОбработчикиОбновления(ОбновитьВручную = Ложь)

	Если Не ПриостановитьСинхронизацию Или ОбновитьВручную Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСостояниеОбмена", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСостояниеОбмена()
	
	Если Не ВводДоступен() Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСостояниеОбмена", 1, Истина);
		Возврат;
	КонецЕсли;
	
	ОбновитьСостояниеПроцессов();
	
	Если Не ПриостановитьСинхронизацию Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСостояниеОбмена", 10, Истина);
	КонецЕсли;
	
КонецПроцедуры

// Если обмен еще не использовался, включаем его авторматически
&НаСервере
Процедура ПроверитьНачальноеВключениеОбменаДанными()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ МобильноеПриложение.Ссылка) КАК Количество
	|ИЗ
	|	ПланОбмена.МобильноеПриложение КАК МобильноеПриложение
	|ГДЕ
	|	НЕ МобильноеПриложение.ЭтотУзел";
	Выборка = Запрос.Выполнить().Выбрать();
	ПланОбменаИспользуется = Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Количество);
	
	Если Не СинхронизацияВключена И Не ПланОбменаИспользуется Тогда
		// в плане обмена еще нет ни одного узла - значит вручную обмен не выключали
		ПереключитьИспользованиеОбменаВКонфигурации(Истина);
		СинхронизацияВключена = ПолучитьФункциональнуюОпцию("ИспользоватьСинхронизациюДанных");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеНаСервере()
	
	СинхронизацияВключена = ПолучитьФункциональнуюОпцию("ИспользоватьСинхронизациюДанных");
	ОбновитьПараметрыДомашнейСети();
	ОбновитьПараметрыОблачногоПровайдера();
	ОбновитьСостояниеПроцессов();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСпискаУстройств()
	
	УстановитьУсловиеАктивностиВСпискеУстройств();
	
	ВсеКоды = ПроцессыОбменаПовтИсп.ВсеКодыРезультатовДействий();
	СписокУстройств.Параметры.УстановитьЗначениеПараметра ("КодУспеха", ВсеКоды.Выполнено.Код);
	
	КодыОшибок = Новый Массив;
	Для Каждого ЭлементКода Из ВсеКоды Цикл
		Если ЭлементКода.Значение.ЯвляетсяОшибкой Тогда
			КодыОшибок.Добавить(ЭлементКода.Значение.Код);
		КонецЕсли;
	КонецЦикла;
	СписокУстройств.Параметры.УстановитьЗначениеПараметра ("КодыОшибок", КодыОшибок);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловиеАктивностиВСпискеУстройств()
	
	СписокУстройств.Параметры.УстановитьЗначениеПараметра ("Активность", 
			?(ВариантАктивности = "ВсеУстройства", Неопределено, ВариантАктивности = "ТолькоАктивные"));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыДомашнейСети()
	
	ПараметрыДомашняяСеть = Справочники.ТранспортыОбменаДанными.СтруктураПараметровТранспорта(Справочники.ТранспортыОбменаДанными.ОсновнойТранспортДомашнейСети());
	ИспользоватьДомашнююСеть = Не ПараметрыДомашняяСеть.ЗапретитьИспользование;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыОблачногоПровайдера()
	
	СвойстваАккаунта = Неопределено;
	ОблачныйПровайдер = RESTСлужебныйВызовСервера.ПровайдерИзПараметраСеанса(СвойстваАккаунта);
	ПараметрыОблачногоХранилищаФайлов = Справочники.ТранспортыОбменаДанными.СтруктураПараметровТранспорта(Справочники.ТранспортыОбменаДанными.ОсновнойТранспортОблачногоПровайдера(ОблачныйПровайдер), Истина);
	ПараметрыОблачногоХранилищаФайлов.Вставить("СвойстваАккаунта", СвойстваАккаунта);
	ПараметрыЦентральнойБазы = ОбменМобильноеПриложение.ПараметрыЦентральнойБазыМобильныхПриложений();
	
	ИспользоватьФайловыйСервис = Не ПараметрыОблачногоХранилищаФайлов.ЗапретитьИспользование;
	
	ВидТранспорта = СинхронизацияАвтономныхКопий.ВидТранспортаПоПровайдеру(ОблачныйПровайдер);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеПроцессов()
	
	ПриостановитьСинхронизацию = Константы.ДеньгиПриостановитьАвтосинхронизацию.Получить();
	Элементы.ФайловыйСервисСинхронизировать.Доступность = ПриостановитьСинхронизацию;
	
	Элементы.СписокУстройств.Обновить();

	Если Не ИспользоватьФайловыйСервис Или Не ЗначениеЗаполнено(ВидТранспорта) Тогда
		Элементы.ГруппаСостояниеОбменаСХранилищами.Видимость = Ложь;
	ИначеЕсли Не Элементы.ГруппаСостояниеОбменаСХранилищами.Видимость Тогда
		 Элементы.ГруппаСостояниеОбменаСХранилищами.Видимость = Истина;
	КонецЕсли;
	
	Обработки.МониторСинхронизацииСМобильнымиУстройствами.ОбновитьСостояниеПрцессаНаФорме(ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФоновоеЗаданиеОбмена()
	
	Возврат АвтоматОбменаФайлами.ФоновоеЗаданиеОбмена(Истина);
	
КонецФункции


#КонецОбласти


#Область Настройка_элементов_формы


&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЭлементыФормы(Форма)
	
	ОбновитьГруппуВключенияСинхронизации(Форма);
	ОбновитьГруппуДомашняяСеть(Форма);
	ОбновитьГруппуФайловыйСервис(Форма);
	ОбновитьГруппуСпискаМобильныхУстройств(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьГруппуВключенияСинхронизации(Форма)
	
	Форма.Элементы.ГруппаВключениеСинхронизации.Видимость = Не Форма.СинхронизацияВключена;
	Форма.Элементы.ГруппаДомашняяСеть.Доступность         = Форма.СинхронизацияВключена;
	Форма.Элементы.ГруппаФайловыйСервис.Доступность       = Форма.СинхронизацияВключена;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьГруппуДомашняяСеть(Форма)
	
	Если Форма.ИспользоватьДомашнююСеть Тогда
		Форма.Элементы.ДомашняСетьКартинка.Доступность = Истина;
		Форма.Элементы.ЗаголовокТранспотраДомашняяСеть.Заголовок = НСтр("ru='Синхронизация в домашней сети включена'");
	Иначе
		Форма.Элементы.ДомашняСетьКартинка.Доступность = Ложь;
		Форма.Элементы.ЗаголовокТранспотраДомашняяСеть.Заголовок = НСтр("ru='Синхронизация в домашней сети отключена'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьГруппуФайловыйСервис(Форма)
	
	ТекстЗаголовка      = "";
	КартинкаПровайдера  = Неопределено;
	Если Форма.ОблачныйПровайдер = ПредопределенноеЗначение("Перечисление.ТипыПровайдеровREST.Dropbox") Тогда
		
		КартинкаПровайдера = БиблиотекаКартинок.СинхронизацияDropBox48;
		ТекстЗаголовка = ?(Форма.ИспользоватьФайловыйСервис, 
			НСтр("ru='Обмен файлами через Dropbox включен'") , 
			НСтр("ru='Обмен файлами через Dropbox отключен'"));
			
	ИначеЕсли Форма.ОблачныйПровайдер = ПредопределенноеЗначение("Перечисление.ТипыПровайдеровREST.Google") Тогда
		
		КартинкаПровайдера = БиблиотекаКартинок.СинхронизацияGoogleDrive48;
		ТекстЗаголовка = ?(Форма.ИспользоватьФайловыйСервис, 
			НСтр("ru='Обмен файлами через Google Drive включен'") , 
			НСтр("ru='Обмен файлами через Google Drive отключен'"));
			
	ИначеЕсли Форма.ОблачныйПровайдер = ПредопределенноеЗначение("Перечисление.ТипыПровайдеровREST.Яндекс") Тогда
		
		КартинкаПровайдера = БиблиотекаКартинок.СинхронизацияЯндексДиск48;
		ТекстЗаголовка = ?(Форма.ИспользоватьФайловыйСервис, 
			НСтр("ru='Обмен файлами через Яндекс.Диск включен'") , 
			НСтр("ru='Обмен файлами через Яндекс.Диск отключен'"));
		
	Иначе
		
		КартинкаПровайдера = БиблиотекаКартинок.СинхронизацияКаталог48;
		ТекстЗаголовка = ?(Форма.ИспользоватьФайловыйСервис, 
			НСтр("ru='Обмен файлами через облачное хранилище файлов включен'") , 
			НСтр("ru='Обмен файлами через облачное хранилище файлов отключен'"));
			
	КонецЕсли;
	
	Форма.Элементы.ФайловыйСервисКартинка.Картинка              = КартинкаПровайдера;
	Форма.Элементы.ФайловыйСервисКартинка.Доступность           = Форма.ИспользоватьФайловыйСервис;
	Форма.Элементы.ГруппаАвтообмен.Доступность   = Форма.ИспользоватьФайловыйСервис;
	Форма.Элементы.ЗаголовокТранспотраФайловыйСервис.Заголовок  = ТекстЗаголовка;
	
	// Представление аккаунта
	ПараметрыОблака = Форма.ПараметрыОблачногоХранилищаФайлов;
	Если Не ЗначениеЗаполнено(ПараметрыОблака.СвойстваАккаунта) 
		Или Не ЗначениеЗаполнено(ПараметрыОблака.СвойстваАккаунта.КлючАвторизации) Тогда 
		
		Форма.ЛогинОблачногоХранилищаФайлов = НСтр("ru='Не авторизован'");
		
	Иначе
		
		Если Форма.ПараметрыЦентральнойБазы = Неопределено 
			Или Не ЗначениеЗаполнено(Форма.ПараметрыЦентральнойБазы.ИмяЭтойБазы) Тогда
			ИмяБазы = НСтр("ru='не задано'"); 
		Иначе
			ИмяБазы = Форма.ПараметрыЦентральнойБазы.ИмяЭтойБазы; 
		КонецЕсли;
		 
		Форма.ЛогинОблачногоХранилищаФайлов = СтрШаблон(НСтр("ru='Логин: %1, имя базы: %2'"), 
						ПараметрыОблака.СвойстваАккаунта.ПредставлениеАккаунта, ИмяБазы);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьГруппуСпискаМобильныхУстройств(Форма)
	
	Если Не Форма.ПланОбменаИспользуется Тогда
		Форма.Элементы.ГруппаСписокМобильныхУстройств.ТекущаяСтраница = Форма.Элементы.СтраницаНетУстройств;
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.ГруппаСписокМобильныхУстройств.ТекущаяСтраница = Форма.Элементы.СтраницаСписокУстройств;
	
	Форма.Элементы.СписокМобильныхУстройствВсеУстройства1.Пометка     = Форма.ВариантАктивности = "ВсеУстройства";
	Форма.Элементы.СписокМобильныхУстройствТолькоАктивные1.Пометка    = Форма.ВариантАктивности = "ТолькоАктивные";
	Форма.Элементы.СписокМобильныхУстройствТолькоОтключенные1.Пометка = Форма.ВариантАктивности = "ТолькоОтключенные";
	
КонецПроцедуры



#КонецОбласти 


&НаСервереБезКонтекста
Процедура ПереключитьИспользованиеОбменаВКонфигурации(ИспользоватьОбмен)

	Константы.ИспользоватьСинхронизациюДанных.Установить(ИспользоватьОбмен);
