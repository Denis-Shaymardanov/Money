// POST /registerchanges/{DBID}
Функция РегистрацияИзмененийPOST(Запрос)
	
	ИмяСервиса = ИмяСервиса("registerchanges");
	Узел       = Неопределено;
	Ответ      = Неопределено;
	
	Если Не ПроверитьЭтуБазу(ИмяСервиса, Ответ) 
		Или Не ПроверитьУзелВАдресеЗапроса(Запрос, ИмяСервиса, Ответ, Узел) Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Если БазаЗаблокированаДляОбновления(Ответ) Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Попытка
		СинхронизацияАвтономныхКопий.ЗарегистрироватьВсеОбъектыДляОтправкиНаУзел(Узел);
		Ответ = ДеньгиОбработкаВебЗапросов.СтандартныйОтвет(200, Истина, ИмяСервиса);
	Исключение
		Ответ = ДеньгиОбработкаВебЗапросов.СтандартныйОтвет(500, ИнформацияОбОшибке(), ИмяСервиса);
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции


