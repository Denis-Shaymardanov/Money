Функция НовоеФоновоеЗаданиеЗагрузки(Узел, НомерПакета)
	
	КлючФоновогоЗадания = КлючФоновогоЗаданияЗагрузки(Узел);

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Узел", Узел);
	ПараметрыПроцедуры.Вставить("НомерПакета", НомерПакета);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = СтрШаблон(НСтр("ru = 'Загрузка данных от узла ""%1""'"), Узел.Код);
	ПараметрыВыполнения.КлючФоновогоЗадания = КлючФоновогоЗадания;
	ПараметрыВыполнения.ЗапуститьНеВФоне = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне   = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"АвтоматСинхронизацииССервисом.ВыполнитьВФонеЗагрузитьДанные",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции


