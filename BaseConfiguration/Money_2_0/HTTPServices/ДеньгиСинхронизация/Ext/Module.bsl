#Область Методы_2_1
	
// POST /execute
Функция executePOST(Запрос)
	
	Ошибка        = Неопределено;
	ДопИнформация = "";
	ИмяМетода     = "";
	
	// Чтение структуры запроса
	Попытка
		ЗапросИОтвет = ДеньгиОбработкаВебЗапросов.РазобратьЗапросExecute(Запрос);
		Если ЗапросИОтвет.Ошибка Тогда
			Возврат ДеньгиОбработкаВебЗапросов.ОтветМетодаExecute(ЗапросИОтвет.Ответ, 
						ЗапросИОтвет.Метод, ЗапросИОтвет.УзелКорреспондента);
		КонецЕсли;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ДопИнформация = "Разбор содержимого запроса";
	КонецПопытки;
	
	Если Ошибка = Неопределено Тогда
		
		ИмяМетода     = НРег(СокрЛП(ЗапросИОтвет.Метод));
		
		// Проверка регистрации узла на сервере
		ПроверятьРегистрациюУзла = ИмяМетода <> "checkregnode";
		Если ПроверятьРегистрациюУзла Тогда
			Попытка
				Если Не ДеньгиОбработкаВебЗапросов.ПроверитьРегистрациюУзла(ЗапросИОтвет) Тогда
					Возврат ДеньгиОбработкаВебЗапросов.ОтветМетодаExecute(ЗапросИОтвет.Ответ, 
							ЗапросИОтвет.Метод, ЗапросИОтвет.УзелКорреспондента);
				КонецЕсли;
			Исключение
				Ошибка = ИнформацияОбОшибке();
				ДопИнформация = "Проверка регистрации узла в плане обмена";
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Ошибка = Неопределено Тогда
		Попытка
			ВыполнитьМетодExecute(ЗапросИОтвет, ИмяМетода);
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЕсли;
	
	Если Ошибка <> Неопределено Тогда
		ОбработатьИсключениеМетодаExecute(ЗапросИОтвет, Ошибка, ДопИнформация);
	КонецЕсли;
	
	Возврат ДеньгиОбработкаВебЗапросов.ОтветМетодаExecute(ЗапросИОтвет.Ответ, ЗапросИОтвет.Метод, ЗапросИОтвет.УзелКорреспондента);
	
КонецФункции

Процедура ВыполнитьМетодExecute(ЗапросИОтвет, ИмяМетода)
	
	Если ИмяМетода = "statusserver" Тогда
		ВыполнитьЗапросСтатусСервера(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "readingpackage" Тогда
		ВыполнитьЗапросЧтениеПолученногоПакета(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "marktransfer" Тогда
		ВыполнитьЗапросОтметкаЗагрузкиДанныхКлиентом(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "checkunloading" Тогда
		ВыполнитьЗапросНеобходимостьВыгрузкиИзменений(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "unloadingchanges" Тогда
		ВыполнитьЗапросВыгрузкаИзменений(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "infosendpack" Тогда
		ВыполнитьЗапросИнформацияОПакетеКОтправке(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "checkregnode" Тогда
		ВыполнитьЗапросПроверитьРегистрациюУзла(ЗапросИОтвет);
		
	ИначеЕсли ИмяМетода = "setregchanges" Тогда
		ВыполнитьЗапросУстановитьРегистрациюОбъектов(ЗапросИОтвет);
	
	ИначеЕсли ИмяМетода = "stopprocess" Тогда
		ВыполнитьЗапросОстановитьПроцессыОбмена(ЗапросИОтвет);
			
	ИначеЕсли ИмяМетода = "getbalances" Тогда
		ВыполнитьЗапросПолучитьОстатки(ЗапросИОтвет);
			
	ИначеЕсли ИмяМетода = "deletepackages" Тогда
		ВыполнитьЗапросУдалитьПакеты(ЗапросИОтвет);
			
	ИначеЕсли ИмяМетода = "resetstatus" Тогда
		ВыполнитьЗапросСброситьСостояниеСинхронизации(ЗапросИОтвет);
			
	ИначеЕсли ИмяМетода = "updateresults" Тогда
		ВыполнитьЗапросОбновитьСостояниеОбменаПоРезультатамСКлиента(ЗапросИОтвет);
			
	Иначе
		ДеньгиОбработкаВебЗапросов.ЗаписатьПроблемуВСтруктуруОтвета(ЗапросИОтвет.Ответ, 
					ЗапросИОтвет.ВсеКодыСостояния.КомандаНеПоддерживается.Код, 
					СтрШаблон(НСтр("ru='На сервере нет метода %1'"), ЗапросИОтвет.Метод), 
					СтрШаблон(НСтр("ru='Не найден обработчик для метода %1'"), ЗапросИОтвет.Метод));
	КонецЕсли;
	
КонецПроцедуры

