Процедура ДесериализоватьЗначениеНастройки(Настройки, Имя, Тип) 
	
	ЗначениеНастройки = Неопределено;
	Если Не Настройки.Свойство(Имя, ЗначениеНастройки) Или Не ЗначениеЗаполнено(ЗначениеНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Настройки[Имя] = Перечисления[ОбъектМетаданных.Имя][ЗначениеНастройки];
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		Настройки[Имя] = СинхронизацияАвтономныхКопий.УзелПланаОбменаПоКоду(
				ОбъектМетаданных.Имя, ЗначениеНастройки, Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьСостояниеСинхронизации(Узел) 
	
	СостояниеОбмена = АвтоматСинхронизацииССервисом.СостояниеОбмена(Узел);
	АвтоматСинхронизацииССервисом.СброситьСостояние(СостояниеОбмена);
	
КонецПроцедуры

Процедура ПроверитьНовоеЗначениеПараметраОбмена(ТекущиеЗначения, НовыеЗначения, ИзмененныеЗначения, ИмяПараметра) 
	
	НовоеЗначениеПараметра = Неопределено;
	Если Не НовыеЗначения.Свойство(ИмяПараметра, НовоеЗначениеПараметра) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ИмяПараметра, "Сценарий") > 0 Тогда
		Если НовоеЗначениеПараметра = "НастольныеЗаменитьМобильными" Тогда
			НовоеЗначениеПараметра = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВЦентральнойБазе;
		ИначеЕсли НовоеЗначениеПараметра = "МобильныеЗаменитьНастольными" Тогда
			НовоеЗначениеПараметра = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВАвтономнойКопии;
		ИначеЕсли ЗначениеЗаполнено(НовоеЗначениеПараметра) Тогда 
			НовоеЗначениеПараметра = Перечисления.СценарииСинхронизацииАвтономныхКопий[НовоеЗначениеПараметра];
		Иначе
			НовоеЗначениеПараметра = Перечисления.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных;
		КонецЕсли;
		
	ИначеЕсли ИмяПараметра = "ВидПериода" И ЗначениеЗаполнено(НовоеЗначениеПараметра) Тогда
		НовоеЗначениеПараметра = Перечисления.Периодичность[НовоеЗначениеПараметра];
		
	КонецЕсли;
	
	Если ТекущиеЗначения[ИмяПараметра] <> НовоеЗначениеПараметра Тогда
		ИзмененныеЗначения.Вставить(ИмяПараметра, НовоеЗначениеПараметра);
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьСтруктуруКПередачеВJSON(Структура)
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Структура Цикл
		
		ТипЭлемента = ТипЗнч(КлючИЗначение.Значение);
		Если ТипЭлемента = Тип("Структура") Или ТипЭлемента = Тип("ФиксированнаяСтруктура") Тогда
			Результат.Вставить(КлючИЗначение.Ключ, ПодготовитьСтруктуруКПередачеВJSON(КлючИЗначение.Значение));
			
		ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЭлемента) Тогда
			
			 Если ОбщегоНазначения.ЭтоПеречисление(КлючИЗначение.Значение.Метаданные()) Тогда
			 	ЗначениеПеречисления = ?(ЗначениеЗаполнено(КлючИЗначение.Значение), 
			 			ОбщегоНазначения.ИмяЗначенияПеречисления(КлючИЗначение.Значение), "");
			 	Результат.Вставить(КлючИЗначение.Ключ, ЗначениеПеречисления);
			 КонецЕсли;
			 
		Иначе
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

Функция СинхронизацияВключенаВНастройках() 
	Результат = Истина;
	
	Режим = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	Если Режим = "ЦентрМобильных" Тогда
		ПараметрыДомашняяСеть = Справочники.ТранспортыОбменаДанными.СтруктураПараметровТранспорта(Справочники.ТранспортыОбменаДанными.ОсновнойТранспортДомашнейСети());
		Если ПараметрыДомашняяСеть.ЗапретитьИспользование Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ВерсияКлиентаАктуальна(ОсновныеДанные)
	
	МинимальнаяВерсия = СинхронизацияАвтономныхКопий.МинимальнаяВерсияАвтономногоКлиента(ОсновныеДанные.mobile);
	ВерсияКлиента = ОсновныеДанные.version;
	Возврат ДеньгиКлиентСервер.СравнитьВерсии(ВерсияКлиента, МинимальнаяВерсия) >= 0;
	
КонецФункции

