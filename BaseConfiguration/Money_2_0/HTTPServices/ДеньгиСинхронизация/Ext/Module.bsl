// POST /resetstatus/{DBID}
Функция СборсСостоянияСинхронизацииНаСервереPOST(Запрос)
	
	ИмяСервиса = ИмяСервиса("resetstatus");
	Узел       = Неопределено;
	Ответ      = Неопределено;
	
	Если Не ПроверитьЭтуБазу(ИмяСервиса, Ответ) 
		Или Не ПроверитьУзелВАдресеЗапроса(Запрос, ИмяСервиса, Ответ, Узел) Тогда
		Возврат Ответ;
	КонецЕсли;
	Если БазаЗаблокированаДляОбновления(Ответ) Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Попытка
		СостояниеОбмена = АвтоматСинхронизацииССервисом.СостояниеОбмена(Узел);
		АвтоматСинхронизацииССервисом.СброситьСостояние(СостояниеОбмена);
	Исключение
		Возврат ДеньгиОбработкаВебЗапросов.СтандартныйОтвет(500, ИнформацияОбОшибке(), ИмяСервиса);
	КонецПопытки;
	
	Возврат ДеньгиОбработкаВебЗапросов.СтандартныйОтвет(200, Истина, ИмяСервиса);
	
КонецФункции




