			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	27 + ВЫБОР
		КОГДА СписокДокументов.Проведен
				ИЛИ СписокДокументов.ЭтоШаблон
			ТОГДА 1
		КОГДА СписокДокументов.ПометкаУдаления
			ТОГДА 2
		ИНАЧЕ 0
	КОНЕЦ КАК ИндексКартинки,
	СписокДокументов.*,
	ВЫБОР
		КОГДА СписокДокументов.РазделУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Деньги))
			ТОГДА 1
		КОГДА СписокДокументов.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Имущество)
			ТОГДА 2
		//КОГДА СписокДокументов.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
		//		И ВЫРАЗИТЬ(СписокДокументов.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВыданныхДолгов
		//	ТОГДА 3
		//КОГДА СписокДокументов.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
		//		И ВЫРАЗИТЬ(СписокДокументов.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВзятыхДолгов
		//	ТОГДА 4
		//КОГДА СписокДокументов.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ПроцентыПоДолгам)
		//	ТОГДА 5
		ИНАЧЕ 0
	КОНЕЦ КАК НомерИконкиСчета
ИЗ
	Документ.МыВзялиВДолг КАК СписокДокументов</QueryText>
				<MainTable>Document.МыВзялиВДолг</MainTable>
