			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументМыВзялиВДолг.Ссылка КАК Ссылка,
	ВЫРАЗИТЬ(ДокументМыВзялиВДолг.ОписаниеОперации КАК СТРОКА(200)) КАК ОписаниеОперации,
	ДокументМыВзялиВДолг.ЭтоШаблон КАК ЭтоШаблон,
	ДокументМыВзялиВДолг.ВерсияДанных,
	ДокументМыВзялиВДолг.ПометкаУдаления,
	ДокументМыВзялиВДолг.Кредитор,
	ДокументМыВзялиВДолг.Кредит,
	ДокументМыВзялиВДолг.ВалютаКредита,
	ДокументМыВзялиВДолг.СуммаКредита,
	ДокументМыВзялиВДолг.Пользователь,
	ДокументМыВзялиВДолг.Комментарий,
	ДокументМыВзялиВДолг.МоментВремени,
	ДокументМыВзялиВДолг.Кошелек,
	ВЫБОР
		КОГДА ДокументМыВзялиВДолг.РазделУчета В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Деньги))
			ТОГДА 1
		КОГДА ДокументМыВзялиВДолг.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Имущество)
			ТОГДА 2
		//КОГДА ДокументМыВзялиВДолг.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
		//		И ВЫРАЗИТЬ(ДокументМыВзялиВДолг.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВыданныхДолгов
		//	ТОГДА 3
		//КОГДА ДокументМыВзялиВДолг.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
		//		И ВЫРАЗИТЬ(ДокументМыВзялиВДолг.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВзятыхДолгов
		//	ТОГДА 4
		//КОГДА ДокументМыВзялиВДолг.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ПроцентыПоДолгам)
		//	ТОГДА 5
		ИНАЧЕ 0
	КОНЕЦ КАК НомерИконкиСчета
ИЗ
	Документ.МыВзялиВДолг КАК ДокументМыВзялиВДолг
</QueryText>
