	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ВалютаДокумента</Field>
				<Field>Список.ПлановаяДата</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЕСТЬNULL(ДокументРасход.Ссылка, БезШаблона.Ссылка) КАК Ссылка,
	ЕСТЬNULL(ДокументРасход.ПометкаУдаления, ЛОЖЬ) КАК ПометкаУдаления,
	ЕСТЬNULL(ДокументРасход.РазделУчета, ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Деньги)) КАК РаздлеУчета,
	ВЫБОР
		КОГДА ДокументРасход.РазделУчета.Родитель = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Деньги)
			ТОГДА 1
		КОГДА ДокументРасход.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Имущество)
			ТОГДА 2
		КОГДА ДокументРасход.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
				И ВЫРАЗИТЬ(ДокументРасход.КошелекДолг КАК Справочник.Долги).ИспользоватьДляУчетаВыданныхДолгов
			ТОГДА 3
		КОГДА ДокументРасход.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
				И ВЫРАЗИТЬ(ДокументРасход.КошелекДолг КАК Справочник.Долги).ИспользоватьДляУчетаВзятыхДолгов
			ТОГДА 4
		КОГДА ДокументРасход.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ПроцентыПоДолгам)
				И ВЫРАЗИТЬ(ДокументРасход.КошелекДолг КАК Справочник.Долги).ИспользоватьДляУчетаВыданныхДолгов
			ТОГДА 5
		КОГДА ДокументРасход.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ПроцентыПоДолгам)
				И ВЫРАЗИТЬ(ДокументРасход.КошелекДолг КАК Справочник.Долги).ИспользоватьДляУчетаВзятыхДолгов
			ТОГДА 6
		ИНАЧЕ 0
	КОНЕЦ КАК НомерИконкиСчета,
	ЕСТЬNULL(ДокументРасход.КошелекДолг, НЕОПРЕДЕЛЕНО) КАК ОбъектУчета,
	ЕСТЬNULL(ДокументРасход.Пользователь, НЕОПРЕДЕЛЕНО) КАК Пользователь,
	ЕСТЬNULL(ДокументРасход.СуммаОплаты, 0) КАК СуммаОплаты,
	ЕСТЬNULL(ДокументРасход.СуммаЧека, 0) КАК СуммаЧека,
	ЕСТЬNULL(ДокументРасход.Комментарий, "") КАК Комментарий,
	ВЫРАЗИТЬ(ЕСТЬNULL(ДокументРасход.ОписаниеОперации, "") КАК СТРОКА(1000)) КАК ОписаниеОперации,
	ЕСТЬNULL(ДокументРасход.ЭтоШаблон, ИСТИНА) КАК ЭтоШаблон,
	ЕСТЬNULL(ДокументРасход.ВалютаОперации, ЗНАЧЕНИЕ(Справочник.Валюты.ПУстаяСсылка)) КАК ВалютаДокумента,
	ЕСТЬNULL(ДокументРасход.СтоимостьИмущества, 0) КАК СтоимостьИмущества,
	ДатыРасписаний.ПлановаяДата
ИЗ
	Документ.Расход КАК ДокументРасход
		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			НЕОПРЕДЕЛЕНО КАК Ссылка,
			" &lt;Без шаблона&gt;" КАК ОписаниеОперации,
			0 КАК Порядок) КАК БезШаблона
		ПО (БезШаблона.Ссылка = ДокументРасход.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ДатыРасписаний.ВладелецРасписания КАК ВладелецРасписания,
			МИНИМУМ(ДатыРасписаний.ПлановаяДата) КАК ПлановаяДата
		ИЗ
			РегистрСведений.ДатыРасписаний КАК ДатыРасписаний
		
		СГРУППИРОВАТЬ ПО
			ДатыРасписаний.ВладелецРасписания) КАК ДатыРасписаний
		ПО ДокументРасход.Ссылка = ДатыРасписаний.ВладелецРасписания
</QueryText>
