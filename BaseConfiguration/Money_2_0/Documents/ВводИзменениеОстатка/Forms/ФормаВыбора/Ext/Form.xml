			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	33 + ВЫБОР
		КОГДА ДокументВводИзменениеОстатка.Проведен
				ИЛИ ДокументВводИзменениеОстатка.ЭтоШаблон
			ТОГДА 1
		КОГДА ДокументВводИзменениеОстатка.ПометкаУдаления
			ТОГДА 2
		ИНАЧЕ 0
	КОНЕЦ КАК ИндексКартинки,
	ДокументВводИзменениеОстатка.*,
	ВЫБОР
		КОГДА ДокументВводИзменениеОстатка.РазделУчета.Родитель = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Деньги)
			ТОГДА 1
		КОГДА ДокументВводИзменениеОстатка.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.Имущество)
			ТОГДА 2
		КОГДА ДокументВводИзменениеОстатка.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
				И ВЫРАЗИТЬ(ДокументВводИзменениеОстатка.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВыданныхДолгов
			ТОГДА 3
		КОГДА ДокументВводИзменениеОстатка.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ОсновныеСуммыДолгов)
				И ВЫРАЗИТЬ(ДокументВводИзменениеОстатка.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВзятыхДолгов
			ТОГДА 4
		КОГДА ДокументВводИзменениеОстатка.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ПроцентыПоДолгам)
				И ВЫРАЗИТЬ(ДокументВводИзменениеОстатка.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВыданныхДолгов
			ТОГДА 5
		КОГДА ДокументВводИзменениеОстатка.РазделУчета = ЗНАЧЕНИЕ(ПланСчетов.РазделыУчета.ПроцентыПоДолгам)
				И ВЫРАЗИТЬ(ДокументВводИзменениеОстатка.ОбъектУчета КАК Справочник.Долги).ИспользоватьДляУчетаВзятыхДолгов
			ТОГДА 6
		ИНАЧЕ 0
	КОНЕЦ КАК НомерИконкиРаздела
ИЗ
	Документ.ВводИзменениеОстатка КАК ДокументВводИзменениеОстатка</QueryText>
				<MainTable>Document.ВводИзменениеОстатка</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">ЭтоШаблон</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
							<dcsset:viewMode>Inaccessible</dcsset:viewMode>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
				</ListSettings>
			</Settings>
