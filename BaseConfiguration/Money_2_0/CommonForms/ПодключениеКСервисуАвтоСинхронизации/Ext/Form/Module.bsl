	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Выйти'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да);
	#КонецОбласти
	 
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьОтображениеПароля()
	
	ПотмекаПоказатьПароль = ?(ПотмекаПоказатьПароль = Неопределено, Истина, Не ПотмекаПоказатьПароль);
	Элементы.ПоказатьПароль1.Пометка = ПотмекаПоказатьПароль;
	Элементы.ПоказатьПароль2.Пометка = ПотмекаПоказатьПароль;
	Элементы.ПоказатьПароль3.Пометка = ПотмекаПоказатьПароль;
	
	ЗаголовокКнопки       = ?(ПотмекаПоказатьПароль, НСтр("ru='Скрыть'"), НСтр("ru='Показать'"));
	Элементы.ПоказатьПароль1.Заголовок = ЗаголовокКнопки;
	Элементы.ПоказатьПароль2.Заголовок = ЗаголовокКнопки;
	Элементы.ПоказатьПароль3.Заголовок = ЗаголовокКнопки;
	
	Элементы.Пароль1.РежимПароля = Не ПотмекаПоказатьПароль;
	Элементы.Пароль2.РежимПароля = Не ПотмекаПоказатьПароль;
	Элементы.Пароль3.РежимПароля = Не ПотмекаПоказатьПароль;
	
	Элементы.ПарольПодтверждение.Доступность = Не ПотмекаПоказатьПароль;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыПодключения(ОбновлятьРеквизитыФормы)
	
	Если ОбновлятьРеквизитыФормы Тогда
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
	ПараметрыПодключения = ДеньгиВОблаке.ПараметрыСоединенияСОблаком();
	ПодключениеВыполнено = Не ЗначениеЗаполнено(ТекстОшибки) И ДеньгиВОблакеВызовСервера.ЭтаБазаПодключенаКОблаку(ПараметрыПодключения);
	Если ОбновлятьРеквизитыФормы Тогда
		ЭлектроннаяПочта   = ПараметрыПодключения.Логин;
		Пароль             = ПараметрыПодключения.Пароль;
		ИмяЭтойБазы        = ПараметрыПодключения.ИмяЭтойБазы;
		ПоказатьQRкодСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПоляЗаполненыКорректно()
	
	Возврат ЛогинИПарольКорректны() И ИмяБазыКорректно();
	
КонецФункции

&НаКлиенте
Функция ЛогинИПарольКорректны()
	
	Если Не ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указан адрес электронной почты'"), , "ЭлектроннаяПочта");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		//@skip-warning
		Результат = ОбщегоНазначенияКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(ЭлектроннаяПочта);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , "ЭлектроннаяПочта");
		Возврат Ложь;
	КонецПопытки;
	
	Если Элементы.ГруппаСтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПодключение Тогда
		ПолеПароля = "Пароль1";
	ИначеЕсли Элементы.ГруппаСтраницыФормы.ТекущаяСтраница = Элементы.СтраницаРегистрация Тогда
		ПолеПароля = "Пароль2";
	Иначе
		ПолеПароля = "Пароль3";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пароль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не задан пароль'"), , ПолеПароля);
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Пароль) < 6 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Пароль не должен быть короче 6 символов'"), , ПолеПароля);
		Возврат Ложь;
	КонецЕсли;
	
	Если Элементы.ГруппаСтраницыФормы.ТекущаяСтраница = Элементы.СтраницаРегистрация
		И ПотмекаПоказатьПароль<> Истина
		И Пароль <> ПарольПодтверждение Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Пароль и подтверждение пароля не совпадают'"), , "ПарольПодтверждение");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

&НаКлиенте
Функция ИмяБазыКорректно()
	
	Если Не ЗначениеЗаполнено(ИмяЭтойБазы) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не задано имя этой базы'"), , "ИмяЭтойБазы");
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(СокрЛП(ИмяЭтойБазы)) < 4 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Имя базы не должно быть короче 4-х символов'"), , "ИмяЭтойБазы");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

&НаКлиентеНаСервереБезКонтекста
