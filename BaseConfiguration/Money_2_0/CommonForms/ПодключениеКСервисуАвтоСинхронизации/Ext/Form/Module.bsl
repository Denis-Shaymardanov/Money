	Элементы.Зарегистрироваться.КнопкаПоУмолчанию = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКПодключению(Команда)
	
	Элементы.ГруппаСтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПодключение;
	Элементы.Войти.КнопкаПоУмолчанию = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	ВерутьсяСоСтраницыОжидания();
КонецПроцедуры

&НаКлиенте
Процедура Зарегистрироваться(Команда)
	
	Если Не ПоляЗаполненыКорректно() Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьБазуКОблаку(2);
	
КонецПроцедуры

&НаКлиенте
Процедура Войти(Команда)
	
	Если Не ПоляЗаполненыКорректно() Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьБазуКОблаку(1);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьСинхронизацию(Команда)
	
	#Область ПоказатьВопрос
	ТекстВопроса = НСтр("ru='Выключить синхронизацию на этом компьютере?'");
	Если ПодключениеВыполнено Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru='Обратите внимание:
				| - выключение не освобождает лицензию в облаке
				| - при повторном включении возможна рассинхронизация данных'");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	Оповещение = Новый ОписаниеОповещения("ВыключитьСинхронизациюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Выключить'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да);
	#КонецОбласти
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВПоддержку(Команда)
	ОтправитьСообщениеВПоддержку();
КонецПроцедуры

