&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПодсказкуСценария(ЭлементСценария, Сценарий, Режим)
	
	Если Сценарий = ПредопределенноеЗначение("Перечисление.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВАвтономнойКопии") Тогда
		ТекстПодсказки = ?(Режим = "Разделенный", 
					НСтр("ru='Записи в локальной копии будут удалены. Вместо них будут загружены данные из сервиса'"),
					НСтр("ru='Перед синхронизацией эта база будет очищена и заполнена данными из сервиса'"));
		ТекстПодсказки = ТекстПодсказки + Символы.ПС + НСтр("ru='Обязательно сделайте резервную копию перед синхронизацией!'"); 
	ИначеЕсли Сценарий = ПредопределенноеЗначение("Перечисление.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВЦентральнойБазе") Тогда
		ТекстПодсказки = ?(Режим = "Разделенный", 
					НСтр("ru='Записи в этой базе и в других локальных копия будут удалены. Вместо них будут загружены данные из выделенного узла'"),
					НСтр("ru='Данные во всех синхронизируемых базах будут замещены данными этой базы'")); 
		ТекстПодсказки = ТекстПодсказки + Символы.ПС + НСтр("ru='Обязательно сделайте резервную копию перед синхронизацией!'"); 
	ИначеЕсли Сценарий = ПредопределенноеЗначение("Перечисление.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных") Тогда
		ТекстПодсказки = НСтр("ru='Локальная база синхронизирует свои изменения с другими базами'");
	Иначе
		ТекстПодсказки = НСтр("ru='Сценарий не указан, синхронизация остановлана'");
	КонецЕсли;
	
	ЭлементСценария.Подсказка = ТекстПодсказки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРежимСинхронизации()
	
	ДеньгиОбменСЦентральнойБазой.ИзменитьИспользованиеЗаданияСинхронизацииСЦентральнойБазой(СпособСинхронизации <> 1, ЦентральнаяБаза);
	ОбновитьСостояниеСинхронизацииСервер();
	ОбновитьСпособСледующейСинхронизации();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСценарийСинхронизации()
	
	// записывает изменение сценария
	СценарийОбъединения = Перечисления.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных;
	Если СценарийСинхронизации = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВАвтономнойКопии Тогда
		Изменения = Новый Структура("ЗатребованныйСценарий,СценарийЗапрашиваемыхДанных,СценарийПереданныхДанных", 
			СценарийСинхронизации, СценарийСинхронизации, СценарийОбъединения);
			
	ИначеЕсли СценарийСинхронизации = Перечисления.СценарииСинхронизацииАвтономныхКопий.ЗаменитьВсеВЦентральнойБазе Тогда
		Изменения = Новый Структура("ЗатребованныйСценарий,СценарийЗапрашиваемыхДанных,СценарийПереданныхДанных", 
			СценарийСинхронизации, СценарийОбъединения, СценарийСинхронизации);
	Иначе
		Изменения = Новый Структура("СценарийЗапрашиваемыхДанных,ЗатребованныйСценарий,СценарийПереданныхДанных", 
			СценарийОбъединения, СценарийОбъединения, СценарийОбъединения);
	КонецЕсли;
	
	СинхронизацияАвтономныхКопий.ЗаписатьНовыеПараметрыОбменаСУзлом(ЦентральнаяБаза, Изменения);
	
	Если СценарийСинхронизации <> СценарийОбъединения И СпособСинхронизации = 0 Тогда
		
		ОстановитьСинхронизациюСервер();
		СпособСинхронизации = 1;
		ЗаписатьРежимСинхронизации();
		Сообщить(НСтр("ru='Автоматическая синхронизация отключена'"));
		
	Иначе
		ОбновитьСостояниеСинхронизацииСервер();
		ОбновитьСпособСледующейСинхронизации();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолныйДоступКОблаку(СвйстваБазыВОблаке)
	Возврат СвйстваБазыВОблаке <> Неопределено 
			И Не СвйстваБазыВОблаке.ИБУстаревшая И Не СвйстваБазыВОблаке.ИБЗапрещена;
КонецФункции 

&НаКлиенте
Процедура ПоказатьДиалогИзмененияСостояния(ВыбраннаяСтрока)

	СтрокаБазы = ПодключенныеБазы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РазрешеноОтключать = ПолныйДоступКОблаку(СвйстваБазыВОблаке);
	
	СписокКоманд = Новый СписокЗначений;
	Если СтрокаБазы.Код = КодЭтогоУзла Тогда
		
		Если СтрокаБазы.ИБУстаревшая и ДопускаетсяПодключениеБазы() Тогда
			СписокКоманд.Добавить("Подключить", НСтр("ru='Подключить'"));
		Иначе
			ПоказатьПредупреждение(, НСтр("ru='Невозможно отключить базу, из которой выполняется управление облаком'"));
			Возврат;
		КонецЕсли;
		
	Иначе
		
		Если СтрокаБазы.ИБЗапрещена Тогда
			СписокКоманд.Добавить("Разрешить", НСтр("ru='Разрешить соединение базы с сервисом'"));
		ИначеЕсли РазрешеноОтключать Тогда
			СписокКоманд.Добавить("Запретить", НСтр("ru='Запретить соединение с сервисом и по возможности очистить базу'"));
		КонецЕсли;
		
		Если СтрокаБазы.ИБУстаревшая Тогда
			СписокКоманд.Добавить("Подключить", НСтр("ru='Подключть к сервису и снять признак устаревшей базы'"));
		ИначеЕсли РазрешеноОтключать Тогда  
			СписокКоманд.Добавить("Отключить", НСтр("ru='Отключить от сеовиса как устаревшую'"));
		КонецЕсли;
		
	КонецЕсли;
	
	Если СписокКоманд.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПоказатьДиалогИзмененияСостоянияЗавершение", ЭтотОбъект, ВыбраннаяСтрока);
	ПоказатьВыборИзМеню(Оповещение, СписокКоманд);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиалогИзмененияСостоянияЗавершение(Ответ, ВыбраннаяСтрока) Экспорт
	
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаБазы = ПодключенныеБазы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.Значение = "Подключить" Тогда
		
		Если Не ДопускаетсяПодключениеБазы() Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для подключения еще одной базы не хватает лицензий'"));
		Иначе
			ИзменитьПодключениеБазы(СтрокаБазы.Код, Ответ.Значение);
		КонецЕсли;
		
	ИначеЕсли Ответ.Значение = "Отключить" Тогда
		ИзменитьПодключениеБазы(СтрокаБазы.Код, Ответ.Значение);
		
	ИначеЕсли Ответ.Значение = "Разрешить" Или Ответ.Значение = "Запретить" Тогда
		
		// Запрос подтверждения
		#Область ПоказатьВопрос
		Если Ответ.Значение = "Разрешить" Тогда
			ТекстВопроса = НСтр("ru='Разрешить подключение для ""%1""?
					|
					|После разрешения все данные станут доступны для этой программы'");
			ТекстКнопки = НСтр("ru='Разрешить'"); 
		Иначе
			ТекстВопроса = НСтр("ru='Запретить подключение для ""%1""?
					|
					|После запрета программа не сможет подкючаться к сервису, 
					|а если попытается - все данные в ней будут удалены без запроса подтверждения!'");
			ТекстКнопки = НСтр("ru='Запретить'"); 
		КонецЕсли;
		ТекстВопроса = СтрШаблон(ТекстВопроса, СтрокаБазы.ПредставлениеПрограммы);
		
		ДополнительныеПараметры = Новый Структура("Команда,ВыбраннаяСтрока", Ответ.Значение, ВыбраннаяСтрока);
		Оповещение = Новый ОписаниеОповещения("ПодтверждениеЗапретаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,     ТекстКнопки);
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, Заголовок);
		#КонецОбласти
		
	КонецЕсли;
	
	ЭтапОбновления = "Начало";
	ОбновитьИнформациюНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеЗапретаЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СтрокаБазы = ПодключенныеБазы.НайтиПоИдентификатору(ДополнительныеПараметры.ВыбраннаяСтрока);
	Если СтрокаБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьЗапретБазы(СтрокаБазы.Код, Не СтрокаБазы.ИБЗапрещена);
	
КонецПроцедуры

&НаКлиенте
