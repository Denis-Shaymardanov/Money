	КонецЕсли;
	
	ЗарегистрироватьВсеДляОтправкиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьВсеКЗагрузке(Команда)
	
	ТекстПредупреждения = НСтр("ru='В данный момент выполняется синхронизация.
		|Для выполнения команды остановите синхронизацию или дождитесь ее завершения'");
	Если ПредупредитьЕслиВыполняетсяСинхронизация(ТекстПредупреждения) Тогда
		Возврат;
	КонецЕсли;
	
	ОтметитьДляЗагрузкиВсеЗаписиОблакаСервер()
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	ВыгрузитьВФайлКлент();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	ЗагрузитьИзФайлаКлент();
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьСинхронизацию(Команда)
	
	#Область ПоказатьВопрос
	ТекстВопроса = НСтр("ru='Выключить синхронизацию на этом компьютере?
		|Обратите внимание:
		| - выключение не освобождает лицензию в сервисе автосинхронизации
		| - при повторном включении возможна рассинхронизация данных'");
	
	ДополнительныеПараметры = Новый Структура;
	Оповещение = Новый ОписаниеОповещения("ВыключитьСинхронизациюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Выключить'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, Заголовок);
	#КонецОбласти
	
КонецПроцедуры

&НаКлиенте
Процедура Исправить(Команда)
	ПоказатьМенюИсправлений();
КонецПроцедуры

&НаКлиенте
Процедура СобытияПолучения(Команда)
	ОткрытьЖурналСобытийСинхронизации("ЗагрузкаДанных");
КонецПроцедуры

&НаКлиенте
Процедура СобытияОтправки(Команда)
	ОткрытьЖурналСобытийСинхронизации("ВыгрузкаДанных");
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьИтоги(Команда)
	ПараметрыФормы = Новый Структура("Ключ", ЦентральнаяБаза);
	ОткрытьФорму("ПланОбмена.СинхронизацияАвтономныхКопий.Форма.ПросмотрУзла", ПараметрыФормы);
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьДоступностьЭтойФормы(Отказ, ФормаЗамены, ОповещениеОЗакрытии)
	
	ОповещениеОЗакрытии = Неопределено;
	
	Если Режим = "Независимый" Тогда 
		Отказ = Истина;
		ФормаЗамены = "ОбщаяФорма.ВыборСпособаСинхронизации";
		
	ИначеЕсли Режим = "ЦентрМобильных" Тогда 
		
		Отказ = Истина;
		ВызватьИсключение НСтр("ru='Эта форма не предназначена для использования в режме обмена данными с мобильными приложениями'");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФормаЗамены) И (Не ПараметрыПодключенияЗаполнены Или Не БазаПодключенаКОблаку) Тогда
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("НастройкиУчетнойЗаписиЗавершение", ЭтотОбъект);
		ФормаЗамены = "ОбщаяФорма.ПодключениеКСервисуАвтоСинхронизации";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформациюНаКлиенте()
	
	Элементы.ОстановитьСинхронизацию.Доступность = Ложь;
	Элементы.ПродолжитьСинхронизацию.Доступность = Ложь;

	Если Не ПараметрыПодключенияЗаполнены Или Не БазаПодключенаКОблаку Тогда
		
		ТекстНетДанных = НСтр("ru='нет данных'");
		ПредставлениеУчетнойЗаписи = ТекстНетДанных; 
		ПредставлениеПодключенныхБаз = ТекстНетДанных; 
		ПредставлениеЛицензий = ТекстНетДанных; 
		РезультатПоследнейСинхронизации = ТекстНетДанных;
		ПредставлениеОшибкиСинхронизации = "";
		
		Элементы.ГруппаПараметровСинхронизации.Доступность = Ложь;
		Элементы.СинхронизироватьЗаново.Доступность        = Ложь;
		Элементы.ГруппаКонмадАбонента.Доступность          = Ложь;
		Возврат;
		
	Иначе
		
		Элементы.ГруппаПараметровСинхронизации.Доступность = Истина;
		Элементы.СинхронизироватьЗаново.Доступность        = Истина;
		Элементы.ГруппаКонмадАбонента.Доступность          = Истина;
		
	КонецЕсли;
	
	Если ЭтапОбновления = "Начало" Тогда
		НачатьОбновлениеНаКлиенте();
		ЭтапОбновления = "РезультатыСинхронизации";
		
	ИначеЕсли ЭтапОбновления = "РезультатыСинхронизации" Тогда
		ОбновитьСтатусФоновогоЗаданияСинхронизацииКлиент();
		ОбновитьСпособСледующейСинхронизации();
		ЭтапОбновления = "СостояниеПодписок";
		
	ИначеЕсли ЭтапОбновления = "СостояниеПодписок" Тогда
		ОбновитьСостояниеПодписок();
		ЭтапОбновления = "";
		
	Иначе
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтапОбновления) Тогда
		ПодключитьОбработчикОжидания("ОбновитьИнформациюНаКлиенте", 0.2, Истина);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура НачатьОбновлениеНаКлиенте()
	
	ОтключитьОбработчикОжидания("ОбработчикПроверкиОбмена");
	
	Элементы.ГруппаОшибкаОбновленияДанных.Видимость = Ложь;
	ТекстОшибки = "";
	ТекстСостоянияБазыВОблаке = "";
	Элементы.ГруппаСостояниеБазыВОблаке.Видимость = Ложь;
	Элементы.ПредставлениеОшибки.Заголовок = "При обновлении информации возникли ошибки";
	
	Если ПараметрыПодключения = Неопределено Тогда
		ПредставлениеУчетнойЗаписи = НСтр("ru='нет данных'");
	Иначе
		ПредставлениеУчетнойЗаписи = ПараметрыПодключения.Логин;
	КонецЕсли;
	
	ТекстОбновляется = НСтр("ru='обновление…'");
	ПредставлениеЛицензий               = ТекстОбновляется;
	ПредставлениеПодключенныхБаз        = ТекстОбновляется;
	РезультатПоследнейСинхронизации     = ТекстОбновляется;
	ПредставлениеОшибкиСинхронизации    = "";
	Элементы.ОстановитьСинхронизацию.Доступность = Ложь;
	Элементы.ПродолжитьСинхронизацию.Доступность = Ложь;
	
	ОбновитьЭлементыПоСостояниюОбновления(ЭтотОбъект, Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЭлементыПоСостояниюОбновления(Форма, ИдетОбновление)
	
	Форма.Элементы.ДекорацияИндикатор.Картинка = ?(ИдетОбновление, 
				БиблиотекаКартинок.ДлительнаяОперация48,
				БиблиотекаКартинок.ОблакоFRESH48);
	
	Форма.Элементы.ОбновитьИнформацию.Доступность      = Не ИдетОбновление;
	Форма.Элементы.НастройкиУчетнойЗаписи.Доступность  = Не ИдетОбновление;
	Форма.Элементы.ГруппаСписокПодписок.Доступность    = Не ИдетОбновление;
	Форма.Элементы.ГруппаСписокПрограмм.Доступность    = Не ИдетОбновление;
	Форма.Элементы.ГруппаКонмадАбонента.Доступность    = Не ИдетОбновление;
	Форма.Элементы.ГруппаПараметровСинхронизации.Доступность = Не ИдетОбновление;
	
	Форма.Элементы.СинхронизироватьЗаново.Доступность = Не ИдетОбновление;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПроверкиОбмена()
	
	ОбновитьСтатусФоновогоЗаданияСинхронизацииКлиент();
	
КонецПроцедуры

&НаКлиенте
Функция СинхронизацияВыполняетсяВДанныйМомент()
	
	ОбновитьСтатусФоновогоЗаданияСинхронизацииКлиент();
	Возврат СвойствоФЗ <> Неопределено И СвойствоФЗ.Статус = "Выполняется";
	
КонецФункции

&НаКлиенте
Функция ПредупредитьЕслиВыполняетсяСинхронизация(ТекстСообщения = "")
	
	Если Не СинхронизацияВыполняетсяВДанныйМомент() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекстСообщения = "" Тогда
		ТекстСообщения = НСтр("ru='В данный момент синхронизация уже выполняется.
		|Повторите попытку позже'");
	КонецЕсли;
	
	ПоказатьПредупреждение( , ТекстСообщения );
	Возврат Истина;
	
КонецФункции 

&НаКлиенте
Процедура ОбновитьСтатусФоновогоЗаданияСинхронизацииКлиент()
	
	СвойствоФЗ = ДеньгиКлиент.ПараметрПриложения("Деньги.Обмен.ФоновоеЗадание", Неопределено);
	СостояниеИзПараметров = ДеньгиКлиент.ПараметрПриложения("Деньги.Обмен.СостояниеОбмена", Неопределено);
	Если СвойствоФЗ = Неопределено Или СостояниеИзПараметров = Неопределено Тогда
		ПроцессыОбменаКлиент.ОбновитьКлиентскиеПараметрыПриложения();
		СвойствоФЗ = ДеньгиКлиент.ПараметрПриложения("Деньги.Обмен.ФоновоеЗадание", Неопределено);
		СостояниеИзПараметров = ДеньгиКлиент.ПараметрПриложения("Деньги.Обмен.СостояниеОбмена", Неопределено);
	КонецЕсли;
	
	ПоследняяСинхронизация = ДеньгиКлиент.ПараметрПриложения("Деньги.Обмен.ДатаПоследнейУспешнойСинхронизацииСтрокой", 
										Неопределено);
	Если ЗначениеЗаполнено(ПоследняяСинхронизация) Тогда
		РезультатПоследнейСинхронизации = ПоследняяСинхронизация;
	КонецЕсли;
	
	Если СостояниеИзПараметров = Неопределено Тогда
		ОбновитьСостояниеСинхронизацииСервер();
	Иначе
		СостояниеОбмена = СостояниеИзПараметров;
		ОбновитьЗаголовкиСостоянияСинхронизации(ЭтотОбъект);
		
		Если СостояниеОбмена <> Неопределено 
			И Не СостояниеОбмена.ПроцессАктивен
			И СценарийСинхронизации <> ПредопределенноеЗначение("Перечисление.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных") Тогда
			ОбновитьСпособСледующейСинхронизации();
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеСинхронизацииСервер()
	
	СостояниеОбмена = АвтоматСинхронизацииССервисом.СостояниеОбмена();
	ДатаСинхронизации = СинхронизацияАвтономныхКопий.ДатаПоследнейУспешнойСинхронизации(СостояниеОбмена.УзелКорреспондента);
	Если ЗначениеЗаполнено(ДатаСинхронизации) Тогда
		РезультатПоследнейСинхронизации = Формат(ДатаСинхронизации, "Л=ru_RU; ДФ='dd.MM.yyyy HH.mm.ss'");
	Иначе
		РезультатПоследнейСинхронизации = НСтр("ru='нет данных'") 
	КонецЕсли;
	
	ОбновитьЗаголовкиСостоянияСинхронизации(ЭтотОбъект);
	
	Если СостояниеОбмена <> Неопределено 
		И Не СостояниеОбмена.ПроцессАктивен
		И СценарийСинхронизации <> ПредопределенноеЗначение("Перечисление.СценарииСинхронизацииАвтономныхКопий.ОбъединениеДанных") Тогда
		ОбновитьСпособСледующейСинхронизации();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовкиСостоянияСинхронизации(Форма)
	
	СвойствоФЗ             = Форма.СвойствоФЗ;
	КартинкаСостояния      = БиблиотекаКартинок.СинхронизацияНетОбмена48;
	СостояниеТранспорта    = "…";
	СостояниеОбмена        = Форма.СостояниеОбмена;
	ЕстьОписаниеПроцессов  = СостояниеОбмена <> Неопределено И СостояниеОбмена.Свойство("СтруктураПредставления");
	СостояниеПередача      = НСтр("ru='Передача: …'");
	СостояниеПрием         = НСтр("ru='Прием: …'");
	
	Если СвойствоФЗ <> Неопределено И СвойствоФЗ.Статус = "Выполняется" Тогда
		КартинкаСостояния = БиблиотекаКартинок.СинхронизацияИдетОбмен48;
		СостояниеТранспорта    = НСтр("ru='синхронизация...'");
		
	ИначеЕсли СвойствоФЗ <> Неопределено И СвойствоФЗ.Статус = "Ошибка" Тогда
		КартинкаСостояния = БиблиотекаКартинок.СинхронизацияОшибка48;
		СостояниеТранспорта    = НСтр("ru='что-то пошло не так...'");
		
	ИначеЕсли СвойствоФЗ <> Неопределено И СвойствоФЗ.Статус = "Отменено" Тогда
		СостояниеТранспорта    = НСтр("ru='отменено'");
		
	ИначеЕсли ЕстьОписаниеПроцессов Тогда 
		
		Если ЗначениеЗаполнено(СостояниеОбмена.СтруктураПредставления.КартинкаСостояния48) Тогда
			КартинкаСостояния = БиблиотекаКартинок[СостояниеОбмена.СтруктураПредставления.КартинкаСостояния48];
		КонецЕсли;
		СостояниеТранспорта = СостояниеОбмена.СтруктураПредставления.СостояниеТранспорта;
		
	КонецЕсли;
	
	Если ЕстьОписаниеПроцессов Тогда
		СостояниеПередача = СостояниеОбмена.СтруктураПредставления.СостояниеПередача;
		СостояниеПрием    = СостояниеОбмена.СтруктураПредставления.СостояниеПрием;
	КонецЕсли;
	
	
	СтрокиСостояния = Новый Массив;
	СтрокиСостояния.Добавить(СостояниеТранспорта);
	СтрокиСостояния.Добавить(Символы.ПС);
	СтрокиСостояния.Добавить(СостояниеПередача);
	СтрокиСостояния.Добавить(Символы.ПС);
	СтрокиСостояния.Добавить(СостояниеПрием);
	
	Форма.Элементы.ИконкаСостоянияСинхронизации.Картинка     = КартинкаСостояния;
	Форма.Элементы.НадписьСостоянияОбмена.Заголовок          = Новый ФорматированнаяСтрока(СтрокиСостояния);
	
	Выполняется   = СвойствоФЗ <> Неопределено И СвойствоФЗ.Статус = "Выполняется";
	ПроцессАктивен = СостояниеОбмена <> Неопределено И СостояниеОбмена.ПроцессАктивен;
	Форма.Элементы.ОстановитьСинхронизацию.Доступность   = ПроцессАктивен;
	Форма.Элементы.ПродолжитьСинхронизацию.Доступность   = Не Выполняется И ПроцессАктивен;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСпособСледующейСинхронизации()
	
	Если ЗначениеЗаполнено(ЦентральнаяБаза) Тогда
		СценарийСинхронизации  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦентральнаяБаза, "ЗатребованныйСценарий");
	КонецЕсли;
	ОбновитьПодсказкуСценария(Элементы.СценарийСинхронизации, СценарийСинхронизации, Режим);
	
	РегЗадание = АвтоматСинхронизацииССервисом.РегламентноеЗаданиеОбмена();
	Если РегЗадание = Неопределено Тогда
		Элементы.СпособСинхронизации.Доступность = Ложь;
		Возврат;
	Иначе
		Элементы.СпособСинхронизации.Доступность = Истина;
	КонецЕсли;
	
	СпособСинхронизации = ?(РегЗадание.Использование, 0, 1);
	
КонецПроцедуры
 

&НаКлиенте
Процедура ОбновитьСостояниеПодписок()
	
	Действие    = "Обновление состояния подписок";
	ТекстОшибки = "";
	НастройкиЗапуска = ДеньгиКлиент.НовыйНастройкиЗапускаФоновогоЗадания("Получение информации о подписках");
	НастройкиЗапуска.ПоследовательностьПроцедур.Добавить("ДеньгиВОблаке.ПолучитьСвойстваЭтойБазыИзОблакаВФоне");
	НастройкиЗапуска.ПоследовательностьПроцедур.Добавить("ДеньгиВОблаке.ПолучитьТарифыИОстаткиПодписокВФоне");
	
	НастройкиЗапуска.ОбработчикОжидания        = Неопределено;
	НастройкиЗапуска.ОбработчикОшибки          = Новый ОписаниеОповещения("ОбработчикОшибкиФоновогоЗадания", ЭтотОбъект);
	НастройкиЗапуска.ОбработчикЗавершения      = Новый ОписаниеОповещения("ОбработчикЗавершенияФоновогоЗадания", ЭтотОбъект);
	
	ДеньгиКлиент.ВыполнитьЭтапФоновогоЗадания(ЭтотОбъект, НастройкиЗапуска, РезультатЗапускаФоновогоЗадания);
	НастройкиЗапуска = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОшибкиФоновогоЗадания(Результат, ДополнительныеПараметры) Экспорт

	Если Результат.ФоновоеЗадание <> Неопределено И Результат.ФоновоеЗадание.Статус = "Ошибка" Тогда
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "КраткоеПредставлениеОшибки") Тогда
			Обращение = Результат.ФоновоеЗадание.КраткоеПредставлениеОшибки;
			Ошибка = Результат.ФоновоеЗадание.ПодробноеПредставлениеОшибки;
		Иначе
			Обращение = НСтр("ru='При обновлении информации произошла какая-то ошибка'");
			Ошибка = НСтр("ru='Ошибка выполнения фонового задания. Подробности см. в журнале регистрации'");
		КонецЕсли;
		
	Иначе
		Обращение = НСтр("ru='Запрос к облаку был отменен пользователем.
				|Пожалуйста, еще раз запустите обновление и дождитесь его окончания'");
		Ошибка = "";
		
	КонецЕсли;
	
	ПоказатьОшибкуНаФорме(Обращение, Ошибка);
	ОбновитьЭлементыПоСостояниюОбновления(ЭтотОбъект, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкуНаФорме(СообщениеПользователю, Ошибка)
	
	Элементы.ПредставлениеОшибки.Заголовок = ?(ЗначениеЗаполнено(СообщениеПользователю), СообщениеПользователю, 
				НСтр("ru='Не удалось обновить информацию.
						|Пожалуйста, поробуйте выполнить эту операцию позже'"));
	
	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
	Иначе
		ТекстОшибки = ?(ЗначениеЗаполнено(Ошибка), Ошибка, "");
	КонецЕсли;
	
	Элементы.ГруппаОшибкаОбновленияДанных.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершенияФоновогоЗадания(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.ВыполненныйЭтап = "ДеньгиВОблаке.ПолучитьСвойстваЭтойБазыИзОблакаВФоне" Тогда
		
		ОбновитьСвойстваБазыПолученныеИзОблака(Результат, ДополнительныеПараметры);
		
	ИначеЕсли Результат.ВыполненныйЭтап = "ДеньгиВОблаке.ПолучитьТарифыИОстаткиПодписокВФоне" Тогда
		
		ВывестиРезультатСостоянияПодписок(Результат, ДополнительныеПараметры);
		ОбновитьЭлементыПоСостояниюОбновления(ЭтотОбъект, Ложь);
		//ПодключитьОбработчикОжидания("ОбработчикПроверкиОбмена", 10, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСвойстваБазыПолученныеИзОблака(Результат, ДополнительныеПараметры)
	
	СвйстваБазыВОблаке = ПолучитьИзВременногоХранилища(Результат.ФоновоеЗадание.АдресРезультата);
	
	ВидимостьСтроки     = Ложь;
	ТекстСостоянияБазыВОблаке = "";
	
	Если СвйстваБазыВОблаке = Неопределено Тогда
		ТекстСостоянияБазыВОблаке = НСтр("ru='не удалось получить состояние подписок. Проверьте настройки'");
			
	ИначеЕсли Не СвйстваБазыВОблаке.Существует Тогда
		ВидимостьСтроки = Истина;
		ТекстСостоянияБазыВОблаке = НСтр("ru='эта база не найдена в списке подключенных баз'");
		
	ИначеЕсли СвйстваБазыВОблаке.ИБУстаревшая Тогда
		ВидимостьСтроки = Истина;
		ТекстСостоянияБазыВОблаке = НСтр("ru='эта база помечена как устаревшая'");
		
	ИначеЕсли СвйстваБазыВОблаке.ИБЗапрещена Тогда
		
		ТекстСостоянияБазыВОблаке = НСтр("ru='в сервисе установлен запрет на эту базу. 
				|база очищена от всех записей!'");
		ОчиситьДанныеСервер();
		Результат.НастройкиЗапуска.ПоследовательностьПроцедур.Очистить();
		
	КонецЕсли;
	
	Элементы.ГруппаСостояниеБазыВОблаке.Видимость = ВидимостьСтроки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиситьДанныеСервер()
	
		Результат =  ОбщегоНазначенияДеньги.ОчиститьДанныеПодсистемыДеньги(Ложь, "");
		Если Результат Тогда
			Константы.СостояниеПомощникаНачалаРаботы.Установить(Новый ХранилищеЗначения(Неопределено));
		КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиРезультатСостоянияПодписок(Результат, ДополнительныеПараметры)
	
	ОтветСервера = ПолучитьИзВременногоХранилища(Результат.ФоновоеЗадание.АдресРезультата);
	Сегодня = НачалоДня(ТекущаяДатаКлиентСервер());
	
	// Активные подписки
	ДоступноЛицензий       = ОтветСервера.ЛицензийСейчас;
	ЛицензийПослеИзменений = ОтветСервера.ЛицензийПослеИзменения;
	ДатаИзменений          = ОтветСервера.БлижайшаяДатаИзменения;
	НеиспользованнаяСумма  = ОтветСервера.НеиспользованнаяСумма;
	СписокТарифов          = ОтветСервера.СписокТарифов;
	
	// Доступные лицензии
	Если ДоступноЛицензий = -111 Тогда
		ПредставлениеЛицензий = НСтр("ru='без ограничений'");
		Элементы.ДобавитьЛицензии.Видимость = Ложь;
	Иначе
		ПредставлениеЛицензий = Формат(ДоступноЛицензий, "ЧДЦ=0; ЧН=0; ЧГ=");
		Элементы.ДобавитьЛицензии.Видимость = Истина;
	КонецЕсли;
	
	АктивныеПодписки.Очистить();
	Для каждого Подписка Из ОтветСервера.АктуальныеПодписки Цикл
		
		Строка = АктивныеПодписки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Подписка);
		Если Не ЗначениеЗаполнено(Строка.НаименованиеТарифа) Тогда
			
			Если Подписка.ЭтоСлужебныйТариф Тогда
				Строка.НаименованиеТарифа = НСтр("ru='Ознакомительный'");
			ИначеЕсли Подписка.ЭтоБезлимитныйТариф Тогда
				Строка.НаименованиеТарифа = НСтр("ru='Тариф для всей семьи'");
			ИначеЕсли Подписка.ЭтоПремиумТарифМиниденег Тогда
				Строка.НаименованиеТарифа = НСтр("ru='Премиум-тариф для покупателей Миниденег'");
			Иначе
				Строка.НаименованиеТарифа = НСтр("ru='Тариф для каждого компьютера'");
			КонецЕсли;
			 
		КонецЕсли;
		
		Строка.КоличествоЛицензий = ?(Подписка.БезлимитныхЛицензий <> 0, -111, Подписка.ШтучныхЛицензий);
		Строка.ОсталосьДней = Макс(0, Цел((Строка.ОкончаниеДействия -Сегодня) / 86400));
		Если Строка.НачалоДействия > Сегодня Тогда
			Строка.ПредставлениеСрока = СтрШаблон(НСтр("ru='с %1 по %2'"), 
						Формат(Строка.НачалоДействия, "ДФ='дд МММ'"), Формат(Строка.ОкончаниеДействия, "ДФ='дд МММ гггг'"));
		Иначе
			Строка.ПредставлениеСрока = СтрШаблон(НСтр("ru='до %1 (%2 дн.)'"), Формат(Строка.ОкончаниеДействия, "ДФ='дд МММ гггг'") , Строка.ОсталосьДней);
		КонецЕсли;
		
		Если Строка.НачалоДействия < Сегодня И Не Подписка.ЭтоСлужебныйТариф Тогда
			Строка.Продлить = НСтр("ru='Продлить'"); 
		КонецЕсли;
		
	КонецЦикла;
	Элементы.ДекорацияНетПодписок.Видимость = АктивныеПодписки.Количество() = 0;
	Элементы.АктивныеПодписки.Видимость     = Не Элементы.ДекорацияНетПодписок.Видимость;
	
	// Список баз
	ПодключеноБаз = ОтветСервера.ПодключеноБаз;
	ПредставлениеПодключенныхБаз = Формат(ПодключеноБаз, "ЧДЦ=0; ЧН=0; ЧГ=");
	
	ПодключенныеБазы.Очистить();
	Для каждого База Из ОтветСервера.ПодключенныеБазы Цикл
		
		Строка = ПодключенныеБазы.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, База);
		
		Если Строка.МобильноеУстройство Тогда
			Строка.ПредставлениеПрограммы = Строка.Наименование + " (Миниденьги)"; 
		Иначе
			Строка.ПредставлениеПрограммы = Строка.Наименование + " (1С:Деньги 8)"; 
		КонецЕсли;
		
		Если Строка.ИБЗапрещена Тогда
			Строка.Состояние = НСтр("ru='Запрещена'"); 
		ИначеЕсли Строка.ИБУстаревшая Тогда
			Строка.Состояние = НСтр("ru='Отключена'"); 
		Иначе
			Строка.Состояние = НСтр("ru='Подключена'"); 
		КонецЕсли;
		
	КонецЦикла;
	ПодключенныеБазы.Сортировать("ИБЗапрещена Убыв,ИБУстаревшая Убыв,Наименование");
	
	// Текст рекомендации и кнопки покупки
	ТекстРекомендации = НСтр("ru='Услуги сервиса доступны в полном объеме'");
	ЦветНадпсии       = WebЦвета.ТемноСерый;
	ЕстьЛицензии = ДоступноЛицензий = -111 Или ДоступноЛицензий >= ПодключеноБаз;
	Если ДоступноЛицензий <> -111 И ДоступноЛицензий < ПодключеноБаз Тогда
		// Лицензий недостаточно для продолжения работы
		НужноЛицензий = ПодключеноБаз - ДоступноЛицензий;
		ЦветНадпсии        = WebЦвета.Красный;
		ТекстРекомендации = СтрШаблон(НСтр("ru='Для доступа к сервису нужно купить не менее %1'"), ДеньгиВОблакеКлиентСервер.КоличествоЛицензийСтрокой(НужноЛицензий, "Т"));
		РежимПокупки = Новый Структура("Количество,Начало", ПодключеноБаз - ДоступноЛицензий, Сегодня);
		
	ИначеЕсли ЗначениеЗаполнено(ДатаИзменений) И ЛицензийПослеИзменений <> -111 И ЛицензийПослеИзменений < ПодключеноБаз Тогда 
		// Изменения скоро наступят и в результате лицензий станет недостаточно для продолжения работы
		ДатаПродления = Формат(ДатаИзменений, "Л=ru_RU; ДФ=dd.MM.yyyy"); 
		ТекстРекомендации = СтрШаблон(НСтр("ru='Подписка действует до %1'"), ДатаПродления);
		РежимПокупки = Новый Структура("Количество,Начало", ?(ЛицензийПослеИзменений = -111, -111, ПодключеноБаз - ЛицензийПослеИзменений), 
							ДатаИзменений);
		Если ДатаИзменений < НачалоДня(ТекущаяДата() + 604800) Тогда
			ЦветНадпсии        = WebЦвета.Красный;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ТекстРекомендации.Заголовок   = ТекстРекомендации;
	Элементы.ТекстРекомендации.ЦветТекста  = ЦветНадпсии;
	
КонецПроцедуры
 
