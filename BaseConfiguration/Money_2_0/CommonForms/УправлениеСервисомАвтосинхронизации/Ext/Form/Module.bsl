&НаКлиенте
Процедура ОтправитьСообщениеВПоддержку()

	Состояние(НСтр("ru='Подготовка технологической информации...'"));
	
	ПараметрыФормы = ПараметрыСообщения();
	ПараметрыФормы.Тема = "Ошибка получения информации о подписках";
	
	ПараметрыФормы.Тело = "Форма ""Текущее состояние подписок"".
		|Выполняемое действие: " + Действие + " 
		|Ошибка: " + ТекстОшибки + ", 
		|	
		|	* дата: " + ТекущаяДатаКлиентСервер();
	
	ОткрытьФорму("ОбщаяФорма.ОтправкаСообщенияВСлужбуПоддержки", ПараметрыФормы, ЭтотОбъект, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОплатуПодписки(КоличествоЛицензий, ДатаНачала, Вариант = Неопределено)
	
	Если Не ЗначениеЗаполнено(СписокТарифов) Тогда
		ПоказатьПредупреждение(, НСтр("ru='С сервера не получена информация о тарифах.
			|Попробуйте обновить информацию (F5) и повторите попытку'") );
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КоличествоЛицензий",    КоличествоЛицензий);
	ПараметрыФормы.Вставить("ДатаНачала",            ДатаНачала);
	ПараметрыФормы.Вставить("Вариант",               Вариант);
	ПараметрыФормы.Вставить("НеиспользованнаяСумма", НеиспользованнаяСумма);
	ПараметрыФормы.Вставить("СписокТарифов",         СписокТарифов);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьОплатуПодпискиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.ОплатаПодписки", ПараметрыФормы, ЭтотОбъект, Ложь, , , Оповещение);
	
КонецПроцедуры

