Процедура ИдентификаторыОбмена(Команда)
	Текст = ТекстОтладочнойИнформации();
	Текст.Показать(НСтр("ru='Отладочная информация для тех.поддержки'"));
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформацию(Команда)
	
	ЭтапОбновления = "Начало";
	ДеньгиКлиент.ЗаписатьПараметрПриложения("Деньги.Обмен.ФоновоеЗадание", Неопределено);
	ДеньгиКлиент.ЗаписатьПараметрПриложения("Деньги.Обмен.СостояниеОбмена", Неопределено);
	ОбновитьИнформациюНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетнойЗаписи(Команда)
	
