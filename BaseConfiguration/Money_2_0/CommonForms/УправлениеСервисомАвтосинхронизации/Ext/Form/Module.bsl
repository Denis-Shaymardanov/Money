
&НаКлиенте 
Перем НастройкиЗапуска, Действие, ПустойСценарийОбработан;


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаОшибкаОбновленияДанных.Видимость = Ложь;
	Элементы.ГруппаСостояниеБазыВОблаке.Видимость = Ложь;
	
	ПроверитьРежимИПараметрыПодключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ФормаЗамены         = "";
	ОповещениеОЗакрытии = Неопределено;
	ПроверитьДоступностьЭтойФормы(Отказ, ФормаЗамены, ОповещениеОЗакрытии);
	
	Если Не Отказ Тогда
		ЭтапОбновления = "Начало";
		ОбновитьСпособСледующейСинхронизации();
		ОбновитьИнформациюНаКлиенте();
		Если Не ЗначениеЗаполнено(СценарийСинхронизации) Тогда
			ПоказатьПредупреждение(, НСтр("ru='Пожалуйста, укажите сценарий синхронизации!'"));
			ТекущийЭлемент = Элементы.СценарийСинхронизации;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьСтатусФоновогоЗаданияСинхронизацииКлиент();
	
	Если ЗначениеЗаполнено(ФормаЗамены) Тогда
		ОткрытьФорму(ФормаЗамены, , , , , , ОповещениеОЗакрытии);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СинхронизацияВыключена" Тогда
		
		Если Открыта() Тогда
			ПустойСценарийОбработан = Истина;
			Закрыть();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ВыполненОбменДанными" Тогда
		
		ЭтапОбновления = "РезультатыСинхронизации";
		ДеньгиКлиент.ЗаписатьПараметрПриложения("Деньги.Обмен.ФоновоеЗадание", Неопределено);
		ДеньгиКлиент.ЗаписатьПараметрПриложения("Деньги.Обмен.СостояниеОбмена", Неопределено);
		ОбновитьИнформациюНаКлиенте();
		
	ИначеЕсли ИмяСобытия = "ПодключениеКОблакуИзменено" Тогда 
		
		ПроверитьРежимИПараметрыПодключения();
		
		Если Параметр = Истина Тогда
			
			ЭтапОбновления = "Начало";
			ОбновитьИнформациюНаКлиенте();
			
		Иначе
			
			// разорвано соединение с облаком
			ПредставлениеУчетнойЗаписи = ?(ПараметрыПодключения = Неопределено, НСтр("ru='нет данных'"), ПараметрыПодключения.Логин); 
			ПредставлениеЛицензий = НСтр("ru='нет данных'");
			ПредставлениеПодключенныхБаз = НСтр("ru='нет данных'");
			РезультатПоследнейСинхронизации = НСтр("ru='нет данных'");
			ПредставлениеОшибкиСинхронизации = "";
			Элементы.ОстановитьСинхронизацию.Доступность = Ложь;
			Элементы.ПродолжитьСинхронизацию.Доступность = Ложь;
			
		КонецЕсли;
		
	// ПроцессыОбмена
	ИначеЕсли ИмяСобытия = ПроцессыОбменаКлиент.КлючОповещенияОбИзмененииСостоянияОбмена() Тогда
	// Конец ПроцессыОбмена
		ОбновитьСтатусФоновогоЗаданияСинхронизацииКлиент();
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СценарийСинхронизации) И ПустойСценарийОбработан <> Истина Тогда
		
		Отказ = Истина;
		#Область ПоказатьВопрос
		ТекстВопроса = НСтр("ru='Синхронизация не будет выполняться, пока не указан сценарий.
			|Закрыть эту форму без указания сценария?'");
		
		ДополнительныеПараметры = Новый Структура;
		Оповещение = Новый ОписаниеОповещения("ПодтверждениеЗакрытияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Закрыть'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет,    НСтр("ru='Не закрывать'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, );
		#КонецОбласти
		 
	КонецЕсли;
	 
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособСинхронизацииПриИзменении(Элемент)
	ЗаписатьРежимСинхронизации();
КонецПроцедуры

&НаКлиенте
Процедура СценарийСинхронизацииПриИзменении(Элемент)
	ЗаписатьСценарийСинхронизации();
	ОбновитьПодсказкуСценария(Элементы.СценарийСинхронизации, СценарийСинхронизации, Режим);
КонецПроцедуры


&НаКлиенте
Процедура ИконкаСостоянияСинхронизацииНажатие(Элемент)
	ПоказатьОписаниеСостоянияОбмена("");	
КонецПроцедуры


&НаКлиенте
Процедура НадписьСостоянияОбменаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "http://transport" Тогда
		// описание для транспорта обмена
		ПоказатьОписаниеСостоянияОбмена("Транспорт");	
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "http://receiving" Тогда
		// описание для процесса Прием
		ПоказатьОписаниеСостоянияОбмена("Прием");	
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "http://sending" Тогда
		// описание для процесса Передача
		ПоказатьОписаниеСостоянияОбмена("Передача");	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПодключенныеБазы

&НаКлиенте
Процедура ПодключенныеБазыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ПодключенныеБазыСостояние" Тогда
		СтандартнаяОбработка = Ложь;
		
		ПоказатьДиалогИзмененияСостояния(ВыбраннаяСтрока)
		
	КонецЕсли;
	
КонецПроцедуры



#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормы_АктивныеПодписки


&НаКлиенте
Процедура АктивныеПодпискиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "АктивныеПодпискиПродлить" Тогда
		СтандартнаяОбработка = Ложь;
		СтрокаПодписки = АктивныеПодписки.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если Не СтрокаПодписки.ЭтоСлужебныйТариф Тогда
			ОткрытьОплатуПодписки(СтрокаПодписки.КоличествоЛицензий, КонецДня(СтрокаПодписки.ОкончаниеДействия) + 1);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры



#КонецОбласти


#Область ОбработчикиКомандФормы

