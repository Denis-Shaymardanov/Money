&НаКлиенте
Процедура ДиалогФайлаОбмена(ЭтоЗагрузка)
	
	ТекстПредупреждения = НСтр("ru='В данный момент выполняется синхронизация.
		|Для выполнения команды остановите синхронизацию или дождитесь ее завершения'");
	Если ПредупредитьЕслиВыполняетсяСинхронизация(ТекстПредупреждения) Тогда
		Возврат;
	КонецЕсли;
	
	ВыборФайла = Новый ДиалогВыбораФайла(?(ЭтоЗагрузка, РежимДиалогаВыбораФайла.Открытие, РежимДиалогаВыбораФайла.Сохранение));
	ВыборФайла.МножественныйВыбор = Ложь;
	ВыборФайла.ПолноеИмяФайла = ИмяФайлаВыгрузки;
	ВыборФайла.Расширение = "xml";
	ВыборФайла.Фильтр = "Файл выгрузки (*.xml)|*.xml|Все файлы (*.*)|*.*";
	ВыборФайла.ПроверятьСуществованиеФайла = ЭтоЗагрузка;
	ВыборФайла.МножественныйВыбор = Ложь;
	ВыборФайла.Заголовок = ?(ЭтоЗагрузка, НСтр("ru='Укажите файл для выгрузки'"), НСтр("ru='Укажите файл для загрузки'"));
	
	Оповещение = Новый ОписаниеОповещения("ДиалогФайлаВыгрузки_Завершение", ЭтотОбъект, ЭтоЗагрузка);
	ВыборФайла.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ДиалогФайлаВыгрузки_Завершение(ВыбранныеФайлы, ЭтоЗагрузка) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("УзелИнформационнойБазы,ВидТранспорта,ВыполнятьВыгрузку,ВыполнятьЗагрузку,ИмяФайлаВыгрузки");
	ПараметрыФормы.УзелИнформационнойБазы = ЦентральнаяБаза;
	ПараметрыФормы.ВидТранспорта       = ПредопределенноеЗначение("Перечисление.ВидыТранспортаСообщенийОбмена.FILE");
	ПараметрыФормы.ВыполнятьВыгрузку   = Не ЭтоЗагрузка;
	ПараметрыФормы.ВыполнятьЗагрузку   = ЭтоЗагрузка;
	ПараметрыФормы.ИмяФайлаВыгрузки    = ВыбранныеФайлы[0];
	
	ОткрытьФорму("Обработка.МониторСинхронизацииССервисом.Форма.ИнтерактивнаяОперация", ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьСинхронизациюЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	
	ВыключитьСинхронизациюСервер();
	ОбновитьИнтерфейс();
	Оповестить("ИзмененаСинхронизация");
	
	Если Открыта() Тогда
		ПустойСценарийОбработан = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыключитьСинхронизациюСервер()
	
	Если Не ОбщегоНазначения.РазделениеВключено() Тогда 
		Константы.ИспользоватьСинхронизациюДанных.Установить(Ложь);
	КонецЕсли;
	
	ОстановитьСинхронизациюСервер();
	
	// Выбор способа устанавливает функциональные опции
	Константы.ДеньгиВыбранныйСпособСинхронизации.Установить(Перечисления.СпособыСинхронизацииДанных.НеИспользовать);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьРежимИПараметрыПодключения()
	
	Элементы.ГруппаУчетнаяЗаписьКолонкаПравая.Подсказка = "";
	Элементы.ДекорацияИндикатор.Подсказка = "";
	
	ЦентральнаяБаза = СинхронизацияАвтономныхКопийВызовСервера.УзелЦентральнойБазы("СинхронизацияАвтономныхКопий");
	КодЭтогоУзла    = СинхронизацияАвтономныхКопийВызовСервера.КодЭтогоУзла("СинхронизацияАвтономныхКопий");
	Режим = ДеньгиВызовСервераПовтИсп.РежимИспользованияПриложения();
	ПараметрыПодключения = Неопределено;
	Если Режим = "Разделенный" Тогда
		ПараметрыПодключенияЗаполнены = Истина;
		ЭталонныйНабор = Новый Структура("Логин,Пароль,НомерОбласти,КодАбонента,ПолныйПутьКБазе");
		ИмяНастройки = ДеньгиВОблакеКлиентСервер.ИмяНастройкиПараметрыСоединенияНаСервере();
		ПараметрыПодключения = РегистрыСведений.ЗначенияНастроекИнтеграции.ЗначениеНастройки(ИмяНастройки, ЭталонныйНабор);
		БазаПодключенаКОблаку = Истина;
	Иначе
		ПараметрыПодключенияЗаполнены = ДеньгиВОблаке.ПроверитьПараметрыПодключенияКОблаку(ПараметрыПодключения, , Ложь);
		БазаПодключенаКОблаку = ДеньгиВОблакеВызовСервера.ЭтаБазаПодключенаКОблаку(ПараметрыПодключения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТекстОтладочнойИнформации()
	
	Если Режим = "Разделенный" Тогда
		ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		Разделитель = ОбщийМодуль.ЗначениеРазделителяСеанса();
	Иначе
		Разделитель = ?(ЗначениеЗаполнено(ПараметрыПодключения) И ЗначениеЗаполнено(ПараметрыПодключения.НомерОбласти), 
				ПараметрыПодключения.НомерОбласти, "<нет данных>");
	КонецЕсли;
	Результат = "";
	Результат = Результат + "Режим: " + ?(ЗначениеЗаполнено(Режим), Режим, "<нет данных>") 
			+ "(" + Формат(Разделитель, "ЧДЦ=0; ЧГ=") + ", " + ПараметрыПодключения.АдресСервера + ")" + Символы.ПС;
	Результат = Результат + "Код сервера: " + ?(ЗначениеЗаполнено(ЦентральнаяБаза), ЦентральнаяБаза.Код, "<нет данных>") + Символы.ПС;
	Результат = Результат + "Код этой базы: " + ?(ЗначениеЗаполнено(КодЭтогоУзла), КодЭтогоУзла, "<нет данных>") + Символы.ПС;
	
	Док = Новый ТекстовыйДокумент;
	Док.УстановитьТекст(Результат);
	Возврат Док;
	
КонецФункции 

&НаКлиенте
Процедура НастройкиУчетнойЗаписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ПроверитьРежимИПараметрыПодключения();
	ОбновитьСпособСледующейСинхронизации();
	
	Если Режим = "КлиентОблака" Тогда
		ЭтапОбновления = "Начало";
		ОбновитьИнформациюНаКлиенте();
	ИначеЕсли Открыта() Тогда 
		ПустойСценарийОбработан = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМенюИсправлений()
	
	Если Не СвйстваБазыВОблаке.Существует Тогда
		ОткрытьФормуПодключенияКОблаку();
	ИначеЕсли СвйстваБазыВОблаке.ИБУстаревшая Тогда
		
		Если ДоступноЛицензий = -111 Или ДоступноЛицензий > 0 Тогда
			
			#Область ПоказатьВопрос
			ТекстВопроса = НСтр("ru='Снять отметку ""Устаревшая"" с этой базы?
			|
			|Будет занята одна из свободных лицезий'");
			
			ДополнительныеПараметры = Новый Структура;
			Оповещение = Новый ОписаниеОповещения("СнятьОтметкуУстаревшаяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Да'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет,    НСтр("ru='Нет'"));
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, Заголовок);
			#КонецОбласти
			 
		Иначе
			
			#Область ПоказатьВопрос
			ТекстВопроса = НСтр("ru='Снять отметку ""Устаревшая"" можно только при наличии свободных лицензий
			|
			|Хотите купить подписку на нужное количество лицензий?'");
			
			ДополнительныеПараметры = Новый Структура;
			Оповещение = Новый ОписаниеОповещения("КупитьЛицензииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru='Да'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет,    НСтр("ru='Нет'"));
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, Заголовок);
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодключенияКОблаку()
	
	ТекстПредупреждения = НСтр("ru='В данный момент выполняется синхронизация.
		|Для изменения параметров подключения остановите синхронизацию или дождитесь ее завершения'");
	Если ПредупредитьЕслиВыполняетсяСинхронизация(ТекстПредупреждения) Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("НастройкиУчетнойЗаписиЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ПодключениеКСервисуАвтоСинхронизации", , , Истина, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуУстаревшаяЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьПризнакУстарелаСервер(Ложь);
	ЭтапОбновления = "Начало";
	ОбновитьИнформациюНаКлиенте();
	
